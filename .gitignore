node_modules/
# Every .env variant, not just .env and .env.*.local -- a backup or a
# .env.staging holds the same secrets the real one does, and an untracked
# file one `git add -A` away from being published is not a safe place for
# them. .env.example is the deliberate exception: it ships with empty values.
.env
.env.*
!.env.example
dist/
# Frontend build output, written directly into backend/ (see
# frontend/vite.config.js) so the existing backend deploy zip already
# contains it — see backend/src/server.js's static-file serving.
backend/public/
*.log

# Playwright's own run artifacts (frontend/e2e/, the committed test
# source, is not affected by this)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
