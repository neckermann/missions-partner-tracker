// Prisma schema for the Missions Team Missionary Tracker
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

// The connection URL used to live here (url = env("DATABASE_URL")) --
// Prisma 7 removed that; it's now in prisma.config.js instead (which
// also stays the single source of truth for prisma migrate/studio/etc.
// commands, not this file).
datasource db {
  provider = "postgresql"
}

model Missionary {
  id                 String   @id @default(uuid())

  // --- Visibility controls ---
  isPublic           Boolean  @default(false) // show on public site at all
  isRestricted       Boolean  @default(false) // if public + restricted -> masked/generic view only

  // --- Status ---
  // Archiving is the "soft delete" — hides the record from admin lists by
  // default, forces isPublic off, and zeros out monthly support (via a new
  // SupportEntry, not by editing old ones) — while keeping every bit of
  // history intact. DELETE is only permitted once a record is archived, so
  // archiving is the deliberate first step toward ever actually removing
  // someone. This replaced a separate `retired` flag, which turned out to
  // be redundant with it.
  archived                Boolean   @default(false)
  archivedAt              DateTime?
  contactSafe            Boolean  @default(true)  // ok to be contacted directly
  preferredContactMethod String?  // e.g. "Email", "Phone Call", "Text/SMS", "WhatsApp", "Mail"
  // True when this church (see ChurchSettings) is this missionary's sending
  // church — distinct from the SendingChurch relation below, which records
  // details about whichever church actually sends them (may or may not be
  // this one). Displayed as "Sent by {ChurchSettings.churchName}" in the UI.
  sentByOurChurch        Boolean  @default(false)

  // --- Core identity / field info ---
  displayName        String
  fieldDisplayName   String?  // e.g. "Northern Uganda" - safe to show even if restricted
  fipsCountryCode    String?

  // overview is the long-form narrative; overviewShort is a one/two-line
  // summary for quick-read contexts (directory cards, list views) — aligned
  // with the same pair of fields on Organization. focusArea replaces the
  // old ministryFocus name for the same alignment reason.
  overview           String?  @db.Text
  overviewShort      String?
  focusArea          String?  @db.Text
  supportingSince    DateTime? @db.Date // year-only values are stored as Jan 1 of that year

  anniversary        DateTime? @db.Date
  languagesSpoken    String[] @default([])

  // --- Mission trip capacity: what kind of team this missionary can host ---
  tripTeamSizeMin    Int?
  tripTeamSizeMax    Int?
  tripTypesSupported String[] @default([]) // e.g. ["Construction", "Medical/Dental"]
  tripSeasonNotes    String?  @db.Text      // best time of year, typical duration, etc.
  tripLogisticsNotes String?  @db.Text      // lodging, requirements, other logistics

  // --- Links — every field a real, individually validated column (no JSON
  // blob); matches Organization exactly, field for field. ---
  websiteLink        String?
  supportLink        String?
  newsletterSignup   String?
  facebook           String?
  twitter            String?
  instagram          String?
  linkedin           String?

  emergencyContact   Json?    // { name, phone, email }

  // Was two separate 1:1 relations (SendingChurch?/SendingOrg?) -- merged
  // into one dual-purpose table (see SendingParty below), same discriminator
  // pattern Address already uses for physical/mailing. Route handlers pick
  // out the one they want via `.find(sp => sp.type === "church")`, same as
  // they already do for addresses.
  sendingParties     SendingParty[]
  adults             Adult[]
  children           Child[]
  addresses          Address[]
  missionTrips       Trip[]
  furloughs          Furlough[]
  churchVisits       ChurchVisit[]
  supportEntries     SupportEntry[]
  // Named needRequests, not supportNeeds, to avoid colliding with the
  // existing free-text `supportNeeds` field above (ministry-need narrative,
  // unrelated to these discrete dollar-amount requests).
  needRequests       SupportNeed[]
  prayerRequests     PrayerRequest[]
  newsletters        Newsletter[]
  documents          Document[]
  // Full upload history, not just the current one — see the Photo model.
  // The "current" photo (what the admin form and public site show) is
  // whichever has the latest receivedDate, not just the latest upload.
  photos             Photo[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String?
  updatedById        String?

  @@index([isPublic, isRestricted])
  @@index([archived])
}

model Adult {
  id           String     @id @default(uuid())
  missionaryId String
  missionary   Missionary @relation(fields: [missionaryId], references: [id], onDelete: Cascade)
  name         String
  phone1       String?
  phone2       String?
  email        String?
  birthday     DateTime?  @db.Date
}

model Child {
  id           String     @id @default(uuid())
  missionaryId String
  missionary   Missionary @relation(fields: [missionaryId], references: [id], onDelete: Cascade)
  name         String
  birthday     DateTime?  @db.Date
}

// A missionary or organization can have up to one address per type.
// "physical" is their actual serving location (may be a full street
// address or just city/state/country, depending on what's known/safe to
// record) and is also the source of the public map pin (gpsLat/gpsLng).
// "mailing" is the existing US-side contact/support-mail address and has
// no coordinates. Formerly two separate tables (Address for missionaries,
// OrganizationAddress for organizations) -- merged into this one,
// following the same nullable dual-FK pattern already used by Newsletter/
// Document/SupportEntry/ChurchVisit. Two separate @@unique constraints
// (rather than one) since a Postgres unique index never conflicts across
// rows where the constrained column is NULL on both sides -- one
// constraint per parent type is what actually enforces "at most one
// physical + one mailing address" independently for each.
model Address {
  id                  String        @id @default(uuid())
  missionaryId        String?
  missionary          Missionary?   @relation(fields: [missionaryId], references: [id], onDelete: Cascade)
  organizationId      String?
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type                String        // "physical" | "mailing"
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?
  gpsLat              Float?
  gpsLng              Float?
  receiveMail         Boolean?
  receivePackages     Boolean?

  @@unique([missionaryId, type])
  @@unique([organizationId, type])
}

// A past team trip to visit this missionary or organization — history for
// reference, not a capacity/preference profile (that lives on
// Missionary/Organization.tripTypesSupported etc). Formerly two separate
// tables (MissionTrip for missionaries, OrganizationTrip for
// organizations, renamed to Trip here) -- merged following the same
// pattern as Address above.
model Trip {
  id             String            @id @default(uuid())
  missionaryId   String?
  missionary     Missionary?       @relation(fields: [missionaryId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startDate      DateTime?         @db.Date
  endDate        DateTime?         @db.Date
  tripType       String?           // e.g. "Construction", "Medical/Dental" — preset or custom
  description    String?           @db.Text // what the team did
  notes          String?           @db.Text
  participants   TripParticipant[]
}

// Individual person on a Trip. isLeader marks the trip leader(s) rather
// than keeping a separate, potentially-inconsistent "leader name" field.
model TripParticipant {
  id       String   @id @default(uuid())
  tripId   String
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name     String
  role     String?  // e.g. "Medical", "Construction", "Translator"
  isLeader Boolean  @default(false)
  phone    String?
  email    String?
}

// A period of time a missionary is off the field and in their home
// country — missionary-only, unlike ChurchVisit below, since organizations
// don't go on furlough. endDate is nullable for an open-ended/ongoing
// furlough whose return date isn't settled yet.
model Furlough {
  id           String     @id @default(uuid())
  missionaryId String
  missionary   Missionary @relation(fields: [missionaryId], references: [id], onDelete: Cascade)
  startDate    DateTime   @db.Date
  endDate      DateTime?  @db.Date
  notes        String?    @db.Text

  @@index([missionaryId])
}

// A single visit a missionary or organization made to (this) church —
// the reverse direction of MissionTrip/OrganizationTrip, which record us
// visiting them. Shared table for either parent, same approach as
// SupportEntry/SupportNeed/Newsletter (see the comment on SupportEntry).
// "Last visit" is just the entry with the latest visitDate, mirroring how
// "current support" is read off SupportEntry.
model ChurchVisit {
  id             String        @id @default(uuid())
  missionaryId   String?
  missionary     Missionary?   @relation(fields: [missionaryId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitDate      DateTime      @db.Date
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())

  @@index([missionaryId])
  @@index([organizationId])
}

// Who sent this missionary -- their sending church and/or sending
// organization, each recorded once per missionary (`type` distinguishes
// which; @@unique enforces "at most one of each per missionary", same
// role the old @unique on missionaryId alone played back when these were
// two separate one-row-per-missionary tables). Missionary-only -- an
// organization has no equivalent "who sent it" concept, so unlike
// Address/Trip above this isn't a missionary/organization split, it's two
// formerly-separate-but-identical models (SendingChurch, SendingOrg) on
// the same parent, merged the same way Address already distinguishes
// "physical"/"mailing". The address itself is now real structured columns
// (addressLine1 etc., matching Address's shape) rather than the old
// `mailingAddress Json?` blob -- that JSON field was never validated,
// never queryable, and out of step with how every other address in this
// schema is stored.
model SendingParty {
  id                  String     @id @default(uuid())
  missionaryId        String
  missionary          Missionary @relation(fields: [missionaryId], references: [id], onDelete: Cascade)
  type                String     // "church" | "org"
  name                String?
  contactName         String?
  contactEmail        String?
  websiteLink         String?
  phone               String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?

  @@unique([missionaryId, type])
}

// A local or national partner organization, tracked as its own standalone
// entity (distinct from the per-missionary SendingChurch/SendingOrg
// sub-records above, which are about who sent a specific missionary).
// Mirrors the shape of Missionary where it makes sense — profile info,
// contact details, mission-trip hosting capacity/history — minus the
// person-specific fields (adults/children/emergency contact/languages).
model Organization {
  id                 String   @id @default(uuid())

  isPublic           Boolean  @default(false)
  isRestricted       Boolean  @default(false)
  // See Missionary.archived for the full rationale — same soft-delete
  // behavior, mirrored here field-for-field. This replaced a separate
  // `active` flag, which turned out to be redundant with it (same reasoning
  // as Missionary.archived replacing `retired`).
  archived           Boolean   @default(false)
  archivedAt         DateTime?

  name               String
  orgType            String   // "Local" | "National"
  fieldDisplayName   String?  // region/focus area — safe to show even if restricted
  fipsCountryCode    String?

  overview           String?  @db.Text
  overviewShort      String?  // one/two-line summary for quick-read contexts — see Missionary.overviewShort
  focusArea          String?  @db.Text
  supportingSince    DateTime? @db.Date

  contactName             String?
  contactPhone            String?
  contactEmail            String?
  preferredContactMethod  String?

  tripTeamSizeMin    Int?
  tripTeamSizeMax    Int?
  tripTypesSupported String[] @default([])
  tripSeasonNotes    String?  @db.Text
  tripLogisticsNotes String?  @db.Text

  // --- Links — every field a real, individually validated column (no JSON
  // blob); matches Missionary exactly, field for field. ---
  websiteLink        String?
  supportLink        String?
  newsletterSignup   String?
  facebook           String?
  twitter            String?
  instagram          String?
  linkedin           String?

  addresses          Address[]
  orgTrips           Trip[]
  churchVisits       ChurchVisit[]
  supportEntries     SupportEntry[]
  needRequests       SupportNeed[] // see Missionary.needRequests for the naming note
  prayerRequests     PrayerRequest[]
  newsletters        Newsletter[]
  documents          Document[]
  // See Missionary.photos for the "current" resolution rule.
  photos             Photo[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String?
  updatedById        String?

  @@index([isPublic, isRestricted])
  @@index([archived])
}


// A monthly-support dollar amount effective as of a given date, for either a
// Missionary or an Organization — exactly one of missionaryId/organizationId
// is set (enforced via a CHECK constraint in the migration, since Prisma has
// no native polymorphic relation). Unlike Address/MissionTrip (duplicated
// per entity type, an existing convention here), this is a new sub-entity
// added after that duplication was flagged as worth avoiding going forward,
// so it's a single shared table instead of a SupportEntry/OrgSupportEntry
// pair. "Current" support is just the most recent row by effectiveDate —
// the point of this table is the history, not a single overwritten amount.
// Admin-only data: never surfaced through toPublicMissionary/toPublicOrganization.
model SupportEntry {
  id             String        @id @default(uuid())
  missionaryId   String?
  missionary     Missionary?   @relation(fields: [missionaryId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amount         Int           // whole dollars per month
  effectiveDate  DateTime      @db.Date
  notes          String?
  createdAt      DateTime      @default(now())

  @@index([missionaryId])
  @@index([organizationId])
}

// A one-time financial need requested by a Missionary or Organization (e.g.
// "$1,000 to help a family in their congregation") and our response to it —
// distinct from SupportEntry, which tracks the recurring monthly amount.
// approvedAmount/approvedDate stay null until a decision is made, and
// approvedAmount may be less than requestedAmount (a partial gift) — there's
// no separate status enum; pending/declined/partial/fully-funded are all
// just read off of whether approvedAmount is set and how it compares to
// requestedAmount. Same shared-table approach as SupportEntry.
model SupportNeed {
  id              String        @id @default(uuid())
  missionaryId    String?
  missionary      Missionary?   @relation(fields: [missionaryId], references: [id], onDelete: Cascade)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  description     String        @db.Text
  requestedAmount Int
  requestDate     DateTime      @db.Date

  approvedAmount  Int?
  approvedDate    DateTime?     @db.Date

  notes           String?       @db.Text
  createdAt       DateTime      @default(now())

  @@index([missionaryId])
  @@index([organizationId])
}

// A prayer request received from a Missionary or Organization — meant as
// a long-term, ongoing record of what's been prayed for and (when it
// happens) how it was answered, not a pass/fail checklist. `status`
// deliberately has no "unanswered" value: "ongoing" (the default) means
// still-open/still-praying, with no implication anything failed to
// happen — most requests, especially long-running ones, simply don't
// have a resolution yet, and that's normal, not a gap to flag.
// "untracked" is an explicit opt-out for requests nobody intends to
// revisit for a formal answer (a routine short-term ask like "safe
// travels this week" isn't usually worth following up on specifically).
// "answered" is the one worth surfacing -- paired with dateAnswered and
// answeredNote, this is what lets a church look back over time and see
// how prayers were actually answered, which is the whole point of
// keeping this long-term rather than letting requests fall off after
// they're no longer current.
//
// `category` ("short_term" | "long_term") controls where a request can
// ever be shown publicly: only "long_term" requests are eligible, and
// only when `isPublic` is also explicitly set — same explicit opt-in
// pattern as Missionary/Organization.isPublic elsewhere in this schema,
// so a long-term request isn't shown publicly just because of its
// category alone.
model PrayerRequest {
  id             String        @id @default(uuid())
  missionaryId   String?
  missionary     Missionary?   @relation(fields: [missionaryId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // "strategic" (tied to the ministry's long-term vision/calling -- church
  // planting, discipleship, language study, funding) vs "situational"
  // (whatever came up -- health, travel, family, paperwork). Replaces an
  // earlier short_term/long_term split that was about time horizon rather
  // than what the request actually was, which didn't map cleanly onto
  // "should this go on the public site/in the booklet" the way this does.
  category         String    // "strategic" | "situational"
  requestText      String    @db.Text
  dateReceived     DateTime  @db.Date
  isPublic         Boolean   @default(false) // only takes effect when category is "strategic"
  // Booklet space is tight (see AdminBooklet.jsx's per-page cap), so
  // isPublic alone doesn't mean a request prints -- only takes effect when
  // isPublic is also true (a request can be public-site-only).
  includeInBooklet Boolean   @default(false)

  status       String    @default("ongoing") // "ongoing" | "answered" | "untracked"
  dateAnswered DateTime? @db.Date
  answeredNote String?   @db.Text

  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  createdById  String?

  @@index([missionaryId])
  @@index([organizationId])
  @@index([category])
  @@index([status])
}

// A newsletter file (PDF, .eml export, or a screenshot image) received from
// a Missionary or an Organization — exactly one of missionaryId/
// organizationId is set, same shared-table approach as SupportEntry/
// SupportNeed. The file itself lives right in this row (see `bytes`
// below) rather than in a separate object store — no external storage
// service to configure at all, and Postgres's TOAST mechanism already
// keeps large column values out-of-line and compressed, so this doesn't
// bloat ordinary queries. Deliberately not exposed by any query that
// doesn't need the actual file content (see the `omit: { bytes: true }`
// on every list/detail include across the route files) — reachable only
// through GET /api/newsletters/:id/download, admin-only for now. Fine at
// the scale this app runs at (one church's worth of files, not a
// multi-tenant media library) — see CONTRIBUTING.md if that ever stops
// being true for a particular fork.
model Newsletter {
  id             String        @id @default(uuid())
  missionaryId   String?
  missionary     Missionary?   @relation(fields: [missionaryId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title          String?
  receivedDate   DateTime      @db.Date
  bytes          Bytes         // the file itself — see the comment above this model
  fileName       String        // original uploaded filename, for display/download
  contentType    String
  fileSize       Int?          // bytes
  notes          String?       @db.Text

  createdAt      DateTime      @default(now())
  createdById    String?

  @@index([missionaryId])
  @@index([organizationId])
}

// General-purpose document storage for a Missionary or Organization —
// survey responses, signed policy acknowledgments, other office documents
// (Word/Excel/PDF), and long-term email records that don't belong in the
// Newsletter feed above. Same private-DB-blob access model as Newsletter,
// same admin-only visibility — see the comment on Newsletter above for the
// reasoning. `category` is a plain validated string (see
// routes/documents.js), not a native Prisma enum — same convention as
// Organization.orgType and User.role elsewhere in this schema, so a fork
// can add its own category without a migration.
model Document {
  id             String        @id @default(uuid())
  missionaryId   String?
  missionary     Missionary?   @relation(fields: [missionaryId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  category       String        // "survey_response" | "signed_policy" | "email" | "office_document" | "other"
  customCategory String?       // free-typed label, only used when category is "other"
  title          String?
  receivedDate   DateTime      @db.Date
  bytes          Bytes         // the file itself — see the comment above this model
  fileName       String        // original uploaded filename, for display/download
  contentType    String
  fileSize       Int?          // bytes
  notes          String?       @db.Text

  createdAt      DateTime      @default(now())
  createdById    String?

  @@index([missionaryId])
  @@index([organizationId])
  @@index([category])
}

// Every photo ever uploaded for a Missionary or Organization, not just the
// current one — same shared-table approach as Newsletter. Unlike
// Newsletter, photos are public (served unauthenticated at
// GET /api/photos/:id/raw — maskData.js is what keeps a restricted
// record's real photo out of any response in the first place, not this
// route) — but the bytes still live in this row, not an object store;
// see the comment on Newsletter above for why. Same `omit: { bytes: true
// }` discipline applies here: every list/detail query synthesizes a
// `url: "/api/photos/<id>/raw"` string instead of ever returning the raw
// bytes inline. The "current" photo (shown in the admin form and, if the
// partner is public, on the public site) is whichever row has the latest
// receivedDate for that missionary/organization — not whichever was
// uploaded most recently, since backfilling an older photo shouldn't
// demote a more recent one that just hasn't been uploaded yet. Older
// photos stay queryable for history and can be deleted individually from
// the partner's detail page.
model Photo {
  id             String        @id @default(uuid())
  missionaryId   String?
  missionary     Missionary?   @relation(fields: [missionaryId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  bytes          Bytes         // the image itself
  receivedDate   DateTime      @db.Date // when this photo was actually taken/received, not upload time
  contentType    String?
  fileSize       Int?          // bytes

  createdAt      DateTime      @default(now())
  createdById    String?

  @@index([missionaryId])
  @@index([organizationId])
}

// Single-row table describing the church running this instance — used to
// white-label the app (name/branding/terminology) and to auto-fill the
// Sending Church section on a Missionary when this church is the sender.
// Fixed id so there's never more than one row; GET returns null before
// it's ever configured, PUT upserts it into existence.
model ChurchSettings {
  id                    String   @id @default("singleton")

  churchName            String?
  address               Json?    // { addressLine1, addressLine2, city, stateProvinceRegion, postalCode, country } — same shape as SendingChurch.mailingAddress, for a direct copy on autofill
  phone                 String?
  contactName           String?
  contactEmail          String?
  websiteLink           String?

  // What this church calls its partners, e.g. "Go Team Partner(s)".
  // Nullable — app code falls back to "Missionary"/"Missionaries" so an
  // unconfigured instance behaves exactly like it always has.
  partnerTermSingular   String?
  partnerTermPlural     String?
  // Off by default: admin nav/list headings keep saying "Missionary
  // Partners" (they describe the underlying data type an admin is
  // editing) unless a church opts into using its own term there too.
  usePartnerTermInAdmin Boolean  @default(false)

  publicTagline         String?  // short subtitle under the public map/directory header
  aboutText             String?  @db.Text // optional blurb shown on the public directory
  primaryColor          String?  // hex, overrides the site's --brand-color CSS variable
  // The site logo, stored right in this row — see the comment on the
  // Newsletter model for why this app keeps file bytes in Postgres
  // instead of an object store. Public, served unauthenticated at
  // GET /api/public/settings/logo/raw when set. API responses synthesize
  // a `logo: { url: "..." } | null` shape from these two columns rather
  // than ever returning logoBytes inline — same discipline as Photo.
  logoBytes             Bytes?
  logoContentType       String?

  // Per-church on/off switches for optional features -- keys are validated
  // against the registry in backend/src/utils/features.js (unknown keys
  // rejected), not modeled as their own columns, so adding a new gate-able
  // feature later is a one-line registry entry instead of a migration. A
  // missing key defaults to enabled -- see isFeatureEnabled in that same
  // file for the one exception (aiExtraction defaults to off).
  enabledFeatures       Json     @default("{}")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  updatedById           String?
}

// Users who can log into the admin backend.
// authProvider is "local" (username/password) or an SsoProvider's `type`
// (e.g. "entra", "google", "okta", "oidc") — set from whichever provider
// the user last authenticated through; see SsoProvider below.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?  // null for SSO-only accounts
  authProvider String   @default("local")
  role         String   @default("editor") // "admin" | "editor" | "viewer"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  // Which configured SsoProvider this user last signed in through, if any.
  // Nullable and SetNull on delete — losing the link just means the app no
  // longer knows which provider config to attribute future logins to; the
  // user row and its history stay intact.
  ssoProviderId String?
  ssoProvider   SsoProvider? @relation(fields: [ssoProviderId], references: [id], onDelete: SetNull)

  // TOTP MFA — opt-in per user, self-service enroll/disable from Account
  // Settings; mfaSecret is only ever set once mfaEnabled flow starts, and
  // is cleared whenever MFA is turned off (self-service or admin reset).
  // Encrypted at rest (see backend/src/utils/crypto.js) — TOTP verification
  // needs the raw secret back, so this can't be a one-way hash like a
  // password.
  mfaEnabled       Boolean  @default(false)
  mfaSecret        String?
  // Admin-set per-user policy flag: forces enrollment at next login when
  // true and mfaEnabled is still false. Independent of mfaEnabled so an
  // admin can mandate MFA for an account without knowing/setting the
  // secret themselves — the user still does the actual QR scan.
  mfaSetupRequired Boolean  @default(false)
}

// One row per configured SSO identity provider (Entra ID, Google, Okta, or
// any other standards-compliant OIDC provider). Configured entirely from
// the admin Church Settings UI — no env vars or redeploy needed to add,
// change, or disable one. `type` is a cosmetic hint for the admin UI/login
// button only; the actual login flow is one generic OIDC code path
// (backend/src/routes/sso.js, via `openid-client`) driven by discovery at
// `${issuerUrl}/.well-known/openid-configuration`, so any OIDC-compliant
// IdP works even when its type is just "oidc". clientSecret is encrypted
// at rest (see backend/src/utils/crypto.js) — this is deliberately not
// split between env vars and DB; see CONTRIBUTING.md.
model SsoProvider {
  id            String   @id @default(uuid())
  type          String   // "entra" | "google" | "okta" | "oidc" -- cosmetic only
  enabled       Boolean  @default(false)
  displayName   String   // shown on the login button, e.g. "Sign in with Entra ID"
  issuerUrl     String   // OIDC issuer; discovery fetched from {issuerUrl}/.well-known/openid-configuration
  clientId      String
  clientSecret  String   // encrypted at rest
  allowedDomain String?  // optional: only allow logins from this email domain

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedById   String?

  users         User[]
}
