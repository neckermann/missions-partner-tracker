  @@index([participantId])
}

// Identical storage shape to PartnerFile -- bytes in the row, no
// separate file storage (see that model's own comment). participantId:
// null means a trip-wide shared document (itinerary, packing list); set
// means a document specific to one participant (their own signed
// waiver, passport photo, health clearance). requirementId is nullable
// since not every document fulfills a tracked requirement, and when set
// always points at a `kind: "document"` or `kind: "esignature"`
// TripRequirement -- a "task" requirement has nothing to attach a file to.
model TripDocument {
  id            String           @id @default(uuid())
  tripId        String
  trip          Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  participantId String?
  participant   TripParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   TripRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  title       String?
  // bytes and signatureImage both live in TripDocumentBytes (below), a
  // one-to-one split-off table -- see TripParticipantPhoto's own comment
  // for why.
  fileName    String
  contentType String
  fileSize    Int? // bytes -- populated on new uploads only, same convention as PartnerFile.fileSize; existing rows stay null rather than a backfill migration for display-only metadata

  createdAt DateTime @default(now())

  // Signature audit fields -- null for an ordinary upload, populated
  // only when this row is the generated PDF of a signed "esignature"-kind
  // requirement. Previously a separate TripSignature side table keyed
  // 1:1 off this row's id; merged in directly since it never had an
  // independent existence of its own (nothing queried it without this
  // document, and nothing about esignature fulfillment needs a second
  // row -- it's the same "does a TripDocument exist for this
  // requirement+participant" anti-join every other document-fulfilled
  // requirement already uses).
  signerName           String? // always captured, whether they typed or drew
  // "self" | "parent/guardian" -- free text, not a DB enum, matching
  // every other preset-String field in this schema. Recordkeeping only:
  // nothing verifies that whoever actually typed/drew the signature is
  // who they claim -- this app has never verified signer identity for
  // any signature, and a parent using a minor's own self-service link
  // is mechanically indistinguishable from the minor using it
  // themselves. Exists so the signed document's own record (and the
  // signing page's label) are honest about who's expected to sign,
  // not to enforce it.
  signerRelationship   String?
  attestedAt           DateTime?
  ip                   String?
  // Snapshot of the exact text they agreed to, plus a hash of it --
  // computed server-side, never trusted from the client. Protects
  // against a later edit to the requirement's own bodyText (e.g. a
  // church rewording its waiver) silently being attributed to an old
  // signature; the hash makes any mismatch between this snapshot and a
  // later-edited requirement detectable, not just theoretically possible.
  documentTextSnapshot String?            @db.Text
  documentTextHash     String?
  bytesRow             TripDocumentBytes?

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@unique([requirementId, participantId])
  @@index([tripId])
  @@index([participantId])
}

model TripDocumentBytes {
  id             String       @id
  document       TripDocument @relation(fields: [id], references: [id], onDelete: Cascade)
  bytes          Bytes
  signatureImage Bytes? // drawn-signature PNG; null if they only typed their name
}

