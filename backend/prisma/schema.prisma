// Prisma schema for the Missions Team Missionary Tracker
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

// The connection URL used to live here (url = env("DATABASE_URL")) --
// Prisma 7 removed that; it's now in prisma.config.js instead (which
// also stays the single source of truth for prisma migrate/studio/etc.
// commands, not this file).
datasource db {
  provider = "postgresql"
}

// A partner this church supports -- either an individual/family missionary
// or a local/national partner organization, distinguished by `kind`.
//
// These were two separate models (Missionary and Organization) through
// v1.7.0. They shared 36 fields, and two of the apparent differences were
// just naming accidents for identical concepts (displayName vs name;
// missionTrips vs orgTrips, which pointed at the same Trip model). Every
// collection below already treated them interchangeably via twin nullable
// foreign keys, which meant an "exactly one parent" rule enforced only in
// application code, in eight different places -- and roughly 160 call
// sites across the app branching on which of the two it was holding.
// Merging them made `partnerId` a single non-nullable foreign key, so that
// invariant is now a database guarantee, and deleted the branching
// outright.
//
// The genuine differences are narrow, and handled as nullable columns and
// optional relations rather than separate tables: a missionary has a
// family, furloughs, and a sending party; an organization has an orgType
// and its own contact person. Nothing enforces at the DB level that an
// organization has no children -- application code simply never creates
// them, the same way it already handles every other "kind"-specific rule.
model Partner {
  id   String @id @default(uuid())
  kind String // "missionary" | "organization"

  // --- Visibility controls ---
  isPublic     Boolean @default(false) // show on public site at all
  isRestricted Boolean @default(false) // if public + restricted -> masked/generic view only

  // --- Status ---
  // Archiving is the "soft delete" — hides the record from admin lists by
  // default, forces isPublic off, and zeros out monthly support (via a new
  // SupportEntry, not by editing old ones) — while keeping every bit of
  // history intact. DELETE is only permitted once a record is archived, so
  // archiving is the deliberate first step toward ever actually removing
  // someone.
  archived   Boolean   @default(false)
  archivedAt DateTime?

  // --- Core identity / field info ---
  displayName      String
  fieldDisplayName String? // e.g. "Northern Uganda" - safe to show even if restricted
  fipsCountryCode  String?

  // overview is the long-form narrative; overviewShort is a one/two-line
  // summary for quick-read contexts (directory cards, list views).
  overview        String?   @db.Text
  overviewShort   String?
  focusArea       String?   @db.Text
  supportingSince DateTime? @db.Date // year-only values are stored as Jan 1 of that year

  // --- Contact ---
  preferredContactMethod String? // e.g. "Email", "Phone Call", "Text/SMS", "WhatsApp", "Mail"
  // Missionary-only: whether it's ok to contact them directly.
  contactSafe            Boolean @default(true)
  // Missionary-only: true when this church (see ChurchSettings) is this
  // missionary's sending church — distinct from the SendingParty relation
  // below, which records details about whichever church actually sends
  // them (may or may not be this one). Displayed as "Sent by
  // {ChurchSettings.churchName}" in the UI.
  sentByOurChurch        Boolean @default(false)
  // Organization-only: the person to reach at the organization. A
  // missionary is their own contact, so these stay null for that kind.
  contactName            String?
  contactPhone           String?
  contactEmail           String?

  // --- Kind-specific profile fields ---
  orgType          String? // organization-only: "Local" | "National"
  anniversary      DateTime? @db.Date // missionary-only
  languagesSpoken  String[]  @default([]) // missionary-only
  emergencyContact Json? // missionary-only: { name, phone, email }

  // --- Mission trip capacity: what kind of team this partner can host ---
  tripTeamSizeMin    Int?
  tripTeamSizeMax    Int?
  tripTypesSupported String[] @default([]) // e.g. ["Construction", "Medical/Dental"]
  tripSeasonNotes    String?  @db.Text // best time of year, typical duration, etc.
  tripLogisticsNotes String?  @db.Text // lodging, requirements, other logistics

  // --- Links — every field a real, individually validated column (no JSON blob) ---
  websiteLink      String?
  supportLink      String?
  newsletterSignup String?
  facebook         String?
  twitter          String?
  instagram        String?
  linkedin         String?

  // --- Collections ---
  // Each is its own resource with per-row create/update/delete (see the
  // route files). Deliberately never written as a nested array on a
  // Partner update: doing that meant deleting and recreating every child
  // row on each save, which churned their ids and silently destroyed rows
  // added through the collection's own endpoint in the meantime.
  addresses                Address[]
  trips                    Trip[]
  churchVisits             ChurchVisit[]
  supportEntries           SupportEntry[]
  // Named needRequests, not supportNeeds, to avoid colliding with the
  // ministry-need narrative text this app used to carry under that name.
  needRequests             SupportNeed[]
  prayerRequests           PrayerRequest[]
  files                    PartnerFile[]
  // Full upload history, not just the current one — see the Photo model.
  // The "current" photo (what the admin UI and public site show) is
  // whichever has the latest receivedDate, not just the latest upload.
  photos                   Photo[]
  notifiableEvents         NotifiableEvent[]
  // Scoped-digest follows (#202) -- who's opted into updates for just
  // this partner, rather than every partner. Two sources, same shape.
  followedByUsers          UserFollowedPartner[]
  publicSubscriberPartners PublicSubscriberPartner[]

  // --- Missionary-only collections (always empty for an organization) ---
  adults         Adult[]
  children       Child[]
  furloughs      Furlough[]
  sendingParties SendingParty[]

  // Audit is kept on Partner only, deliberately. The collections below
  // carried createdById inconsistently (and routes/photos.js never
  // populated the column it had), nothing in the app ever read any of it,
  // and half-populated provenance is worse than none because you can't
  // trust it. Here it's populated on every create/update, so it means
  // something.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([kind])
  @@index([isPublic, isRestricted])
  @@index([archived])
}

model Adult {
  id        String    @id @default(uuid())
  partnerId String
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name      String
  phone1    String?
  phone2    String?
  email     String?
  birthday  DateTime? @db.Date

  @@index([partnerId])
}

model Child {
  id        String    @id @default(uuid())
  partnerId String
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name      String
  birthday  DateTime? @db.Date

  @@index([partnerId])
}

// A partner can have up to one address per type. "physical" is their actual
// serving location (may be a full street address or just city/state/country,
// depending on what's known/safe to record) and is also the source of the
// public map pin (gpsLat/gpsLng). "mailing" is the US-side contact/support-
// mail address and has no coordinates.
model Address {
  id                  String   @id @default(uuid())
  partnerId           String
  partner             Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type                String // "physical" | "mailing"
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?
  gpsLat              Float?
  gpsLng              Float?
  receiveMail         Boolean?
  receivePackages     Boolean?

  @@unique([partnerId, type])
}

// A past team trip to visit this partner — history for reference, not a
// capacity/preference profile (that lives on Partner.tripTypesSupported etc).
model Trip {
  id            String            @id @default(uuid())
  partnerId     String
  partner       Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  startDate     DateTime?         @db.Date
  endDate       DateTime?         @db.Date
  tripType      String? // e.g. "Construction", "Medical/Dental" — preset or custom
  description   String?           @db.Text // what the team did
  notes         String?           @db.Text
  // External album link only -- never in-app file storage (see #130).
  // albumProvider is app-validated in trips.js, not a DB enum, matching
  // every other String-typed preset field in this schema (tripType etc).
  albumProvider String? // "google_photos" | "icloud" | "other"
  albumUrl      String?
  participants  TripParticipant[]

  @@index([partnerId])
}

// Individual person on a Trip. isLeader marks the trip leader(s) rather
// than keeping a separate, potentially-inconsistent "leader name" field.
model TripParticipant {
  id       String  @id @default(uuid())
  tripId   String
  trip     Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name     String
  role     String? // e.g. "Medical", "Construction", "Translator"
  isLeader Boolean @default(false)
  phone    String?
  email    String?

  @@index([tripId])
}

// A period of time a missionary is off the field and in their home
// country — missionary-only, unlike ChurchVisit below, since organizations
// don't go on furlough. endDate is nullable for an open-ended/ongoing
// furlough whose return date isn't settled yet.
model Furlough {
  id        String    @id @default(uuid())
  partnerId String
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  notes     String?   @db.Text

  @@index([partnerId])
}

// A single visit a partner made to (this) church — the reverse direction of
// Trip, which records us visiting them. "Last visit" is just the entry with
// the latest visitDate, mirroring how "current support" is read off
// SupportEntry.
model ChurchVisit {
  id        String   @id @default(uuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  visitDate DateTime @db.Date
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([partnerId])
}

// Who sent this missionary -- their sending church and/or sending
// organization, each recorded once per partner (`type` distinguishes which;
// @@unique enforces "at most one of each"). Missionary-only -- an
// organization has no equivalent "who sent it" concept. The address is real
// structured columns (matching Address's shape) rather than a JSON blob,
// which was never validated and never queryable.
model SendingParty {
  id                  String  @id @default(uuid())
  partnerId           String
  partner             Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type                String // "church" | "org"
  name                String?
  contactName         String?
  contactEmail        String?
  websiteLink         String?
  phone               String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?

  @@unique([partnerId, type])
}

// A monthly-support dollar amount effective as of a given date. "Current"
// support is just the most recent row by effectiveDate — the point of this
// table is the history, not a single overwritten amount, which is also why
// there's no update endpoint for it: correcting a mistake means deleting the
// bad row and adding a new one, the way a ledger works. Admin-only data:
// never surfaced through the public serializer.
model SupportEntry {
  id            String   @id @default(uuid())
  partnerId     String
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount        Int // whole dollars per month
  effectiveDate DateTime @db.Date
  notes         String?
  createdAt     DateTime @default(now())

  @@index([partnerId])
}

// A one-time financial need requested by a partner (e.g. "$1,000 to help a
// family in their congregation") and our response to it — distinct from
// SupportEntry, which tracks the recurring monthly amount.
// approvedAmount/approvedDate stay null until a decision is made, and
// approvedAmount may be less than requestedAmount (a partial gift) — there's
// no separate status enum; pending/declined/partial/fully-funded are all
// just read off of whether approvedAmount is set and how it compares to
// requestedAmount.
model SupportNeed {
  id              String    @id @default(uuid())
  partnerId       String
  partner         Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  description     String    @db.Text
  requestedAmount Int
  requestDate     DateTime  @db.Date
  approvedAmount  Int?
  approvedDate    DateTime? @db.Date
  // Documents *why* approvedAmount came out the way it did -- declined,
  // partially funded, or fully funded with a reason worth keeping on
  // record. Set alongside approvedAmount/approvedDate when a decision is
  // recorded, not at creation -- separate from the general `notes` field
  // below (settable any time, about anything), same reasoning
  // PrayerRequest.answeredNote is kept separate from a general notes
  // field. Surfaced in the supportNeedDecided notification -- see
  // notificationBlurbs.js.
  decisionNote    String?   @db.Text
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())

  // Same reasoning as PrayerRequest.isUrgent above.
  isUrgent Boolean @default(false)

  // Same source-link as PrayerRequest.sourceFileId above -- see that
  // comment for the full reasoning.
  sourceFileId String?
  sourceFile   PartnerFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  @@index([partnerId])
}

// A prayer request received from a partner — meant as a long-term, ongoing
// record of what's been prayed for and (when it happens) how it was
// answered, not a pass/fail checklist. `status` deliberately has no
// "unanswered" value: "ongoing" (the default) means still-open/still-praying,
// with no implication anything failed to happen — most requests, especially
// long-running ones, simply don't have a resolution yet, and that's normal,
// not a gap to flag. "untracked" is an explicit opt-out for requests nobody
// intends to revisit for a formal answer (a routine short-term ask like "safe
// travels this week"). "answered" is the one worth surfacing -- paired with
// dateAnswered and answeredNote, this is what lets a church look back over
// time and see how prayers were actually answered.
//
// `category` ("strategic" | "situational") controls where a request can ever
// be shown publicly: only "strategic" requests are eligible, and only when
// `isPublic` is also explicitly set — same explicit opt-in pattern as
// Partner.isPublic, so a strategic request isn't shown publicly just because
// of its category alone.
model PrayerRequest {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // "strategic" (tied to the ministry's long-term vision/calling -- church
  // planting, discipleship, language study, funding) vs "situational"
  // (whatever came up -- health, travel, family, paperwork). Replaces an
  // earlier short_term/long_term split that was about time horizon rather
  // than what the request actually was, which didn't map cleanly onto
  // "should this go on the public site/in the booklet" the way this does.
  category         String // "strategic" | "situational"
  requestText      String   @db.Text
  dateReceived     DateTime @db.Date
  isPublic         Boolean  @default(false) // only takes effect when category is "strategic"
  // Booklet space is tight (see AdminBooklet.jsx's per-page cap), so
  // isPublic alone doesn't mean a request prints -- this only takes effect
  // when isPublic is also true (a request can be public-site-only).
  includeInBooklet Boolean  @default(false)

  status       String    @default("ongoing") // "ongoing" | "answered" | "untracked"
  dateAnswered DateTime? @db.Date
  answeredNote String?   @db.Text

  // Admin/editor-set at creation (see notificationRecording.js's
  // sendUrgentBroadcast): bypasses every recipient's own cadence,
  // broadcasting immediately to GroupMe, admins, and public subscribers
  // alike. Does not bypass the restricted-partner review gate below, or
  // either channel's own content-type/structural eligibility rules --
  // see notificationEligibility.js's isEligibleForChannel, which
  // sendUrgentBroadcast calls exactly like every scheduled pass does.
  isUrgent Boolean @default(false)

  notes     String?  @db.Text
  createdAt DateTime @default(now())

  // Set when this request was added from ExtractionReviewModal.jsx's "Scan
  // for requests" flow, so the admin can get back to the original file
  // later. onDelete: SetNull, not Cascade -- deleting the source file a
  // request came from shouldn't delete the request itself, just its
  // back-link. Null for every request added by hand (the normal case,
  // unaffected by this). Never surfaced on the public site or in the
  // booklet.
  sourceFileId String?
  sourceFile   PartnerFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([category])
  @@index([status])
}

// A file received from a partner -- either a newsletter (PDF, .eml export,
// or a screenshot image) or a general-purpose document (survey response,
// signed policy acknowledgment, other office document, long-term email
// record), distinguished by `kind` -- a single flat, defined list, same
// convention as Partner.kind ("missionary" | "organization") above:
// "newsletter" is just one more value alongside the document-specific
// ones, not a structurally separate concept from them.
//
// The file itself lives right in this row (see `bytes` below) rather than
// in a separate object store — no external storage service to configure
// at all, and Postgres's TOAST mechanism already keeps large column values
// out-of-line and compressed, so this doesn't bloat ordinary queries.
// Deliberately not exposed by any query that doesn't need the actual file
// content (see the `omit: { bytes: true }` on every list/detail include
// across the route files) — reachable only through
// GET /api/partner-files/:id/download, admin-only. Fine at the scale this
// app runs at (one church's worth of files, not a multi-tenant media
// library) — see CONTRIBUTING.md if that ever stops being true for a
// particular fork.
model PartnerFile {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // A plain validated string (see routes/partnerFiles.js), not a native
  // Prisma enum — same convention as Partner.orgType and User.role
  // elsewhere in this schema, so a fork can add its own kind without a
  // migration. Inbound email always defaults new rows to "newsletter"
  // (that's the overwhelming majority of what actually arrives from a
  // partner) -- an admin who finds one mis-filed just edits `kind` via
  // the normal PUT, no separate "reclassify" action needed.
  kind       String // "newsletter" | "survey_response" | "signed_policy" | "email" | "office_document" | "other"
  // Free-typed label, only used when kind is "other".
  customKind String?

  title        String?
  receivedDate DateTime @db.Date
  bytes        Bytes // the file itself — see the comment above this model
  fileName     String // original uploaded filename, for display/download
  contentType  String
  fileSize     Int? // bytes
  notes        String?  @db.Text

  createdAt DateTime @default(now())

  // Back-relation for PrayerRequest/SupportNeed.sourceFileId above -- not
  // read directly (requests/needs are fetched by partner, not by source),
  // but Prisma requires both sides of a relation declared.
  sourcedPrayerRequests PrayerRequest[]
  sourcedSupportNeeds   SupportNeed[]

  @@index([partnerId])
  @@index([kind])
}

// Inbound email (see #72) that couldn't be auto-matched to a partner --
// held here for an admin to assign by hand or discard. A row's mere
// existence means "pending": both outcomes (assign, discard) delete the
// row rather than mark a status, since once assigned it's just a
// PartnerFile (see routes/inboundEmail.js) and there's nothing left here
// worth keeping around. No partnerId/relation -- that's the whole point,
// this is what's left *unmatched*.
model InboundEmail {
  id          String   @id @default(uuid())
  receivedAt  DateTime @default(now())
  fromAddress String
  subject     String?
  bytes       Bytes // the raw .eml source -- same storage shape as PartnerFile.bytes above
  fileName    String
  createdAt   DateTime @default(now())
}

// A recorded event, capable of independently producing up to three
// deliveries -- GroupMe, the admin digest, the public digest -- each
// tracked by its own stamp column below (see notificationEligibility.js's
// isEligibleForChannel, the one function all three channels call
// identically). Renamed from PendingNotification: that name implied one
// row is one notification, which stopped being true once a single row
// could independently reach up to three different channels.
//
// A row's mere existence means "recorded, not yet fully delivered," same
// InboundEmail convention above, but deletion here is per-channel-aware
// rather than unconditional -- see notificationOrchestrator.js's
// clearNotifiableEvents(): a row is only deleted once every channel's
// answer is either permanently resolved (ineligible by type/structure, or
// a toggle/feature that was off at the pass where it was evaluated --
// also permanent, not retried if the toggle flips back on) or actually
// sent (that channel's own stamp column is set). A channel whose send
// failed leaves its own stamp null, so the next pass retries only that
// channel without re-sending to one that already succeeded.
//
// `payload` holds whatever this event type's notification text needs to
// render later (requestText/description/approvedAmount/etc., plus
// sourceFileId for the source-file cross-link) --
// a `type` + `payload Json` shape instead of a column per event type,
// since the 5 event shapes genuinely differ and none of it needs to be
// relationally queried later, only read back whole at send time.
model NotifiableEvent {
  id        String   @id @default(uuid())
  // "prayerRequestCreated" | "prayerRequestAnswered" | "supportNeedCreated" | "supportNeedDecided" | "newsletterCreated"
  type      String
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime @default(now())

  // GroupMe's own stamp -- set once groupmeChannel.js's postToGroupMe
  // successfully posts this row, or immediately by sendUrgentBroadcast.
  groupmeSentAt DateTime?

  // WhatsApp's own stamp -- same convention as groupmeSentAt above, set
  // by whatsappChannel.js's postToWhatsApp (or immediately by
  // sendUrgentBroadcast). Its own column, not shared with GroupMe's: a
  // church can run both channels at once, and one being down or
  // disconnected must never mark the other's delivery as done.
  whatsappSentAt DateTime?

  // Admin-edited body text (#187) -- any recorded event can be edited
  // before it sends, restricted or not; see routes/notifications.js's
  // PUT /pending/:id. reviewedAt null means "never edited," same
  // one-nullable-timestamp convention as groupmeSentAt above, not a
  // separate boolean that could disagree with it. reviewedById is
  // audit-only, no FK, same convention as Partner's own
  // createdById/updatedById. reviewedText, once set, overrides the
  // computed body text for any row -- see notificationBlurbs.js. For a
  // RESTRICTED partner's real-content notification specifically,
  // reviewedAt null also means "held, not eligible to send yet" for the
  // types REVIEW_GATED_TYPES actually covers (prayer requests, one-time
  // needs) -- see notificationEligibility.js's isEligibleForChannel --
  // but that hold is a separate concern layered on top of this plain
  // edit mechanism, not a property of these columns themselves. A
  // restricted partner's newsletter is exempt from this gate entirely:
  // buildBlurb() already fully suppresses its content regardless of
  // review state, so there's nothing left to protect by holding it.
  // Structural masking (name/photo/source link) stays in effect
  // regardless of edit state either way. Re-editing overwrites all three.
  reviewedAt   DateTime?
  reviewedById String?
  reviewedText String?   @db.Text

  // One stamp per email cadence tier, not one per audience -- a single
  // tier's send pass considers every User and PublicSubscriber on that
  // tier at once, so a row only needs one "did this tier's pass get to
  // this" marker, not a separate admin and public pair. A single shared
  // stamp set by whichever tier fires first would permanently suppress
  // the slower tiers from ever receiving the row at all, not just delay
  // them -- that's why there are three of these, not one. See
  // digestDelivery.js's send loop for what writes them, and
  // notificationOrchestrator.js's clearNotifiableEvents() for the
  // per-row, per-tier eligibility check these pair with. Tiers are
  // biweekly/monthly/quarterly -- weekly was retired along with the old
  // church-wide batch mechanism (see ChurchSettings' own comment).
  biweeklyDigestSentAt  DateTime?
  monthlyDigestSentAt   DateTime?
  quarterlyDigestSentAt DateTime?

  @@index([type])
  @@index([partnerId])
}

// Every photo ever uploaded for a partner, not just the current one — same
// in-row bytes approach as PartnerFile. Unlike PartnerFile, photos are public
// (served unauthenticated at GET /api/photos/:id/raw — the public serializer
// is what keeps a restricted record's real photo out of any response in the
// first place, not this route). Same `omit: { bytes: true }` discipline
// applies: every list/detail query synthesizes a `url: "/api/photos/<id>/raw"`
// string instead of ever returning the raw bytes inline. The "current" photo
// (shown in the admin UI and, if the partner is public, on the public site)
// is whichever row has the latest receivedDate — not whichever was uploaded
// most recently, since backfilling an older photo shouldn't demote a more
// recent one that just hasn't been uploaded yet. Older photos stay queryable
// for history and can be deleted individually from the partner's page.
model Photo {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  bytes        Bytes // the image itself
  receivedDate DateTime @db.Date // when this photo was actually taken/received, not upload time
  contentType  String?
  fileSize     Int? // bytes

  createdAt DateTime @default(now())

  @@index([partnerId])
}

// Single-row table describing the church running this instance — used to
// white-label the app (name/branding/terminology) and to auto-fill the
// Sending Church section on a missionary when this church is the sender.
// Fixed id so there's never more than one row; GET returns null before
// it's ever configured, PUT upserts it into existence.
model ChurchSettings {
  id String @id @default("singleton")

  churchName   String?
  address      Json? // { addressLine1, addressLine2, city, stateProvinceRegion, postalCode, country } — same shape as SendingParty's address columns, for a direct copy on autofill
  phone        String?
  contactName  String?
  contactEmail String?
  websiteLink  String?

  // What this church calls its partners, e.g. "Go Team Partner(s)".
  // Nullable — app code falls back to "Missionary"/"Missionaries" so an
  // unconfigured instance behaves exactly like it always has.
  partnerTermSingular   String?
  partnerTermPlural     String?
  // Off by default: admin nav/list headings keep saying "Missionary
  // Partners" (they describe the underlying data type an admin is
  // editing) unless a church opts into using its own term there too.
  usePartnerTermInAdmin Boolean @default(false)

  publicTagline   String? // short subtitle under the public map/directory header
  aboutText       String? @db.Text // optional blurb shown on the public directory
  // Three independently-pickable brand colors (see #182's history for why
  // not a single color, and why not a full template builder): primaryColor
  // is the ACCENT role (buttons, links, headings, letterhead -- the color
  // people actually associate with the church), headerColor is header +
  // admin sidebar background, highlightColor is hover/focus/active/
  // selected interaction feedback. primaryColor's field name predates the
  // other two and is kept as-is rather than renamed -- no church has ever
  // set a custom value, so there's nothing to preserve, but renaming would
  // just be churn for a field that already works.
  primaryColor    String? // hex, overrides --brand-color; ACCENT role
  headerColor     String? // hex, overrides --brand-header-color; header + admin sidebar background
  highlightColor  String? // hex, overrides --brand-highlight-color; hover/focus/active/selected feedback
  brandFont       String? // literal CSS font-family stack (not an abstract key), overrides --brand-font; curated choices offered in AdminSettingsBranding.jsx
  // The site logo, stored right in this row — see the comment on the
  // PartnerFile model for why this app keeps file bytes in Postgres
  // instead of an object store. Public, served unauthenticated at
  // GET /api/public/settings/logo/raw when set. API responses synthesize
  // a `logo: { url: "..." } | null` shape from these two columns rather
  // than ever returning logoBytes inline — same discipline as Photo.
  logoBytes       Bytes?
  logoContentType String?

  // GroupMe integration (see backend/src/utils/groupmeChannel.js). The user's
  // own personal access token, not a bot -- GroupMe Topics (a group chat
  // inside a group chat) are undocumented in the public API but real:
  // each topic is a "subgroup" with its own id (GET
  // /groups/:groupId/subgroups), and the ordinary messages endpoint
  // (POST /groups/:id/messages) posts into it when pointed at that id
  // instead of the parent group's. A bot can't reach any of that -- the
  // Bots API has no subgroup awareness at all -- so this has to be the
  // user's own token. Encrypted at rest via utils/crypto.js's
  // encryptField (the same AES-256-GCM helper User.mfaSecret uses
  // below). Every route that touches this row outside
  // routes/settings.js's dedicated /groupme sub-routes must omit it, so
  // it never rides along in the general settings payload any logged-in
  // role can read.
  groupmeAccessToken          String?
  // The parent group the admin picked, and its topics -- both selected
  // from live GroupMe API calls (GET /groups, GET /groups/:id/subgroups)
  // in the admin UI, never hand-typed, so the *Name fields are just a
  // cached label for display, not something this app invents.
  groupmeGroupId              String?
  groupmeGroupName            String?
  // Phase 1 mapped Prayer Requests only -- this is that later phase.
  // One-Time Needs and Newsletters each get their own groupme*TopicId/
  // Name pair, not a single generic "topic" field that would need
  // renaming once there's more than one notification type.
  groupmePrayerTopicId        String?
  groupmePrayerTopicName      String?
  groupmeOneTimeNeedTopicId   String?
  groupmeOneTimeNeedTopicName String?
  groupmeNewsletterTopicId    String?
  groupmeNewsletterTopicName  String?

  // WhatsApp integration (see backend/src/utils/whatsappChannel.js and
  // whatsappClient.js). Unlike GroupMe there is no token to store: the
  // credential is a whole Baileys session (creds plus many Signal keys),
  // which lives in the WhatsAppAuthEntry table below, encrypted per row.
  // Nothing in this block is a secret -- they're display labels and the
  // ids picked from live lists in the admin UI (never hand-typed), same
  // as groupmeGroupName etc.
  //
  // One WhatsApp *community* containing several groups, mapped onto the
  // same three notification types GroupMe maps onto Topics. There is no
  // "default group" fallback like GroupMe's: a type with no group picked
  // is simply not sent (and never held in the queue either -- see
  // notificationOrchestrator.js's clearNotifiableEvents).
  whatsappPhoneNumber          String? // digits only, the dedicated number the app is paired as
  whatsappPairedAt             DateTime?
  whatsappCommunityId          String?
  whatsappCommunityName        String?
  whatsappPrayerGroupId        String?
  whatsappPrayerGroupName      String?
  whatsappOneTimeNeedGroupId   String?
  whatsappOneTimeNeedGroupName String?
  whatsappNewsletterGroupId    String?
  whatsappNewsletterGroupName  String?

  // Joshua Project API key (see backend/src/utils/joshuaProject.js) --
  // country-level unreached-people-group stats shown on a partner's page,
  // admin-managed on its own settings page like every other optional
  // integration. Encrypted at rest the same way as groupmeAccessToken
  // above, for the same reason -- every route that touches this row
  // outside routes/settings.js's dedicated
  // /joshua-project sub-routes must omit it.
  joshuaProjectApiKey String?

  // Anthropic API key (see backend/src/utils/extraction.js) -- powers "AI
  // request scanning," admin-managed on its own settings page like every
  // other optional integration. Encrypted at rest the same way as
  // groupmeAccessToken/joshuaProjectApiKey above, for the same reason --
  // every route that touches this row outside routes/settings.js's
  // dedicated /ai-extraction sub-routes must omit it. This is real money
  // (pay-per-scan usage on the key owner's Anthropic account), so treat
  // "never leaks into a response" here as load-bearing, not a nice-to-have
  // -- see the dedicated leak-check tests in test/routes/aiExtraction.test.js.
  anthropicApiKey String?

  // Postmark server API token for outbound email (see
  // backend/src/utils/email.js) -- a transactional email provider, not
  // SMTP against the church's own Gmail/Microsoft mailbox (see #71: that
  // path has a real expiration date, Microsoft is turning off SMTP AUTH
  // basic auth for every Exchange Online tenant by end of 2026). Encrypted
  // at rest the same way as groupmeAccessToken/joshuaProjectApiKey/
  // anthropicApiKey above, for the same reason -- every route that
  // touches this row outside routes/settings.js's dedicated /email
  // sub-routes must omit it. emailFromAddress is the "From:" address
  // shown to recipients -- not a secret (same as groupmeGroupName etc.
  // above), so plain text, no encryptField.
  postmarkServerToken String?
  emailFromAddress    String?

  // Inbound email (see #72, backend/src/routes/inboundEmail.js) -- same
  // Postmark account as outbound above, its inbound webhook this time.
  // Postmark has no HMAC signature verification for inbound webhooks, so
  // the webhook URL carries HTTP Basic Auth instead; inboundEmailWebhookPassword
  // is checked against the Authorization header with a constant-time
  // compare. Encrypted the same way as postmarkServerToken above, for the
  // same reason -- every route outside routes/settings.js's dedicated
  // /inbound-email sub-routes (and the webhook handler's own auth check)
  // must omit it. inboundEmailWebhookUsername is not a secret on its own
  // (meaningless without the password), so plain text.
  inboundEmailWebhookUsername String?
  inboundEmailWebhookPassword String?

  // Per-church on/off switches for optional features -- keys are validated
  // against the registry in backend/src/utils/features.js (unknown keys
  // rejected), not modeled as their own columns, so adding a new gate-able
  // feature later is a one-line registry entry instead of a migration. A
  // missing key defaults to enabled -- see isFeatureEnabled in that same
  // file for the one exception (aiExtraction defaults to off).
  enabledFeatures Json @default("{}")

  // Deliberate, explicit opt-out of BackupReminder.jsx's periodic nudge --
  // distinct from that component's own dismiss-for-30-days (stored in
  // localStorage, per-browser, temporary). This is server-side and
  // permanent until an admin turns it back on, for a church that's
  // confirmed its database provider's own backups are actually working.
  // Default false: the reminder is on until someone deliberately says
  // otherwise, not silently opted out by a missing value.
  backupReminderDisabled Boolean @default(false)

  // Schedule for the admin/public digest's three cadence tiers --
  // biweekly/monthly/quarterly (weekly was retired along with the old
  // church-wide batch mechanism this replaced; see digestDelivery.js
  // and digestScheduler.js). Biweekly shares scopedDigestDayOfWeek with
  // nothing else now, kept the same field name rather than renaming for
  // a tier-set change alone; monthly and quarterly both read
  // scopedDigestDayOfMonth (capped at 1-28 specifically to dodge the
  // "the 31st doesn't exist in February" class of edge case), told
  // apart only by each tier's own minimum-gap check against its own
  // lastSentAt cursor below -- no separate "which cycle" state needed.
  // A separate cursor per tier, not one shared one, since the three
  // fire on different cycles and must each independently dedupe within
  // their own matching hour.
  scopedDigestDayOfWeek           Int? // 0 (Sun) - 6 (Sat) -- biweekly
  scopedDigestDayOfMonth          Int? // 1 - 28 -- monthly/quarterly
  scopedDigestHour                Int? // 0 - 23, in this church's configured timezone (see `timezone` below)
  lastBiweeklyScopedDigestSentAt  DateTime?
  lastMonthlyScopedDigestSentAt   DateTime?
  lastQuarterlyScopedDigestSentAt DateTime?

  // GroupMe's own schedule -- a single daily batch hour, not a tier
  // pick. GroupMe never actually had an independent schedule before
  // this (it silently rode the old church-wide digest's now-retired
  // schedule) -- a weekly/monthly tier wouldn't fit a chat-style,
  // near-real-time channel anyway. lastGroupmeDigestSentAt is this
  // schedule's own dedupe guard, mirroring the scopedDigest cursors
  // above but at daily granularity -- no day-of-week/day-of-month field
  // needed, since there's no larger period to pick a day within. See
  // groupmeChannel.js's shouldFlushGroupMe.
  groupmeDigestHour       Int? // 0 - 23, in this church's configured timezone
  lastGroupmeDigestSentAt DateTime?
  // WhatsApp shares groupmeDigestHour above (and the three
  // notifyGroupMe* content-type mutes) -- one chat schedule, not two --
  // but keeps its own dedupe cursor. A shared cursor would let whichever
  // channel ran first on a tick stamp it and block the other from ever
  // sending that day. The column names stay "groupme*" so existing forks
  // upgrade without a rename; only the admin UI labels say "chat".
  lastWhatsappDigestSentAt DateTime?

  // This church's own IANA timezone (e.g. "America/New_York"), applied
  // to process.env.TZ once at server startup (see server.js) -- every
  // Hour-based schedule check above, plus birthdays/furlough elsewhere
  // in this app, depends on process.env.TZ actually matching the
  // church's real local time, which nothing set before this field
  // existed (Render's own default is UTC). Defaults to "America/Chicago"
  // rather than UTC -- every church this app has actually been built
  // for so far is US-based, so a brand-new deployment that never visits
  // this setting should already be close to correct, not off by several
  // hours until someone finds and changes it. Still just a starting
  // point: any church can pick its own real zone from this field's
  // `<select>`. Changing this takes effect on the next restart/deploy,
  // not instantly -- process.env.TZ is read once at boot, since changing
  // it mid-process is documented as unreliable.
  timezone String @default("America/Chicago")

  // Per-channel content-type mutes, GroupMe only -- the admin digest
  // always includes every content type it's allowed to (no toggle), and
  // the public digest was never toggle-based either (structurally
  // prayer-requests-only regardless). GroupMe is different: it's a
  // chat-style, near-real-time channel, where muting one content type
  // while keeping others is a real, worthwhile control. Renamed from
  // queueNotify* -- those names implied blocking *recording*, which
  // none of these three do; only allowRestrictedPartnerNotifications
  // below still works that way. Default true (matches this app's
  // long-standing behavior: every content type notified unless muted).
  notifyGroupMePrayerRequests         Boolean @default(true)
  notifyGroupMeOneTimeNeeds           Boolean @default(true)
  notifyGroupMeNewsletters            Boolean @default(true)
  // The one setting that applies to every channel equally (GroupMe and
  // both digests), not just GroupMe -- a creation-time safety gate, not
  // a delivery preference: off means a restricted partner's event is
  // never recorded at all, for any type, because the review gate it
  // would otherwise wait on (see NotifiableEvent.reviewedAt) waits on a
  // human action that might never come, and a church that doesn't
  // actively watch that review queue needs a way to opt out of the
  // burden entirely rather than accumulate an ever-growing unreviewed
  // backlog. Renamed from queueNotifyRestrictedPartners to read as the
  // distinct, cross-cutting rule it actually is, rather than a fourth
  // peer of the three GroupMe mutes above. Defaults off -- this is a
  // real safety gate (restricted-partner content waiting on manual
  // review, possibly indefinitely), not something a church should be
  // opted into without deciding to take it on.
  allowRestrictedPartnerNotifications Boolean @default(false)

  // Digest email customization (see #182) -- null subject/signature means
  // "use the built-in default" (see DEFAULT_SUBJECT_TEMPLATE in
  // digestShell.js), same blank-means-default convention every other
  // admin-text field in this app already follows. Shared config: the
  // same three settings drive both the admin digest and the public
  // digest now, not an admin-only concern.
  // digestSubjectTemplate supports {church}/{month}/{year}/{date}/
  // {cadence}/{name}/{term} tokens, substituted in digestShell.js -- an
  // admin writes plain text, not a real template language, so no other
  // token syntax (conditionals, loops) is ever needed or supported.
  digestSubjectTemplate String?
  // A short closing line (a verse, "Questions? Contact us", etc.) shown
  // near the digest's footer, above the unsubscribe link. Deliberately
  // separate from publicTagline (the public-site subtitle) -- this is
  // email-specific and never shown anywhere else.
  digestSignature       String? @db.Text
  // Which digest layout to render -- "classic" (plain text-only partner
  // cards, the original design) or "snapshot" (adds each partner's
  // photo/silhouette, field, "Supporting since", and short overview above
  // their items -- see digestShell.js's partnerTileDetails()). Null/unset
  // means "classic", so every church's digest looks exactly the same as
  // before this field existed until one opts in.
  digestTemplate        String? // "classic" | "snapshot"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// Users who can log into the admin backend.
//
// authProvider is always "local" (email + password, optionally with TOTP
// two-factor). It used to also carry an SSO provider's type; SSO was removed
// in 3.1.0 because auto-provisioning handed an account to anyone at the
// configured identity provider, and in this app any account can read every
// partner's full record. The column stays so routes/auth.js can keep
// refusing to password-authenticate anything that isn't "local" -- cheap
// insurance if a passwordless row is ever created some other way.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String?
  passwordHash String? // nullable only for historical rows; every account created now is local
  authProvider String    @default("local")
  role         String    @default("editor") // "admin" | "editor" | "viewer"
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  // TOTP MFA — opt-in per user, self-service enroll/disable from Account
  // Settings; mfaSecret is only ever set once mfaEnabled flow starts, and
  // is cleared whenever MFA is turned off (self-service or admin reset).
  // Encrypted at rest (see backend/src/utils/crypto.js) — TOTP verification
  // needs the raw secret back, so this can't be a one-way hash like a
  // password.
  mfaEnabled       Boolean @default(false)
  mfaSecret        String?
  // The last TOTP time step accepted for this user, so the same code can't
  // be used twice. A TOTP code stays valid for its whole 30-second window,
  // which means one shoulder-surfed or phished code is replayable until it
  // expires; otplib rejects a repeat when the accepted step is passed back
  // as `afterTimeStep`. Null until their first successful code.
  mfaLastTimeStep  Int?
  // Admin-set per-user policy flag: forces enrollment at next login when
  // true and mfaEnabled is still false. Independent of mfaEnabled so an
  // admin can mandate MFA for an account without knowing/setting the
  // secret themselves — the user still does the actual QR scan.
  mfaSetupRequired Boolean @default(false)

  // Opt-in per user, self-service from Account Settings -- same pattern
  // as MFA above. null = not subscribed to the admin digest email (see
  // digestDelivery.js); a value is which of the three cadence tiers
  // this user picked. Renamed from digestFrequency -- matches the word
  // this app's own docs/plan already use everywhere in prose, and no
  // longer collides in meaning with ChurchSettings' own, unrelated
  // digestFrequency (the old church-wide batch mechanism's field,
  // retired). One nullable field for "subscribed at all" and "to what
  // cadence" together, same convention as NotifiableEvent.reviewedAt,
  // not two fields that could disagree. Flipped to null directly by the
  // signed unsubscribe link in every digest email's footer, no login
  // required (see this file's own /unsubscribe route).
  cadence          String? // "biweekly" | "monthly" | "quarterly" | null
  // Scope for this user's own digest, independent of the schedule
  // above -- mirrors PublicSubscriber's identical shape.
  // false means only the partners in followedPartners below; true (the
  // default, matching every existing subscriber's current behavior)
  // means every partner this user's role can already see.
  allPartners      Boolean               @default(true)
  followedPartners UserFollowedPartner[]
}

// Join rows for a user's specific-partner digest scope (#202) -- only
// populated when User.allPartners is false. Identical shape to
// PublicSubscriberPartner below, intentionally -- same mechanism, two
// different subscriber sources.
model UserFollowedPartner {
  userId    String
  partnerId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([userId, partnerId])
  @@index([partnerId])
}

// A public, no-login email subscription to prayer-request updates.
// Rides the exact same NotifiableEvent rows an admin subscriber does,
// through the one shared isEligibleForChannel function
// (notificationEligibility.js) -- structurally prayer-requests-only,
// never a one-time need, never a newsletter or a link back to one; see
// digestDelivery.js for the shared send-pass both subscriber types go
// through, and digestShell.js for the shared render shell.
//
// Double opt-in: confirmedAt null means "never confirmed, never sent
// to." A row is created unconfirmed on POST /api/public/subscribe and
// only starts receiving digests once the emailed confirmation link is
// clicked.
model PublicSubscriber {
  id          String    @id @default(uuid())
  email       String    @unique
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  // Which of the three cadence tiers this subscriber picked -- same
  // three options User.cadence above already uses. Renamed from
  // frequency to match -- see that field's own comment for why.
  // Defaults to "biweekly," the nearest tier now that weekly is gone.
  cadence String @default("biweekly") // "biweekly" | "monthly" | "quarterly"

  // Same all-vs-specific shape as User.allPartners above.
  allPartners    Boolean                   @default(true)
  scopedPartners PublicSubscriberPartner[]

  @@index([confirmedAt])
}

// Join rows for a public subscriber's specific-partner scope -- only
// populated when PublicSubscriber.allPartners is false. See
// UserFollowedPartner's own comment above for why this is a separate,
// identically-shaped table rather than one polymorphic one.
model PublicSubscriberPartner {
  subscriberId String
  partnerId    String
  subscriber   PublicSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  partner      Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([subscriberId, partnerId])
  @@index([partnerId])
}

// The WhatsApp (Baileys) session, one row per auth-state key: "creds"
// plus a row per Signal key ("pre-key-12", "session-<jid>", ...). Lives in
// the database, not on disk, because Render's web-service filesystem is
// ephemeral -- a file-based session would be wiped on every deploy and
// force a re-pair. `value` is always an encryptField() ciphertext (the
// serialized JSON never touches the table in plaintext), so losing
// FIELD_ENCRYPTION_KEY means re-pairing, exactly like losing the GroupMe
// token. Never selected into any API response -- see whatsappAuthState.js.
model WhatsAppAuthEntry {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
