// Prisma schema for the Missions Team Missionary Tracker
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

// The connection URL used to live here (url = env("DATABASE_URL")) --
// Prisma 7 removed that; it's now in prisma.config.js instead (which
// also stays the single source of truth for prisma migrate/studio/etc.
// commands, not this file).
datasource db {
  provider = "postgresql"
}

// A partner this church supports -- either an individual/family missionary
// or a local/national partner organization, distinguished by `kind`.
//
// These were two separate models (Missionary and Organization) through
// v1.7.0. They shared 36 fields, and two of the apparent differences were
// just naming accidents for identical concepts (displayName vs name;
// missionTrips vs orgTrips, which pointed at the same Trip model). Every
// collection below already treated them interchangeably via twin nullable
// foreign keys, which meant an "exactly one parent" rule enforced only in
// application code, in eight different places -- and roughly 160 call
// sites across the app branching on which of the two it was holding.
// Merging them made `partnerId` a single non-nullable foreign key, so that
// invariant is now a database guarantee, and deleted the branching
// outright.
//
// The genuine differences are narrow, and handled as nullable columns and
// optional relations rather than separate tables: a missionary has a
// family, furloughs, and a sending party; an organization has an orgType
// and its own contact person. Nothing enforces at the DB level that an
// organization has no children -- application code simply never creates
// them, the same way it already handles every other "kind"-specific rule.
model Partner {
  id           String @id @default(uuid())
  kind         String // "missionary" | "organization"

  // --- Visibility controls ---
  isPublic     Boolean @default(false) // show on public site at all
  isRestricted Boolean @default(false) // if public + restricted -> masked/generic view only

  // --- Status ---
  // Archiving is the "soft delete" — hides the record from admin lists by
  // default, forces isPublic off, and zeros out monthly support (via a new
  // SupportEntry, not by editing old ones) — while keeping every bit of
  // history intact. DELETE is only permitted once a record is archived, so
  // archiving is the deliberate first step toward ever actually removing
  // someone.
  archived   Boolean   @default(false)
  archivedAt DateTime?

  // --- Core identity / field info ---
  displayName      String
  fieldDisplayName String? // e.g. "Northern Uganda" - safe to show even if restricted
  fipsCountryCode  String?

  // overview is the long-form narrative; overviewShort is a one/two-line
  // summary for quick-read contexts (directory cards, list views).
  overview        String?   @db.Text
  overviewShort   String?
  focusArea       String?   @db.Text
  supportingSince DateTime? @db.Date // year-only values are stored as Jan 1 of that year

  // --- Contact ---
  preferredContactMethod String? // e.g. "Email", "Phone Call", "Text/SMS", "WhatsApp", "Mail"
  // Missionary-only: whether it's ok to contact them directly.
  contactSafe            Boolean @default(true)
  // Missionary-only: true when this church (see ChurchSettings) is this
  // missionary's sending church — distinct from the SendingParty relation
  // below, which records details about whichever church actually sends
  // them (may or may not be this one). Displayed as "Sent by
  // {ChurchSettings.churchName}" in the UI.
  sentByOurChurch        Boolean @default(false)
  // Organization-only: the person to reach at the organization. A
  // missionary is their own contact, so these stay null for that kind.
  contactName            String?
  contactPhone           String?
  contactEmail           String?

  // --- Kind-specific profile fields ---
  orgType         String?   // organization-only: "Local" | "National"
  anniversary     DateTime? @db.Date // missionary-only
  languagesSpoken String[]  @default([]) // missionary-only
  emergencyContact Json?    // missionary-only: { name, phone, email }

  // --- Mission trip capacity: what kind of team this partner can host ---
  tripTeamSizeMin    Int?
  tripTeamSizeMax    Int?
  tripTypesSupported String[] @default([]) // e.g. ["Construction", "Medical/Dental"]
  tripSeasonNotes    String?  @db.Text // best time of year, typical duration, etc.
  tripLogisticsNotes String?  @db.Text // lodging, requirements, other logistics

  // --- Links — every field a real, individually validated column (no JSON blob) ---
  websiteLink      String?
  supportLink      String?
  newsletterSignup String?
  facebook         String?
  twitter          String?
  instagram        String?
  linkedin         String?

  // --- Collections ---
  // Each is its own resource with per-row create/update/delete (see the
  // route files). Deliberately never written as a nested array on a
  // Partner update: doing that meant deleting and recreating every child
  // row on each save, which churned their ids and silently destroyed rows
  // added through the collection's own endpoint in the meantime.
  addresses      Address[]
  trips          Trip[]
  churchVisits   ChurchVisit[]
  supportEntries SupportEntry[]
  // Named needRequests, not supportNeeds, to avoid colliding with the
  // ministry-need narrative text this app used to carry under that name.
  needRequests   SupportNeed[]
  prayerRequests PrayerRequest[]
  newsletters    Newsletter[]
  documents      Document[]
  // Full upload history, not just the current one — see the Photo model.
  // The "current" photo (what the admin UI and public site show) is
  // whichever has the latest receivedDate, not just the latest upload.
  photos         Photo[]

  // --- Missionary-only collections (always empty for an organization) ---
  adults         Adult[]
  children       Child[]
  furloughs      Furlough[]
  sendingParties SendingParty[]

  // Audit is kept on Partner only, deliberately. The collections below
  // carried createdById inconsistently (and routes/photos.js never
  // populated the column it had), nothing in the app ever read any of it,
  // and half-populated provenance is worse than none because you can't
  // trust it. Here it's populated on every create/update, so it means
  // something.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([kind])
  @@index([isPublic, isRestricted])
  @@index([archived])
}

model Adult {
  id        String    @id @default(uuid())
  partnerId String
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name      String
  phone1    String?
  phone2    String?
  email     String?
  birthday  DateTime? @db.Date

  @@index([partnerId])
}

model Child {
  id        String    @id @default(uuid())
  partnerId String
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name      String
  birthday  DateTime? @db.Date

  @@index([partnerId])
}

// A partner can have up to one address per type. "physical" is their actual
// serving location (may be a full street address or just city/state/country,
// depending on what's known/safe to record) and is also the source of the
// public map pin (gpsLat/gpsLng). "mailing" is the US-side contact/support-
// mail address and has no coordinates.
model Address {
  id                  String  @id @default(uuid())
  partnerId           String
  partner             Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type                String // "physical" | "mailing"
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?
  gpsLat              Float?
  gpsLng              Float?
  receiveMail         Boolean?
  receivePackages     Boolean?

  @@unique([partnerId, type])
}

// A past team trip to visit this partner — history for reference, not a
// capacity/preference profile (that lives on Partner.tripTypesSupported etc).
model Trip {
  id           String            @id @default(uuid())
  partnerId    String
  partner      Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  startDate    DateTime?         @db.Date
  endDate      DateTime?         @db.Date
  tripType     String? // e.g. "Construction", "Medical/Dental" — preset or custom
  description  String?           @db.Text // what the team did
  notes        String?           @db.Text
  participants TripParticipant[]

  @@index([partnerId])
}

// Individual person on a Trip. isLeader marks the trip leader(s) rather
// than keeping a separate, potentially-inconsistent "leader name" field.
model TripParticipant {
  id       String  @id @default(uuid())
  tripId   String
  trip     Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name     String
  role     String? // e.g. "Medical", "Construction", "Translator"
  isLeader Boolean @default(false)
  phone    String?
  email    String?

  @@index([tripId])
}

// A period of time a missionary is off the field and in their home
// country — missionary-only, unlike ChurchVisit below, since organizations
// don't go on furlough. endDate is nullable for an open-ended/ongoing
// furlough whose return date isn't settled yet.
model Furlough {
  id        String    @id @default(uuid())
  partnerId String
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  notes     String?   @db.Text

  @@index([partnerId])
}

// A single visit a partner made to (this) church — the reverse direction of
// Trip, which records us visiting them. "Last visit" is just the entry with
// the latest visitDate, mirroring how "current support" is read off
// SupportEntry.
model ChurchVisit {
  id        String   @id @default(uuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  visitDate DateTime @db.Date
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([partnerId])
}

// Who sent this missionary -- their sending church and/or sending
// organization, each recorded once per partner (`type` distinguishes which;
// @@unique enforces "at most one of each"). Missionary-only -- an
// organization has no equivalent "who sent it" concept. The address is real
// structured columns (matching Address's shape) rather than a JSON blob,
// which was never validated and never queryable.
model SendingParty {
  id                  String  @id @default(uuid())
  partnerId           String
  partner             Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type                String // "church" | "org"
  name                String?
  contactName         String?
  contactEmail        String?
  websiteLink         String?
  phone               String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?

  @@unique([partnerId, type])
}

// A monthly-support dollar amount effective as of a given date. "Current"
// support is just the most recent row by effectiveDate — the point of this
// table is the history, not a single overwritten amount, which is also why
// there's no update endpoint for it: correcting a mistake means deleting the
// bad row and adding a new one, the way a ledger works. Admin-only data:
// never surfaced through the public serializer.
model SupportEntry {
  id            String   @id @default(uuid())
  partnerId     String
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount        Int // whole dollars per month
  effectiveDate DateTime @db.Date
  notes         String?
  createdAt     DateTime @default(now())

  @@index([partnerId])
}

// A one-time financial need requested by a partner (e.g. "$1,000 to help a
// family in their congregation") and our response to it — distinct from
// SupportEntry, which tracks the recurring monthly amount.
// approvedAmount/approvedDate stay null until a decision is made, and
// approvedAmount may be less than requestedAmount (a partial gift) — there's
// no separate status enum; pending/declined/partial/fully-funded are all
// just read off of whether approvedAmount is set and how it compares to
// requestedAmount.
model SupportNeed {
  id              String    @id @default(uuid())
  partnerId       String
  partner         Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  description     String    @db.Text
  requestedAmount Int
  requestDate     DateTime  @db.Date
  approvedAmount  Int?
  approvedDate    DateTime? @db.Date
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())

  @@index([partnerId])
}

// A prayer request received from a partner — meant as a long-term, ongoing
// record of what's been prayed for and (when it happens) how it was
// answered, not a pass/fail checklist. `status` deliberately has no
// "unanswered" value: "ongoing" (the default) means still-open/still-praying,
// with no implication anything failed to happen — most requests, especially
// long-running ones, simply don't have a resolution yet, and that's normal,
// not a gap to flag. "untracked" is an explicit opt-out for requests nobody
// intends to revisit for a formal answer (a routine short-term ask like "safe
// travels this week"). "answered" is the one worth surfacing -- paired with
// dateAnswered and answeredNote, this is what lets a church look back over
// time and see how prayers were actually answered.
//
// `category` ("strategic" | "situational") controls where a request can ever
// be shown publicly: only "strategic" requests are eligible, and only when
// `isPublic` is also explicitly set — same explicit opt-in pattern as
// Partner.isPublic, so a strategic request isn't shown publicly just because
// of its category alone.
model PrayerRequest {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // "strategic" (tied to the ministry's long-term vision/calling -- church
  // planting, discipleship, language study, funding) vs "situational"
  // (whatever came up -- health, travel, family, paperwork). Replaces an
  // earlier short_term/long_term split that was about time horizon rather
  // than what the request actually was, which didn't map cleanly onto
  // "should this go on the public site/in the booklet" the way this does.
  category         String // "strategic" | "situational"
  requestText      String   @db.Text
  dateReceived     DateTime @db.Date
  isPublic         Boolean  @default(false) // only takes effect when category is "strategic"
  // Booklet space is tight (see AdminBooklet.jsx's per-page cap), so
  // isPublic alone doesn't mean a request prints -- this only takes effect
  // when isPublic is also true (a request can be public-site-only).
  includeInBooklet Boolean  @default(false)

  status       String    @default("ongoing") // "ongoing" | "answered" | "untracked"
  dateAnswered DateTime? @db.Date
  answeredNote String?   @db.Text

  notes     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([partnerId])
  @@index([category])
  @@index([status])
}

// A newsletter file (PDF, .eml export, or a screenshot image) received from a
// partner. The file itself lives right in this row (see `bytes` below) rather
// than in a separate object store — no external storage service to configure
// at all, and Postgres's TOAST mechanism already keeps large column values
// out-of-line and compressed, so this doesn't bloat ordinary queries.
// Deliberately not exposed by any query that doesn't need the actual file
// content (see the `omit: { bytes: true }` on every list/detail include
// across the route files) — reachable only through
// GET /api/newsletters/:id/download, admin-only. Fine at the scale this app
// runs at (one church's worth of files, not a multi-tenant media library) —
// see CONTRIBUTING.md if that ever stops being true for a particular fork.
model Newsletter {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  title        String?
  receivedDate DateTime @db.Date
  bytes        Bytes // the file itself — see the comment above this model
  fileName     String // original uploaded filename, for display/download
  contentType  String
  fileSize     Int? // bytes
  notes        String?  @db.Text

  createdAt DateTime @default(now())

  @@index([partnerId])
}

// General-purpose document storage for a partner — survey responses, signed
// policy acknowledgments, other office documents (Word/Excel/PDF), and
// long-term email records that don't belong in the Newsletter feed above.
// Same private-DB-blob access model as Newsletter, same admin-only
// visibility. `category` is a plain validated string (see
// routes/documents.js), not a native Prisma enum — same convention as
// Partner.orgType and User.role elsewhere in this schema, so a fork can add
// its own category without a migration.
model Document {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  category       String // "survey_response" | "signed_policy" | "email" | "office_document" | "other"
  customCategory String? // free-typed label, only used when category is "other"
  title          String?
  receivedDate   DateTime @db.Date
  bytes          Bytes // the file itself — see the comment above this model
  fileName       String // original uploaded filename, for display/download
  contentType    String
  fileSize       Int? // bytes
  notes          String?  @db.Text

  createdAt DateTime @default(now())

  @@index([partnerId])
  @@index([category])
}

// Every photo ever uploaded for a partner, not just the current one — same
// in-row bytes approach as Newsletter. Unlike Newsletter, photos are public
// (served unauthenticated at GET /api/photos/:id/raw — the public serializer
// is what keeps a restricted record's real photo out of any response in the
// first place, not this route). Same `omit: { bytes: true }` discipline
// applies: every list/detail query synthesizes a `url: "/api/photos/<id>/raw"`
// string instead of ever returning the raw bytes inline. The "current" photo
// (shown in the admin UI and, if the partner is public, on the public site)
// is whichever row has the latest receivedDate — not whichever was uploaded
// most recently, since backfilling an older photo shouldn't demote a more
// recent one that just hasn't been uploaded yet. Older photos stay queryable
// for history and can be deleted individually from the partner's page.
model Photo {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  bytes        Bytes // the image itself
  receivedDate DateTime @db.Date // when this photo was actually taken/received, not upload time
  contentType  String?
  fileSize     Int? // bytes

  createdAt DateTime @default(now())

  @@index([partnerId])
}

// Single-row table describing the church running this instance — used to
// white-label the app (name/branding/terminology) and to auto-fill the
// Sending Church section on a missionary when this church is the sender.
// Fixed id so there's never more than one row; GET returns null before
// it's ever configured, PUT upserts it into existence.
model ChurchSettings {
  id String @id @default("singleton")

  churchName   String?
  address      Json? // { addressLine1, addressLine2, city, stateProvinceRegion, postalCode, country } — same shape as SendingParty's address columns, for a direct copy on autofill
  phone        String?
  contactName  String?
  contactEmail String?
  websiteLink  String?

  // What this church calls its partners, e.g. "Go Team Partner(s)".
  // Nullable — app code falls back to "Missionary"/"Missionaries" so an
  // unconfigured instance behaves exactly like it always has.
  partnerTermSingular   String?
  partnerTermPlural     String?
  // Off by default: admin nav/list headings keep saying "Missionary
  // Partners" (they describe the underlying data type an admin is
  // editing) unless a church opts into using its own term there too.
  usePartnerTermInAdmin Boolean @default(false)

  publicTagline String? // short subtitle under the public map/directory header
  aboutText     String? @db.Text // optional blurb shown on the public directory
  primaryColor  String? // hex, overrides the site's --brand-color CSS variable
  // The site logo, stored right in this row — see the comment on the
  // Newsletter model for why this app keeps file bytes in Postgres
  // instead of an object store. Public, served unauthenticated at
  // GET /api/public/settings/logo/raw when set. API responses synthesize
  // a `logo: { url: "..." } | null` shape from these two columns rather
  // than ever returning logoBytes inline — same discipline as Photo.
  logoBytes       Bytes?
  logoContentType String?

  // Per-church on/off switches for optional features -- keys are validated
  // against the registry in backend/src/utils/features.js (unknown keys
  // rejected), not modeled as their own columns, so adding a new gate-able
  // feature later is a one-line registry entry instead of a migration. A
  // missing key defaults to enabled -- see isFeatureEnabled in that same
  // file for the one exception (aiExtraction defaults to off).
  enabledFeatures Json @default("{}")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// Users who can log into the admin backend.
// authProvider is "local" (username/password) or an SsoProvider's `type`
// (e.g. "entra", "google", "okta", "oidc") — set from whichever provider
// the user last authenticated through; see SsoProvider below.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String?
  passwordHash String? // null for SSO-only accounts
  authProvider String    @default("local")
  role         String    @default("editor") // "admin" | "editor" | "viewer"
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  // Which configured SsoProvider this user last signed in through, if any.
  // Nullable and SetNull on delete — losing the link just means the app no
  // longer knows which provider config to attribute future logins to; the
  // user row and its history stay intact.
  ssoProviderId String?
  ssoProvider   SsoProvider? @relation(fields: [ssoProviderId], references: [id], onDelete: SetNull)

  // TOTP MFA — opt-in per user, self-service enroll/disable from Account
  // Settings; mfaSecret is only ever set once mfaEnabled flow starts, and
  // is cleared whenever MFA is turned off (self-service or admin reset).
  // Encrypted at rest (see backend/src/utils/crypto.js) — TOTP verification
  // needs the raw secret back, so this can't be a one-way hash like a
  // password.
  mfaEnabled Boolean @default(false)
  mfaSecret  String?
  // Admin-set per-user policy flag: forces enrollment at next login when
  // true and mfaEnabled is still false. Independent of mfaEnabled so an
  // admin can mandate MFA for an account without knowing/setting the
  // secret themselves — the user still does the actual QR scan.
  mfaSetupRequired Boolean @default(false)
}

// One row per configured SSO identity provider (Entra ID, Google, Okta, or
// any other standards-compliant OIDC provider). Configured entirely from
// the admin Church Settings UI — no env vars or redeploy needed to add,
// change, or disable one. `type` is a cosmetic hint for the admin UI/login
// button only; the actual login flow is one generic OIDC code path
// (backend/src/routes/sso.js, via `openid-client`) driven by discovery at
// `${issuerUrl}/.well-known/openid-configuration`, so any OIDC-compliant
// IdP works even when its type is just "oidc". clientSecret is encrypted
// at rest (see backend/src/utils/crypto.js) — this is deliberately not
// split between env vars and DB; see CONTRIBUTING.md.
model SsoProvider {
  id            String  @id @default(uuid())
  type          String // "entra" | "google" | "okta" | "oidc" -- cosmetic only
  enabled       Boolean @default(false)
  displayName   String // shown on the login button, e.g. "Sign in with Entra ID"
  issuerUrl     String // OIDC issuer; discovery fetched from {issuerUrl}/.well-known/openid-configuration
  clientId      String
  clientSecret  String // encrypted at rest
  allowedDomain String? // optional: only allow logins from this email domain

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  users User[]
}
