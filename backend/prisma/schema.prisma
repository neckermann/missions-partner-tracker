// Replaces the old Partner.tripTypesSupported String[] column -- same
// per-row-CRUD reasoning as PartnerLink/PartnerLanguage above, not a
// trip-capacity-specific exception. No @@unique: a partner can support
// several trips of what's effectively the same custom type string
// without that being an error, the same way PartnerLanguage doesn't
// block a duplicate language either.
model TripType {
  id        String   @id @default(uuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type      String // e.g. "Construction", "Medical/Dental" -- preset or custom
  createdAt DateTime @default(now())

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
}

// Who sent this missionary -- their sending church and/or sending
// organization, each recorded once per partner (`type` distinguishes which;
// @@unique enforces "at most one of each"). Missionary-only -- an
// organization has no equivalent "who sent it" concept. The address is real
// structured columns (matching Address's shape) rather than a JSON blob,
// which was never validated and never queryable.
model SendingParty {
  id                  String  @id @default(uuid())
  partnerId           String
  partner             Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type                String // "church" | "org"
  name                String?
  // #257/#271 Finding 4: split first/last.
  contactFirstName    String?
  contactLastName     String?
  contactEmail        String?
  websiteLink         String?
  phone               String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@unique([partnerId, type])
}

// A monthly-support dollar amount effective as of a given date. "Current"
// support is just the most recent row by effectiveDate — the point of this
// table is the history, not a single overwritten amount, which is also why
// there's no update endpoint for it: correcting a mistake means deleting the
// bad row and adding a new one, the way a ledger works. Admin-only data:
// never surfaced through the public serializer.
model SupportEntry {
  id            String   @id @default(uuid())
  partnerId     String
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount        Int // whole dollars per month
  effectiveDate DateTime @db.Date
  notes         String?
  createdAt     DateTime @default(now())

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
}

// A named, saved set of filters for one report. `shared` views are visible
// to every admin/editor/viewer; private ones only to the owner. `params`
// is the report's own query params exactly as the report page sends them.
model SavedReport {
  id        String           @id @default(uuid())
  reportId  String // a report id from backend/src/reporting/registry.js
  name      String
  params    Json
  shared    Boolean          @default(false)
  ownerId   String
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  schedules ReportSchedule[]

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([ownerId])
  @@index([reportId])
}

// Emails a saved view on a cadence. Always rendered for the "shared"
// audience (restricted partners masked), because the recipient may not be
// signed in. `skipIfEmpty` avoids "nothing to report" emails. Recipients
// are existing user ids -- never free-form addresses -- so an email can't
// be pointed outside the church's own accounts.
model ReportSchedule {
  id            String      @id @default(uuid())
  savedReportId String
  savedReport   SavedReport @relation(fields: [savedReportId], references: [id], onDelete: Cascade)
  cadence       String // "weekly" | "monthly" | "quarterly"
  recipientIds  String[] // User ids
  skipIfEmpty   Boolean     @default(true)
  active        Boolean     @default(true)
  lastSentAt    DateTime?
  createdAt     DateTime    @default(now())

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([savedReportId])
}

// A one-time financial need requested by a partner (e.g. "$1,000 to help a
// family in their congregation") and our response to it — distinct from
// SupportEntry, which tracks the recurring monthly amount.
// approvedAmount/approvedDate stay null until a decision is made, and
// approvedAmount may be less than requestedAmount (a partial gift) — there's
// no separate status enum; pending/declined/partial/fully-funded are all
// just read off of whether approvedAmount is set and how it compares to
// requestedAmount.
model SupportNeed {
  id              String    @id @default(uuid())
  partnerId       String
  partner         Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  description     String    @db.Text
  requestedAmount Int
  requestDate     DateTime  @db.Date
  approvedAmount  Int?
  approvedDate    DateTime? @db.Date
  // Documents *why* approvedAmount came out the way it did -- declined,
  // partially funded, or fully funded with a reason worth keeping on
  // record. Set alongside approvedAmount/approvedDate when a decision is
  // recorded, not at creation -- separate from the general `notes` field
  // below (settable any time, about anything), same reasoning
  // PrayerRequest.answeredNote is kept separate from a general notes
  // field. Surfaced in the supportNeedDecided dispatch -- see
  // dispatchBlurbs.js.
  decisionNote    String?   @db.Text
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())

  // Same reasoning as PrayerRequest.isUrgent above.
  isUrgent Boolean @default(false)

  // Same source-link as PrayerRequest.sourceFileId above -- see that
  // comment for the full reasoning.
  sourceFileId String?
  sourceFile   PartnerFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
}

// A prayer request received from a partner — meant as a long-term, ongoing
// record of what's been prayed for and (when it happens) how it was
// answered, not a pass/fail checklist. `status` deliberately has no
// "unanswered" value: "ongoing" (the default) means still-open/still-praying,
// with no implication anything failed to happen — most requests, especially
// long-running ones, simply don't have a resolution yet, and that's normal,
// not a gap to flag. "untracked" is an explicit opt-out for requests nobody
// intends to revisit for a formal answer (a routine short-term ask like "safe
// travels this week"). "answered" is the one worth surfacing -- paired with
// dateAnswered and answeredNote, this is what lets a church look back over
// time and see how prayers were actually answered.
//
// `category` ("strategic" | "situational") controls where a request can ever
// be shown publicly: only "strategic" requests are eligible, and only when
// `isPublic` is also explicitly set — same explicit opt-in pattern as
// Partner.isPublic, so a strategic request isn't shown publicly just because
// of its category alone.
model PrayerRequest {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // "strategic" (tied to the ministry's long-term vision/calling -- church
  // planting, discipleship, language study, funding) vs "situational"
  // (whatever came up -- health, travel, family, paperwork). Replaces an
  // earlier short_term/long_term split that was about time horizon rather
  // than what the request actually was, which didn't map cleanly onto
  // "should this go on the public site/in the booklet" the way this does.
  category         String // "strategic" | "situational"
  requestText      String   @db.Text
  dateReceived     DateTime @db.Date
  isPublic         Boolean  @default(false) // only takes effect when category is "strategic"
  // Booklet space is tight (see AdminBooklet.jsx's per-page cap), so
  // isPublic alone doesn't mean a request prints -- this only takes effect
  // when isPublic is also true (a request can be public-site-only).
  includeInBooklet Boolean  @default(false)

  status       String    @default("ongoing") // "ongoing" | "answered" | "untracked"
  dateAnswered DateTime? @db.Date
  answeredNote String?   @db.Text

  // Admin/editor-set at creation (see dispatchOrchestrator.js's
  // sendUrgentDispatch): bypasses every recipient's own cadence,
  // dispatching immediately to GroupMe, admins, and public subscribers
  // alike. Does not bypass the restricted-partner review gate below, or
  // either channel's own content-type/structural eligibility rules --
  // see dispatchEligibility.js's isEligibleForChannel, which
  // sendUrgentDispatch calls exactly like every scheduled pass does.
  isUrgent Boolean @default(false)

  notes     String?  @db.Text
  createdAt DateTime @default(now())

  // Set when this request was added from ExtractionReviewModal.jsx's "Scan
  // for requests" flow, so the admin can get back to the original file
  // later. onDelete: SetNull, not Cascade -- deleting the source file a
  // request came from shouldn't delete the request itself, just its
  // back-link. Null for every request added by hand (the normal case,
  // unaffected by this). Never surfaced on the public site or in the
  // booklet.
  sourceFileId String?
  sourceFile   PartnerFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
  @@index([category])
  @@index([status])
}

// A file received from a partner -- either a newsletter (PDF, .eml export,
// or a screenshot image) or a general-purpose document (survey response,
// signed policy acknowledgment, other office document, long-term email
// record), distinguished by `kind` -- a single flat, defined list, same
// convention as Partner.kind ("missionary" | "organization") above:
// "newsletter" is just one more value alongside the document-specific
// ones, not a structurally separate concept from them.
//
// The file itself lives right in this row (see `bytes` below) rather than
// in a separate object store — no external storage service to configure
// at all, and Postgres's TOAST mechanism already keeps large column values
// out-of-line and compressed, so this doesn't bloat ordinary queries.
// Deliberately not exposed by any query that doesn't need the actual file
// content (see the `omit: { bytes: true }` on every list/detail include
// across the route files) — reachable only through
// GET /api/partner-files/:id/download, admin-only. Fine at the scale this
// app runs at (one church's worth of files, not a multi-tenant media
// library) — see CONTRIBUTING.md if that ever stops being true for a
// particular fork.
model PartnerFile {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // A plain validated string (see routes/partnerFiles.js), not a native
  // Prisma enum — same convention as Partner.orgType and User.role
  // elsewhere in this schema, so a fork can add its own kind without a
  // migration. Inbound email always defaults new rows to "newsletter"
  // (that's the overwhelming majority of what actually arrives from a
  // partner) -- an admin who finds one mis-filed just edits `kind` via
  // the normal PUT, no separate "reclassify" action needed.
  kind       String // "newsletter" | "survey_response" | "signed_policy" | "email" | "office_document" | "other"
  // Free-typed label, only used when kind is "other".
  customKind String?

  title        String?
  receivedDate DateTime @db.Date
  // The file's own bytes live in PartnerFileBytes (below), a one-to-one
  // split-off table -- see TripParticipantPhoto's own comment for why
  // (structurally prevents the #274 production-hang bug class rather than
  // relying on every future query remembering to select/omit).
  fileName     String // original uploaded filename, for display/download
  contentType  String
  fileSize     Int? // bytes
  notes        String?  @db.Text

  createdAt DateTime @default(now())

  // Back-relation for PrayerRequest/SupportNeed.sourceFileId above -- not
  // read directly (requests/needs are fetched by partner, not by source),
  // but Prisma requires both sides of a relation declared.
  sourcedPrayerRequests PrayerRequest[]
  sourcedSupportNeeds   SupportNeed[]
  bytesRow              PartnerFileBytes?

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
  @@index([kind])
}

model PartnerFileBytes {
  id    String      @id
  file  PartnerFile @relation(fields: [id], references: [id], onDelete: Cascade)
  bytes Bytes
}

// Inbound email (see #72) that couldn't be auto-matched to a partner --
// held here for an admin to assign by hand or discard. A row's mere
// existence means "pending": both outcomes (assign, discard) delete the
// row rather than mark a status, since once assigned it's just a
// PartnerFile (see routes/inboundEmail.js) and there's nothing left here
// worth keeping around. No partnerId/relation -- that's the whole point,
// this is what's left *unmatched*.
model InboundEmail {
  id          String             @id @default(uuid())
  receivedAt  DateTime           @default(now())
  fromAddress String
  subject     String?
  // The raw .eml source lives in InboundEmailBytes (below), a one-to-one
  // split-off table -- see TripParticipantPhoto's own comment for why.
  fileName    String
  createdAt   DateTime           @default(now())
  bytesRow    InboundEmailBytes?
  // #327 Finding 5: null for the original reason this queue exists (zero
  // or more than one partner matched the sender address -- nothing to
  // guess between). Set to a short explanation when a message DID match
  // exactly one partner by address but still landed here because Postmark's
  // own SPF/DKIM signals didn't confirm the sender -- see
  // routes/inboundEmail.js's isSenderVerified(). From is trivially
  // forgeable on its own; this is the one thing standing between a
  // forged letter and it being auto-filed and broadcast under a real
  // partner's name.
  queueReason String?
}

model InboundEmailBytes {
  id    String       @id
  email InboundEmail @relation(fields: [id], references: [id], onDelete: Cascade)
  bytes Bytes
}

// A webhook call that never became a real InboundEmail row -- bad/missing
// credentials, a missing From/RawEmail field, or an unexpected exception
// while processing one. Previously these just returned a 4xx/500 with
// nothing persisted anywhere, so there was no way to see afterward that
// anything had even gone wrong (see the in-app notifications plan's
// "Inbound email processing errors" category). rawPayloadSnippet is a
// short, truncated excerpt for debugging context, not the full payload --
// this table is a failure log, not a second copy of InboundEmail/Bytes.
model InboundEmailFailure {
  id                String   @id @default(uuid())
  receivedAt        DateTime @default(now())
  reason            String
  rawPayloadSnippet String?  @db.Text
}

// A recorded event, capable of independently producing up to four
// dispatches -- GroupMe, WhatsApp, the admin email dispatch, the public
// email dispatch -- each tracked by its own stamp column below (see
// dispatchEligibility.js's isEligibleForChannel, the one function all
// four channels call identically). Named DispatchRecord rather than an
// "event"-based name on purpose: a future in-app notification feature is
// exactly the kind of thing that would want to build itself around
// "events," and this record is the thing each of those four channels
// dispatches from, not an event in that sense.
//
// A row's mere existence means "recorded, not yet fully delivered," same
// InboundEmail convention above, but deletion here is per-channel-aware
// rather than unconditional -- see dispatchOrchestrator.js's
// clearDispatchRecords(): a row is only deleted once every channel's
// answer is either permanently resolved (ineligible by type/structure, or
// a toggle/feature that was off at the pass where it was evaluated --
// also permanent, not retried if the toggle flips back on) or actually
// sent (that channel's own stamp column is set). A channel whose send
// failed leaves its own stamp null, so the next pass retries only that
// channel without re-sending to one that already succeeded.
//
// `payload` holds whatever this event type's dispatch text needs to
// render later (requestText/description/approvedAmount/etc., plus
// sourceFileId for the source-file cross-link) --
// a `type` + `payload Json` shape instead of a column per event type,
// since the 5 event shapes genuinely differ and none of it needs to be
// relationally queried later, only read back whole at send time.
model DispatchRecord {
  id        String   @id @default(uuid())
  // "prayerRequestCreated" | "prayerRequestAnswered" | "supportNeedCreated" | "supportNeedDecided" | "newsletterCreated"
  type      String
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime @default(now())

  // GroupMe's own stamp -- set once groupmeChannel.js's postToGroupMe
  // successfully posts this row, or immediately by sendUrgentDispatch.
  groupmeDispatchedAt DateTime?

  // WhatsApp's own stamp -- same convention as groupmeDispatchedAt
  // above, set by whatsappChannel.js's postToWhatsApp (or immediately by
  // sendUrgentDispatch). Its own column, not shared with GroupMe's: a
  // church can run both channels at once, and one being down or
  // disconnected must never mark the other's delivery as done.
  whatsappDispatchedAt DateTime?

  // Admin-edited body text (#187) -- any recorded event can be edited
  // before it sends, restricted or not; see routes/dispatches.js's
  // PUT /pending/:id. dispatchReviewedAt null means "never edited," same
  // one-nullable-timestamp convention as groupmeDispatchedAt above, not a
  // separate boolean that could disagree with it. dispatchReviewedById is
  // audit-only, no FK, same convention as Partner's own
  // createdById/updatedById. dispatchReviewedText, once set, overrides
  // the computed body text for any row -- see dispatchBlurbs.js. For a
  // RESTRICTED partner's real-content dispatch specifically,
  // dispatchReviewedAt null also means "held, not eligible to send yet"
  // for the types REVIEW_GATED_TYPES actually covers (prayer requests,
  // one-time needs) -- see dispatchEligibility.js's isEligibleForChannel
  // -- but that hold is a separate concern layered on top of this plain
  // edit mechanism, not a property of these columns themselves. A
  // restricted partner's newsletter is exempt from this gate entirely:
  // buildBlurb() already fully suppresses its content regardless of
  // review state, so there's nothing left to protect by holding it.
  // Structural masking (name/photo/source link) stays in effect
  // regardless of edit state either way. Re-editing overwrites all three.
  dispatchReviewedAt   DateTime?
  dispatchReviewedById String?
  dispatchReviewedText String?   @db.Text

  // #289: held until staff approve it, whether or not the partner is
  // restricted. Set on a record made from a care team member's (non-staff)
  // prayer request or need, so nothing a care team member enters is sent
  // anywhere -- admin email, public email, GroupMe, WhatsApp, or the urgent
  // path -- until an admin/editor reviews it in Pending Dispatches (the same
  // review that already holds a restricted partner's content, and the same
  // dispatchReviewedAt that releases it). false for every staff-made record,
  // so staff behaviour is unchanged.
  reviewRequired Boolean @default(false)

  // One stamp per email cadence tier, not one per audience -- a single
  // tier's send pass considers every User and PublicSubscriber on that
  // tier at once, so a row only needs one "did this tier's pass get to
  // this" marker, not a separate admin and public pair. A single shared
  // stamp set by whichever tier fires first would permanently suppress
  // the slower tiers from ever receiving the row at all, not just delay
  // them -- that's why there are three of these, not one. See
  // emailDispatchDelivery.js's send loop for what writes them, and
  // dispatchOrchestrator.js's clearDispatchRecords() for the
  // per-row, per-tier eligibility check these pair with. Tiers are
  // biweekly/monthly/quarterly -- weekly was retired along with the old
  // church-wide batch mechanism (see ChurchSettings' own comment).
  biweeklyEmailDispatchSentAt  DateTime?
  monthlyEmailDispatchSentAt   DateTime?
  quarterlyEmailDispatchSentAt DateTime?

  // One nullable error string per channel, set in that channel's own
  // send-attempt catch block (groupmeChannel.js/whatsappChannel.js/
  // emailDispatchDelivery.js/dispatchOrchestrator.js's urgent-send path)
  // instead of just console.error-ing and leaving nothing queryable
  // after the fact -- see the in-app notifications plan's "Dispatch send
  // failures" category. A row's own *DispatchedAt stamp being null is
  // already ambiguous between "not attempted"/"ineligible"/"failed"; this
  // is what actually tells those three apart for "failed." Cleared back
  // to null the next time that channel's send for this row succeeds.
  groupmeError  String?
  whatsappError String?
  emailError    String?

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([type])
  @@index([partnerId])
}

// Every photo ever uploaded for a partner, not just the current one — same
// in-row bytes approach as PartnerFile. Unlike PartnerFile, photos are public
// (served unauthenticated at GET /api/photos/:id/raw — the public serializer
// is what keeps a restricted record's real photo out of any response in the
// first place, not this route). Same `omit: { bytes: true }` discipline
// applies: every list/detail query synthesizes a `url: "/api/photos/<id>/raw"`
// string instead of ever returning the raw bytes inline. The "current" photo
// (shown in the admin UI and, if the partner is public, on the public site)
// is whichever row has the latest receivedDate — not whichever was uploaded
// most recently, since backfilling an older photo shouldn't demote a more
// recent one that just hasn't been uploaded yet. Older photos stay queryable
// for history and can be deleted individually from the partner's page.
model Photo {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // The image itself lives in PhotoBytes (below), a one-to-one split-off
  // table -- see TripParticipantPhoto's own comment for why.
  receivedDate DateTime @db.Date // when this photo was actually taken/received, not upload time
  contentType  String?
  fileSize     Int? // bytes

  createdAt DateTime    @default(now())
  bytesRow  PhotoBytes?

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
}

model PhotoBytes {
  id    String @id
  photo Photo  @relation(fields: [id], references: [id], onDelete: Cascade)
  bytes Bytes
}

// Single-row table describing the church running this instance — used to
// white-label the app (name/branding/terminology) and to auto-fill the
// Sending Church section on a missionary when this church is the sender.
// Fixed id so there's never more than one row; GET returns null before
// it's ever configured, PUT upserts it into existence.
model ChurchSettings {
  id String @id @default("singleton")

  churchName          String?
  // #271 Finding 3: flat columns, not a Json blob -- same shape and
  // reasoning as SendingParty's own address columns, which this was
  // always meant to match for a direct copy on autofill.
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?
  phone               String?
  // #257/#271 Finding 4: split first/last.
  contactFirstName    String?
  contactLastName     String?
  contactEmail        String?
  websiteLink         String?

  // What this church calls its partners, e.g. "Go Team Partner(s)".
  // Nullable — app code falls back to "Missionary"/"Missionaries" so an
  // unconfigured instance behaves exactly like it always has.
  partnerTermSingular   String?
  partnerTermPlural     String?
  // Off by default: admin nav/list headings keep saying "Missionary
  // Partners" (they describe the underlying data type an admin is
  // editing) unless a church opts into using its own term there too.
  usePartnerTermInAdmin Boolean @default(false)

  publicTagline   String? // short subtitle under the public map/directory header
  aboutText       String?             @db.Text // optional blurb shown on the public directory
  // Three independently-pickable brand colors (see #182's history for why
  // not a single color, and why not a full template builder): primaryColor
  // is the ACCENT role (buttons, links, headings, letterhead -- the color
  // people actually associate with the church), headerColor is header +
  // admin sidebar background, highlightColor is hover/focus/active/
  // selected interaction feedback. primaryColor's field name predates the
  // other two and is kept as-is rather than renamed -- no church has ever
  // set a custom value, so there's nothing to preserve, but renaming would
  // just be churn for a field that already works.
  primaryColor    String? // hex, overrides --brand-color; ACCENT role
  headerColor     String? // hex, overrides --brand-header-color; header + admin sidebar background
  highlightColor  String? // hex, overrides --brand-highlight-color; hover/focus/active/selected feedback
  brandFont       String? // literal CSS font-family stack (not an abstract key), overrides --brand-font; curated choices offered in AdminSettingsBranding.jsx
  // The site logo -- see TripParticipantPhoto's own comment for why the
  // bytes live in their own one-to-one table (ChurchSettingsLogo, below)
  // rather than this row, still Postgres, no object store. Public, served
  // unauthenticated at GET /api/public/settings/logo/raw when set. API
  // responses synthesize a `logo: { url: "..." } | null` shape rather than
  // ever returning the bytes inline — same discipline as Photo.
  logoContentType String?
  logoRow         ChurchSettingsLogo?

  // GroupMe integration (see backend/src/utils/groupmeChannel.js). The user's
  // own personal access token, not a bot -- GroupMe Topics (a group chat
  // inside a group chat) are undocumented in the public API but real:
  // each topic is a "subgroup" with its own id (GET
  // /groups/:groupId/subgroups), and the ordinary messages endpoint
  // (POST /groups/:id/messages) posts into it when pointed at that id
  // instead of the parent group's. A bot can't reach any of that -- the
  // Bots API has no subgroup awareness at all -- so this has to be the
  // user's own token. Encrypted at rest via utils/crypto.js's
  // encryptField (the same AES-256-GCM helper User.mfaSecret uses
  // below). Every route that touches this row outside
  // routes/settings.js's dedicated /groupme sub-routes must omit it, so
  // it never rides along in the general settings payload any logged-in
  // role can read.
  groupmeAccessToken          String?
  // The parent group the admin picked, and its topics -- both selected
  // from live GroupMe API calls (GET /groups, GET /groups/:id/subgroups)
  // in the admin UI, never hand-typed, so the *Name fields are just a
  // cached label for display, not something this app invents.
  groupmeGroupId              String?
  groupmeGroupName            String?
  // Phase 1 mapped Prayer Requests only -- this is that later phase.
  // One-Time Needs and Newsletters each get their own groupme*TopicId/
  // Name pair, not a single generic "topic" field that would need
  // renaming once there's more than one dispatch content type.
  groupmePrayerTopicId        String?
  groupmePrayerTopicName      String?
  groupmeOneTimeNeedTopicId   String?
  groupmeOneTimeNeedTopicName String?
  groupmeNewsletterTopicId    String?
  groupmeNewsletterTopicName  String?

  // WhatsApp integration (see backend/src/utils/whatsappChannel.js and
  // whatsappClient.js). Unlike GroupMe there is no token to store: the
  // credential is a whole Baileys session (creds plus many Signal keys),
  // which lives in the WhatsAppAuthEntry table below, encrypted per row.
  // Nothing in this block is a secret -- they're display labels and the
  // ids picked from live lists in the admin UI (never hand-typed), same
  // as groupmeGroupName etc.
  //
  // One WhatsApp *community* containing several groups, mapped onto the
  // same three content types GroupMe maps onto Topics. Unlike an
  // earlier version of this comment claimed, there IS a fallback, same
  // idea as GroupMe's main-group fallback: every WhatsApp community has
  // a built-in Announcements group (Baileys flags it as
  // isCommunityAnnounce), auto-resolved and stored here the moment a
  // community is picked (see routes/settings.js's PUT /whatsapp and
  // whatsappClient.js's findAnnouncementGroup) -- never hand-picked,
  // since it's a structural property of the community, not a choice.
  // A type with no group of its own posts there instead; only with
  // neither set is it not sent (see whatsappChannel.js's
  // hasWhatsAppTarget/postToWhatsApp).
  whatsappPhoneNumber           String? // digits only, the dedicated number the app is paired as
  whatsappPairedAt              DateTime?
  // Connection-health tracking for the in-app notifications "WhatsApp
  // connection drop" category -- whatsappClient.js's own runtime.status/
  // lastError live only in memory and don't survive a worker restart, so
  // there was nothing queryable here before. Written whenever the worker's
  // connection genuinely fails (not on every transient reconnect blip --
  // see whatsappClient.js's own comment at the write site), cleared on the
  // next successful (re)connect. whatsappDisconnectedAt null means either
  // "never paired" or "currently connected" -- the category query
  // distinguishes those by also requiring whatsappPairedAt to be set.
  whatsappLastError             String?
  whatsappDisconnectedAt        DateTime?
  whatsappCommunityId           String?
  whatsappCommunityName         String?
  whatsappAnnouncementGroupId   String?
  whatsappAnnouncementGroupName String?
  whatsappPrayerGroupId         String?
  whatsappPrayerGroupName       String?
  whatsappOneTimeNeedGroupId    String?
  whatsappOneTimeNeedGroupName  String?
  whatsappNewsletterGroupId     String?
  whatsappNewsletterGroupName   String?

  // Joshua Project API key (see backend/src/utils/joshuaProject.js) --
  // country-level unreached-people-group stats shown on a partner's page,
  // admin-managed on its own settings page like every other optional
  // integration. Encrypted at rest the same way as groupmeAccessToken
  // above, for the same reason -- every route that touches this row
  // outside routes/settings.js's dedicated
  // /joshua-project sub-routes must omit it.
  joshuaProjectApiKey String?

  // Anthropic API key (see backend/src/utils/extraction.js) -- powers "AI
  // request scanning," admin-managed on its own settings page like every
  // other optional integration. Encrypted at rest the same way as
  // groupmeAccessToken/joshuaProjectApiKey above, for the same reason --
  // every route that touches this row outside routes/settings.js's
  // dedicated /ai-extraction sub-routes must omit it. This is real money
  // (pay-per-scan usage on the key owner's Anthropic account), so treat
  // "never leaks into a response" here as load-bearing, not a nice-to-have
  // -- see the dedicated leak-check tests in test/routes/aiExtraction.test.js.
  anthropicApiKey String?

  // Anthropic model id used for AI request scanning (see
  // backend/src/utils/extraction.js) -- null means "use the app's built-in
  // default," the same optional-override shape as every other per-church
  // setting that has a sensible built-in fallback. Free text, not an enum --
  // a self-hosting church may want a model id not on any curated list (see
  // issue #324), and the built-in default is a separate, deliberate
  // cost/quality decision tracked elsewhere, not something this field
  // changes. Not a secret -- plain text, no encryptField, unlike
  // anthropicApiKey above -- so it rides alongside that write-only key on
  // the same /ai-extraction settings sub-route instead of needing its own.
  extractionModel String?

  // Postmark server API token for outbound email (see
  // backend/src/utils/email.js) -- a transactional email provider, not
  // SMTP against the church's own Gmail/Microsoft mailbox (see #71: that
  // path has a real expiration date, Microsoft is turning off SMTP AUTH
  // basic auth for every Exchange Online tenant by end of 2026). Encrypted
  // at rest the same way as groupmeAccessToken/joshuaProjectApiKey/
  // anthropicApiKey above, for the same reason -- every route that
  // touches this row outside routes/settings.js's dedicated /email
  // sub-routes must omit it. emailFromAddress is the "From:" address
  // shown to recipients -- not a secret (same as groupmeGroupName etc.
  // above), so plain text, no encryptField.
  postmarkServerToken String?
  emailFromAddress    String?

  // Inbound email (see #72, backend/src/routes/inboundEmail.js) -- same
  // Postmark account as outbound above, its inbound webhook this time.
  // Postmark has no HMAC signature verification for inbound webhooks, so
  // the webhook URL carries HTTP Basic Auth instead; inboundEmailWebhookPassword
  // is checked against the Authorization header with a constant-time
  // compare. Encrypted the same way as postmarkServerToken above, for the
  // same reason -- every route outside routes/settings.js's dedicated
  // /inbound-email sub-routes (and the webhook handler's own auth check)
  // must omit it. inboundEmailWebhookUsername is not a secret on its own
  // (meaningless without the password), so plain text.
  inboundEmailWebhookUsername String?
  inboundEmailWebhookPassword String?

  // Per-church on/off switches for optional features -- keys are validated
  // against the registry in backend/src/utils/features.js (unknown keys
  // rejected), not modeled as their own columns, so adding a new gate-able
  // feature later is a one-line registry entry instead of a migration. A
  // missing key defaults to enabled -- see isFeatureEnabled in that same
  // file for the one exception (aiExtraction defaults to off).
  enabledFeatures Json @default("{}")

  // Deliberate, explicit opt-out of BackupReminder.jsx's periodic nudge --
  // distinct from that component's own dismiss-for-30-days (stored in
  // localStorage, per-browser, temporary). This is server-side and
  // permanent until an admin turns it back on, for a church that's
  // confirmed its database provider's own backups are actually working.
  // Default false: the reminder is on until someone deliberately says
  // otherwise, not silently opted out by a missing value.
  backupReminderDisabled Boolean @default(false)

  // #341: how long the audit trail (AuditLog) keeps events, in days -- 30, 60
  // or 90, pruned daily by the worker. Only the event history expires; the
  // "last edited by" columns on records are a current-state fact and never do.
  auditRetentionDays Int @default(90)

  // #385: require two-factor (TOTP) for every account, whatever its role. One church-wide
  // switch instead of separate rules per account type. Enforced at sign-in (an account that
  // hasn't enrolled is sent to enrolment and gets no session) and on every request (a session
  // opened before the switch was turned on stops working until they enrol), and nobody can
  // turn it off for themselves while it is on. Off by default: a church turns it on after
  // its admins have enrolled (the toggle refuses unless the person turning it on has).
  requireTwoFactor Boolean @default(false)

  // Schedule for the admin/public email dispatch's three cadence tiers --
  // biweekly/monthly/quarterly (weekly was retired along with the old
  // church-wide batch mechanism this replaced; see emailDispatchDelivery.js
  // and emailDispatchScheduler.js). Biweekly shares emailDispatchDayOfWeek
  // with nothing else now, kept the same field name rather than renaming
  // for a tier-set change alone; monthly and quarterly both read
  // emailDispatchDayOfMonth (capped at 1-28 specifically to dodge the
  // "the 31st doesn't exist in February" class of edge case), told
  // apart only by each tier's own minimum-gap check against its own
  // lastSentAt cursor below -- no separate "which cycle" state needed.
  // A separate cursor per tier, not one shared one, since the three
  // fire on different cycles and must each independently dedupe within
  // their own matching hour.
  emailDispatchDayOfWeek           Int? // 0 (Sun) - 6 (Sat) -- biweekly
  emailDispatchDayOfMonth          Int? // 1 - 28 -- monthly/quarterly
  emailDispatchHour                Int? // 0 - 23, in this church's configured timezone (see `timezone` below)
  lastBiweeklyEmailDispatchSentAt  DateTime?
  lastMonthlyEmailDispatchSentAt   DateTime?
  lastQuarterlyEmailDispatchSentAt DateTime?

  // GroupMe's own schedule -- a single daily batch hour, not a tier
  // pick. GroupMe never actually had an independent schedule before
  // this (it silently rode the old church-wide digest's now-retired
  // schedule) -- a weekly/monthly tier wouldn't fit a chat-style,
  // near-real-time channel anyway, which is also why this field says
  // "chat dispatch," not "digest" -- GroupMe/WhatsApp are real-time chat
  // posts, never batched. lastGroupmeChatDispatchSentAt is this
  // schedule's own dedupe guard, mirroring the email-dispatch cursors
  // above but at daily granularity -- no day-of-week/day-of-month field
  // needed, since there's no larger period to pick a day within. See
  // groupmeChannel.js's shouldFlushGroupMe.
  chatDispatchHour               Int? // 0 - 23, in this church's configured timezone
  lastGroupmeChatDispatchSentAt  DateTime?
  // WhatsApp shares chatDispatchHour above (and the three
  // chatDispatch* content-type mutes) -- one chat schedule, not two --
  // but keeps its own dedupe cursor. A shared cursor would let whichever
  // channel ran first on a tick stamp it and block the other from ever
  // sending that day.
  lastWhatsappChatDispatchSentAt DateTime?

  // This church's own IANA timezone (e.g. "America/New_York"), applied
  // to process.env.TZ once at server startup (see server.js) -- every
  // Hour-based schedule check above, plus birthdays/furlough elsewhere
  // in this app, depends on process.env.TZ actually matching the
  // church's real local time, which nothing set before this field
  // existed (Render's own default is UTC). Defaults to "America/Chicago"
  // rather than UTC -- every church this app has actually been built
  // for so far is US-based, so a brand-new deployment that never visits
  // this setting should already be close to correct, not off by several
  // hours until someone finds and changes it. Still just a starting
  // point: any church can pick its own real zone from this field's
  // `<select>`. Changing this takes effect on the next restart/deploy,
  // not instantly -- process.env.TZ is read once at boot, since changing
  // it mid-process is documented as unreliable.
  timezone String @default("America/Chicago")

  // Per-channel content-type mutes, chat channels only (GroupMe and
  // WhatsApp) -- the admin email dispatch always includes every content
  // type it's allowed to (no toggle), and the public email dispatch was
  // never toggle-based either (structurally prayer-requests-only
  // regardless). Chat channels are different: they're near-real-time,
  // where muting one content type while keeping others is a real,
  // worthwhile control. Default true (matches this app's long-standing
  // behavior: every content type dispatched unless muted).
  chatDispatchPrayerRequests     Boolean @default(true)
  chatDispatchOneTimeNeeds       Boolean @default(true)
  chatDispatchNewsletters        Boolean @default(true)
  // The one setting that applies to every channel equally (GroupMe,
  // WhatsApp, and both email dispatches), not just the chat channels --
  // a creation-time safety gate, not a delivery preference: off means a
  // restricted partner's event is never recorded at all, for any type,
  // because the review gate it would otherwise wait on (see
  // DispatchRecord.dispatchReviewedAt) waits on a human action that
  // might never come, and a church that doesn't actively watch that
  // review queue needs a way to opt out of the burden entirely rather
  // than accumulate an ever-growing unreviewed backlog. Defaults off --
  // this is a real safety gate (restricted-partner content waiting on
  // manual review, possibly indefinitely), not something a church
  // should be opted into without deciding to take it on.
  allowRestrictedPartnerDispatch Boolean @default(false)

  // #327 Finding 10 -- a restricted partner's masked display name is
  // initials of their real name (e.g. "J.R.") everywhere a restricted
  // partner can surface publicly: the public site, GroupMe/WhatsApp
  // dispatch messages, and email digests. For a small country, initials
  // plus country plus household shape can be enough to re-identify who
  // that is to someone who knows the local mission community. Default
  // true (today's long-standing behavior, unchanged unless a church
  // turns it off) -- turning it off falls back to the partner's own
  // fieldDisplayName (e.g. "Northern Uganda") if set, else a fixed
  // generic label. See utils/maskData.js's maskedDisplayName().
  restrictedPartnerInitialsEnabled Boolean @default(true)

  // #291: who key-date reminders go to for a partner with no care team (and,
  // with the care team feature on, who is "on the hook" until one is set).
  // Optional; SetNull so deleting the login just clears it. Set from
  // /api/care-team/default-lead, not the generic settings route.
  defaultCareLeadUserId String?
  defaultCareLead       User?   @relation("ChurchDefaultCareLead", fields: [defaultCareLeadUserId], references: [id], onDelete: SetNull)

  // Email dispatch customization (see #182) -- null subject/signature
  // means "use the built-in default" (see DEFAULT_SUBJECT_TEMPLATE in
  // emailDispatchShell.js), same blank-means-default convention every
  // other admin-text field in this app already follows. Shared config:
  // the same three settings drive both the admin and public email
  // dispatch now, not an admin-only concern.
  // emailDispatchSubjectTemplate supports {church}/{month}/{year}/{date}/
  // {cadence}/{name}/{term} tokens, substituted in emailDispatchShell.js
  // -- an admin writes plain text, not a real template language, so no
  // other token syntax (conditionals, loops) is ever needed or supported.
  emailDispatchSubjectTemplate String?
  // A short closing line (a verse, "Questions? Contact us", etc.) shown
  // near the email dispatch's footer, above the unsubscribe link.
  // Deliberately separate from publicTagline (the public-site subtitle)
  // -- this is email-specific and never shown anywhere else.
  emailDispatchSignature       String? @db.Text
  // Which layout to render -- "classic" (plain text-only partner cards,
  // the original design) or "snapshot" (adds each partner's
  // photo/silhouette, field, "Supporting since", and short overview above
  // their items -- see emailDispatchShell.js's partnerTileDetails()).
  // Null/unset means "classic", so every church's email dispatch looks
  // exactly the same as before this field existed until one opts in.
  emailDispatchLayout          String? // "classic" | "snapshot"

  // Admin-configurable availability of the three email-digest cadence
  // tiers themselves (#209) -- which tiers an admin (Account Settings)
  // and a public subscriber (the Subscribe page / "follow this partner"
  // form) are even offered, independent of emailDispatchDayOfWeek/
  // DayOfMonth above (whether a tier's schedule is actually set). Same
  // per-boolean-column pattern as the chatDispatch* content-type mutes
  // above, applied to tiers instead of content types. Biweekly defaults
  // off (the initial ask behind this field: drop biweekly from new
  // signups, default to monthly) while monthly/quarterly default on,
  // matching every subscriber's existing behavior before this field
  // existed. At least one tier must stay enabled -- settingsDispatches.js's
  // PUT rejects a request that would leave all three off, since the
  // migration logic below needs somewhere to send a descoped subscriber.
  cadenceBiweeklyEnabled  Boolean @default(false)
  cadenceMonthlyEnabled   Boolean @default(true)
  cadenceQuarterlyEnabled Boolean @default(true)

  // Trips (#252) -- church-level, not per-trip. A church's online giving
  // platform and how it's configured doesn't change trip-to-trip.
  onlineGivingUrl          String? // link to the church's own external online giving platform, if it has one
  onlineGivingInstructions String? @db.Text // which fund/category to pick, how to include the participant's name

  // Opt-in gate for TripContribution.donorEmail/donorPhone -- off by
  // default, since this is extra PII about a third party a church might
  // not want to collect at all. Purely a UI-surfacing switch, not a
  // schema gate -- the columns stay regardless of this toggle's state.
  collectDonorContactInfo Boolean @default(false)

  // Church-wide gate on whether the public application form asks a
  // trip applicant for their mailing address at all (TripApplication's
  // structured address columns, above) -- deliberately defaults to
  // `true`, unlike collectDonorContactInfo just above: a participant's
  // own mailing address is routine, expected trip-application content
  // (useful for support-letter mailings), not third-party PII a church
  // might be squeamish about collecting by default.
  collectApplicantAddress Boolean @default(true)

  // Church-wide gate on whether the public application form asks a trip
  // applicant for an emergency contact (TripApplication's structured
  // emergencyContactName/Phone/Email columns, above) -- defaults to
  // `true`, same reasoning as collectApplicantAddress: routine,
  // safety-relevant trip-application content, not optional third-party
  // PII a church would be squeamish about collecting by default.
  collectEmergencyContact Boolean @default(true)

  // Church-wide gate on the "Generate private application link" action
  // -- without this on, no Trip.applicationShareToken can ever be
  // created, and a privately-recruited trip is admin-entry-only.
  allowPrivateApplicationLinks   Boolean @default(false)
  // Church-wide gate on whether a TripParticipant.shareToken is ever
  // generated at all -- a church that wants team/meeting/document/
  // contribution management but no individual public-facing support-raising
  // pages leaves this off.
  allowPublicSupportRaisingLinks Boolean @default(false)

  // Church-wide gate on whether the Budget section (TripBudgetLine)
  // shows on AdminTripBudget.jsx at all -- defaults to `false`, matched
  // against allowPrivateApplicationLinks/allowPublicSupportRaisingLinks'
  // precedent (an opt-in admin planning capability a church either wants
  // or doesn't), not collectApplicantAddress/collectEmergencyContact's
  // precedent (routine public-application-form content, default on).
  enableTripBudgeting Boolean @default(false)

  // Not trip-specific at all -- the address partners were told (outside
  // this app) to send their newsletters/updates to, under whatever
  // inbound domain was configured in Postmark's own dashboard. Purely
  // informational/display, same as emailFromAddress being informational
  // about a domain verified entirely in Postmark's own UI -- gives
  // admins an in-app place to see/share the address partners already
  // send newsletters to.
  inboundEmailAddress String?

  // Church-wide base question set every trip's application form renders
  // first, before that trip's own applicationQuestions (Trip model, above).
  // Same shape as applicationQuestions -- see utils/applicationQuestions.js
  // for the one shared zod definition both this field and Trip's own use.
  // Configured once under Settings -> Mission Trips instead of
  // re-typed on every trip -- closes the "keep forks upgradable" gap a
  // hardcoded starter question set would otherwise create. See
  // publicTrips.js's shapeTripForApplicant for where the two layers get
  // combined into one ordered list.
  tripApplicationTemplate Json?

  // A church-owned, editable/deletable library of reusable question
  // snippets (same shape as tripApplicationTemplate/applicationQuestions)
  // an admin can quickly copy onto the global template or a specific
  // trip, instead of retyping a commonly-reused question every time.
  // Purely a picker source -- nothing here is itself "live" on any
  // application form until copied into one of those two places. Exists
  // for the case tripApplicationTemplate alone can't cover: a question
  // that's common but doesn't belong on *every* trip (e.g. a passport
  // question only international trips need, a swimming-ability question
  // only water-based ones need) -- tripApplicationTemplate is for
  // "every trip asks this, no exceptions," this is for "commonly
  // reused, picked per-trip as it actually applies."
  tripQuestionLibrary Json?

  // Church-wide requirement checklist every newly-created, actively-
  // recruiting trip gets automatically -- [{ id, label, kind, bodyText?,
  // reminderLeadDays? }]. Unlike tripApplicationTemplate above, this is
  // NOT live-layered at read time: TripRequirement is a real relational
  // model (fulfillment needs an actual foreign key to anti-join against,
  // which a live-merged JSON list can't provide), so this is instead
  // copied once into real TripRequirement rows at trip-creation time --
  // see POST /api/trips' own comment for exactly which fields copy
  // (mirroring the existing clone-a-trip route's label/kind/
  // reminderLeadDays/bodyText copy, never dueAt). A deliberate
  // consequence: editing this template later only affects trips created
  // afterward, never retroactively changes an already-created trip's own
  // copy -- protects an already-signed TripDocument's documentTextSnapshot
  // from ever silently drifting out from under it.
  tripRequirementTemplate Json?

  // A church-owned, editable/deletable library of reusable requirement
  // templates (same shape as tripRequirementTemplate above), picked
  // per-trip onto a *specific* trip's own requirements at any time --
  // not auto-copied onto every trip the way tripRequirementTemplate is.
  // Exists for the exact case tripRequirementTemplate alone can't cover:
  // a requirement that's common but doesn't belong on every trip (e.g.
  // a minor travel release form, only needed on a trip that actually
  // has minors on it) -- tripRequirementTemplate is "every trip needs
  // this, no exceptions," this is "commonly reused, added per-trip as
  // it actually applies." Same reasoning as tripQuestionLibrary's own
  // schema comment, one tier over.
  tripRequirementLibrary Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?
}

model ChurchSettingsLogo {
  id        String         @id
  settings  ChurchSettings @relation(fields: [id], references: [id], onDelete: Cascade)
  logoBytes Bytes
}

// Users who can log into the admin backend.
//
// authProvider is always "local" (email + password, optionally with TOTP
// two-factor). It used to also carry an SSO provider's type; SSO was removed
// in 3.1.0 because auto-provisioning handed an account to anyone at the
// configured identity provider, and in this app any account can read every
// partner's full record. The column stays so routes/auth.js can keep
// refusing to password-authenticate anything that isn't "local" -- cheap
// insurance if a passwordless row is ever created some other way.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  // #257/#271 Finding 4: split first/last.
  firstName    String?
  lastName     String?
  passwordHash String? // nullable only for historical rows; every account created now is local
  authProvider String    @default("local")
  role         String    @default("editor") // "admin" | "editor" | "viewer" | "guest"
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  // #327 Finding 7: a logged-out-still-valid session token, stolen before
  // (or during) a password/MFA change, kept working for the rest of its
  // 8-hour lifespan regardless -- logout only ever cleared the cookie,
  // never the token itself, and nothing about changing the password or
  // MFA touched any *other* session already issued. Embedded in the
  // session JWT at sign time (utils/jwt.js) and compared against this
  // column on every request (middleware/requireAuth.js) -- a mismatch
  // means the token predates a change that should have ended it.
  // Incremented on self-service password change, an admin-set password
  // reset, MFA enable/disable (self-service or admin-forced), and a role
  // change -- deliberately NOT on logout itself, which stays scoped to
  // just the one cookie/browser it actually represents (a user signed in
  // on two devices who logs out of one shouldn't be silently signed out
  // of the other).
  sessionVersion Int @default(0)

  // Guest tier only (role: "guest") -- a real login/session account, not a
  // reduction of any existing role's visibility (see the "auth is the
  // boundary" model below: every other role still sees everything). A
  // deliberately narrow tier instead: reach comes only from grant rows
  // (TripAccess today; #289 adds care team seats), never from the role
  // itself, so a guest with no active grant can do nothing and
  // requireAuth refuses the session outright. Replaces the old single
  // scopedTripId/expiresAt pair (#356).
  tripAccess TripAccess[]

  // TOTP MFA — opt-in per user, self-service enroll/disable from Account
  // Settings; mfaSecret is only ever set once mfaEnabled flow starts, and
  // is cleared whenever MFA is turned off (self-service or admin reset).
  // Encrypted at rest (see backend/src/utils/crypto.js) — TOTP verification
  // needs the raw secret back, so this can't be a one-way hash like a
  // password.
  mfaEnabled       Boolean @default(false)
  mfaSecret        String?
  // The last TOTP time step accepted for this user, so the same code can't
  // be used twice. A TOTP code stays valid for its whole 30-second window,
  // which means one shoulder-surfed or phished code is replayable until it
  // expires; otplib rejects a repeat when the accepted step is passed back
  // as `afterTimeStep`. Null until their first successful code.
  mfaLastTimeStep  Int?
  // Admin-set per-user policy flag: forces enrollment at next login when
  // true and mfaEnabled is still false. Independent of mfaEnabled so an
  // admin can mandate MFA for an account without knowing/setting the
  // secret themselves — the user still does the actual QR scan.
  mfaSetupRequired Boolean @default(false)

  // Opt-in per user, self-service from Account Settings -- same pattern
  // as MFA above. null = not subscribed to the admin digest email (see
  // emailDispatchDelivery.js); a value is which of the three cadence
  // tiers this user picked. Renamed from digestFrequency -- matches the
  // word this app's own docs/plan already use everywhere in prose, and
  // no longer collides in meaning with ChurchSettings' own, unrelated
  // digestFrequency (the old church-wide batch mechanism's field,
  // retired). One nullable field for "subscribed at all" and "to what
  // cadence" together, same convention as DispatchRecord.dispatchReviewedAt,
  // not two fields that could disagree. Flipped to null directly by the
  // signed unsubscribe link in every digest email's footer, no login
  // required (see this file's own /unsubscribe route).
  cadence           String? // "biweekly" | "monthly" | "quarterly" | null
  // Scope for this user's own digest, independent of the schedule
  // above -- mirrors PublicSubscriber's identical shape.
  // false means only the partners in followedPartners below; true (the
  // default, matching every existing subscriber's current behavior)
  // means every partner this user's role can already see.
  allPartners       Boolean               @default(true)
  followedPartners  UserFollowedPartner[]
  careTeamSeats     CareTeamMember[]
  contactsMade      ContactLog[]          @relation("ContactLogContactedBy")
  contactsEntered   ContactLog[]          @relation("ContactLogCreatedBy")
  keyDateReminders  KeyDateReminder[]
  defaultLeadFor    ChurchSettings[]      @relation("ChurchDefaultCareLead")
  notificationsSeen NotificationSeen[]
  savedReports      SavedReport[]

  // Welcome-email / first-time password setup links (see
  // utils/passwordSetup.js). A pending account has passwordHash null until
  // one of these is redeemed.
  passwordSetupTokens PasswordSetupToken[]

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?
}

// Single-use link that lets a new user choose their own password. Only a
// SHA-256 hash of the random token is stored, never the token itself, so a
// database leak can't be replayed. Issuing a new link deletes the user's
// older unused ones (utils/passwordSetup.js), so at most one is live.
model PasswordSetupToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// #356: a guest login's access to one trip. Effective access = the
// guest role's (empty) baseline plus whatever grants exist, so this row
// IS the permission. Grants never allow deletes, profile edits or
// settings -- that limit lives in the routes' requireRole lists, not
// here.
//
// Expiry is derived at check time (utils/guestAccess.js), not stored:
// when expiresAt is null the grant lapses 30 days after Trip.endDate, so
// changing the trip's dates moves the expiry with it; a trip with no end
// date never lapses on its own. expiresAt is only an admin override
// ("extend" or "end now"), and it wins over the derived date either way.
model TripAccess {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, tripId])
  @@index([tripId])
}

// Per-user, per-category "last looked at this" marker for the in-app
// notification bell -- not one shared timestamp, because clearing one
// person's "new" highlight must never clear it for a teammate who hasn't
// looked yet (see notifications/categories.js's own header comment for the
// full reasoning). The *count* a category shows is always a live query
// against real data, shared by everyone; only the "new since you looked"
// emphasis is personal, which is all this table tracks.
model NotificationSeen {
  userId   String
  category String
  seenAt   DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
}

// Join rows for a user's specific-partner digest scope (#202) -- only
// populated when User.allPartners is false. Identical shape to
// PublicSubscriberPartner below, intentionally -- same mechanism, two
// different subscriber sources.
model UserFollowedPartner {
  userId    String
  partnerId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([userId, partnerId])
  @@index([partnerId])
}

// #289: a login's seat on one partner's care team -- the people at the
// church who keep in touch with that partner. Any number of members, at
// most ONE lead per partner (enforced in routes/careTeams.js inside a
// transaction, and by the partial unique index added to the migration by
// hand, which Prisma's schema language can't express). Everyone on a care
// team gets the same notifications (later steps); being on one adds a
// marker and an "Assigned to me" view, never extra visibility for a full
// role. For a guest login a seat IS a grant: it reaches that partner (the
// same way TripAccess reaches a trip's), and unlike a trip grant it never
// expires -- an admin removes the member when they step down. Every member
// must have a login (a guest if they're outside the team); there are no
// account-less members. Gated by the `careTeam` feature; off = hidden and
// ignored for access, data preserved.
model CareTeamMember {
  id        String   @id @default(uuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@unique([partnerId, userId])
  @@index([userId])
}

// A public, no-login email subscription to prayer-request updates.
// Rides the exact same DispatchRecord rows an admin subscriber does,
// through the one shared isEligibleForChannel function
// (dispatchEligibility.js) -- structurally prayer-requests-only,
// never a one-time need, never a newsletter or a link back to one; see
// emailDispatchDelivery.js for the shared send-pass both subscriber types
// go through, and emailDispatchShell.js for the shared render shell.
//
// Double opt-in: confirmedAt null means "never confirmed, never sent
// to." A row is created unconfirmed on POST /api/public/subscribe and
// only starts receiving digests once the emailed confirmation link is
// clicked.
model PublicSubscriber {
  id          String    @id @default(uuid())
  email       String    @unique
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  // Which of the three cadence tiers this subscriber picked -- same
  // three options User.cadence above already uses. Renamed from
  // frequency to match -- see that field's own comment for why.
  // Defaults to "biweekly," the nearest tier now that weekly is gone.
  cadence String @default("biweekly") // "biweekly" | "monthly" | "quarterly"

  // Same all-vs-specific shape as User.allPartners above.
  allPartners    Boolean                   @default(true)
  scopedPartners PublicSubscriberPartner[]

  @@index([confirmedAt])
}

// Join rows for a public subscriber's specific-partner scope -- only
// populated when PublicSubscriber.allPartners is false. See
// UserFollowedPartner's own comment above for why this is a separate,
// identically-shaped table rather than one polymorphic one.
model PublicSubscriberPartner {
  subscriberId String
  partnerId    String
  subscriber   PublicSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  partner      Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([subscriberId, partnerId])
  @@index([partnerId])
}

// The WhatsApp (Baileys) session, one row per auth-state key: "creds"
// plus a row per Signal key ("pre-key-12", "session-<jid>", ...). Lives in
// the database, not on disk, because Render's web-service filesystem is
// ephemeral -- a file-based session would be wiped on every deploy and
// force a re-pair. `value` is always an encryptField() ciphertext (the
// serialized JSON never touches the table in plaintext), so losing
// FIELD_ENCRYPTION_KEY means re-pairing, exactly like losing the GroupMe
// token. Never selected into any API response -- see whatsappAuthState.js.
model WhatsAppAuthEntry {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
