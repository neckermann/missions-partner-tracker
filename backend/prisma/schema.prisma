  // birthday | childBirthday | anniversary | supportingSince
  kind           String
  subjectId      String   @default("")
  occurrenceDate DateTime @db.Date
  sentAt         DateTime @default(now())

  @@unique([userId, partnerId, kind, subjectId, occurrenceDate])
  @@index([partnerId])
}

