// Prisma schema for the Missions Team Missionary Tracker

generator client {
  provider = "prisma-client-js"
}

// The connection URL is in prisma.config.js (Prisma 7), not here.
datasource db {
  provider = "postgresql"
}

// A partner this church supports: an individual/family missionary or a local/national
// organization, distinguished by `kind`.
// Kind-specific data lives in nullable columns and optional relations. Nothing in the DB stops
// an organization from having missionary-only children; application code never creates them.
model Partner {
  id   String @id @default(uuid())
  kind String // "missionary" | "organization"

  isPublic     Boolean @default(false) // show on public site at all
  isRestricted Boolean @default(false) // if public + restricted -> masked/generic view only

  // Archiving is the soft delete: hides the record from admin lists, forces isPublic off and
  // zeroes monthly support (via a new SupportEntry). DELETE is only allowed once archived.
  archived   Boolean   @default(false)
  archivedAt DateTime?

  displayName      String
  fieldDisplayName String? // e.g. "Northern Uganda" - safe to show even if restricted
  fipsCountryCode  String?

  overview        String?   @db.Text
  overviewShort   String?
  focusArea       String?   @db.Text
  supportingSince DateTime? @db.Date // year-only values are stored as Jan 1 of that year

  // When the whole congregation last prayed for this partner together (a manual record).
  // Separate from PrayerRequest.status and from any dispatch timestamp. A calendar date, not
  // an instant: see frontend/src/utils/format.js on local-date handling.
  lastPrayedWithCongregationAt DateTime? @db.Date

  // How careful to be when reaching this partner (missionary-only; an organization is always "normal"):
  //   "normal"    -- reach them as usual;
  //   "caution"   -- reachable, but follow contactInstructions (and only the ticked contactChannels, when any);
  //   "no_direct" -- don't contact them directly: the Contact card hides their number and email and
  //                  shows contactVia* and contactInstructions instead.
  contactLevel           String   @default("normal")
  // "caution" only: the ways it is ok to reach them ("call", "text", "email", "whatsapp",
  // "signal", "messenger", "other"). Empty means any.
  contactChannels        String[] @default([])
  // Shown for "caution" and "no_direct". Free text, staff-facing.
  contactInstructions    String?  @db.Text
  // "no_direct" only: the person to go through instead.
  contactViaName         String?
  contactViaRole         String?
  contactViaPhone        String?
  contactViaEmail        String?
  // Missionary-only: this church is the sending church. Distinct from SendingParty, which
  // describes whichever church sends them.
  sentByOurChurch        Boolean @default(false)
  // Organization-only: the person to reach at the organization (a missionary is their own
  // contact, so null for that kind).
  contactFirstName       String?
  contactLastName        String?
  contactPhone           String?
  contactEmail           String?
  // Organization-only: how that person likes to be reached (see Adult.contactMethod for a family).
  contactMethod          String?
  contactMethodNote      String?

  orgType               String? // organization-only: "Local" | "National"
  anniversary           DateTime? @db.Date // missionary-only
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactEmail String?

  tripTeamSizeMin    Int?
  tripTeamSizeMax    Int?
  tripSeasonNotes    String? @db.Text
  tripLogisticsNotes String? @db.Text

  // Each collection is its own resource with per-row create/update/delete. Never write one as
  // a nested array on a Partner update: that deletes and recreates every child row, churning
  // ids and destroying rows added through the collection's own endpoint meanwhile.
  // adults/children/furloughs are missionary-only.
  trips                    Trip[]
  churchVisits             ChurchVisit[]
  supportEntries           SupportEntry[]
  needRequests             SupportNeed[]
  prayerRequests           PrayerRequest[]
  files                    PartnerFile[]
  // Full upload history; the current photo is the one with the latest receivedDate.
  photos                   Photo[]
  dispatchRecords          DispatchRecord[]
  followedByUsers          UserFollowedPartner[]
  careTeam                 CareTeamMember[]
  contactLogs              ContactLog[]
  supportPreferences       PartnerSupportPreference[]
  keyDateReminders         KeyDateReminder[]
  publicSubscriberPartners PublicSubscriberPartner[]
  adults                   Adult[]
  children                 Child[]
  furloughs                Furlough[]
  // `type` is a plain string, not an enum, so a fork can add a platform without a migration.
  links                    PartnerLink[]
  languages                PartnerLanguage[]
  tripTypes                TripType[]

  // addresses/sendingParties are the exception to per-row CRUD: at most one row per type per
  // partner (@@unique), wholesale-replaced on Partner's PUT.
  addresses      Address[]
  sendingParties SendingParty[]

  // Audit columns are kept on Partner only, populated on every create/update.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  // Current-state "last changed by", overwritten in place (unlike the AuditLog history).
  // Stamped by the Prisma client extension in prismaClient.js from the signed-in user;
  // background jobs, the seed and public submissions leave it alone. The name is a snapshot so
  // it survives account deletion.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([kind])
  @@index([isPublic, isRestricted])
  @@index([archived])
}

model Adult {
  id               String    @id @default(uuid())
  partnerId        String
  partner          Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  // Nullable in the DB only; routes/partners.js's zod schema requires it on every write.
  firstName        String?
  lastName         String?
  phone1           String?
  phone2           String?
  email            String?
  birthday         DateTime? @db.Date
  // The adult to reach first. At most one per partner: a partial unique index in the migration
  // (Prisma can't express a WHERE on a unique) and the route, which clears the old one.
  isPrimaryContact Boolean   @default(false)
  // How this person likes to be reached: "call", "text", "email", "whatsapp", "signal",
  // "messenger" or "other" (with contactMethodNote saying how). Shown on the Contact card.
  contactMethod     String?
  contactMethodNote String?
  createdAt        DateTime  @default(now())

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
}

model Child {
  id        String    @id @default(uuid())
  partnerId String
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  firstName String?
  lastName  String?
  birthday  DateTime? @db.Date
  createdAt DateTime  @default(now())

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
}

// At most one address per type. "physical" is the serving location (a full street address or
// just city/country, depending on what is safe to record) and the source of the public map pin
// (gpsLat/gpsLng); "mailing" is the US-side mail address, with no coordinates.
model Address {
  id                  String   @id @default(uuid())
  partnerId           String
  partner             Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type                String // "physical" | "mailing"
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?
  gpsLat              Float?
  gpsLng              Float?
  receiveMail         Boolean?
  receivePackages     Boolean?

  createdAt DateTime @default(now())
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@unique([partnerId, type])
}

// A trip to visit a partner across its whole lifecycle via `status` (a backfilled trip is
// created already "completed"; a recruiting one starts "planning"). Not a capacity profile: that
// is Partner.tripTypes etc., which pre-fill this trip at creation.
model Trip {
  id        String   @id @default(uuid())
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // e.g. "Summer 2026 Guatemala Build Team"; optional.
  name String?

  // "planning" | "accepting_applications" | "closed" | "completed". Defaults to "completed"
  // because the common case is backfilling a past trip; the new-trip form sets "planning".
  status String @default("completed")

  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  type        String? // e.g. "Construction", "Medical/Dental" — preset or custom
  description String?   @db.Text // what the team did/will do -- doubles as the public trip overview when isPublic is on
  notes       String?   @db.Text // admin-only

  teamSizeMin        Int?
  teamSizeMax        Int?
  supportRaisingGoal Int? // whole-dollar team total, matching SupportEntry.amount's existing Int convention

  // Gates this trip's discovery-page listing and whether its id-addressed public application
  // route accepts submissions (publicTrips.js, tripEligibility.js). Does not gate a
  // participant's own support-raising page, which stays reachable via shareToken.
  isPublic Boolean @default(false)

  // Null until staff explicitly generate a private application link for
  // this trip -- a dedicated secret, same shape as
  // Secret for a private application link; null until staff generate one (only when
  // ChurchSettings.allowPrivateApplicationLinks is on). Deliberately not the row id, which
  // every logged-in user can see. Regenerating invalidates the old link.
  applicationShareToken String? @unique

  // Questions asked on this trip's application after the church-wide ones.
  applicationQuestions ApplicationQuestion[]

  // External album link only, never in-app file storage (#130). albumProvider is validated in
  // trips.js, not a DB enum.
  albumProvider String? // "google_photos" | "icloud" | "other"
  albumUrl      String?

  participants   TripParticipant[]
  applications   TripApplication[]
  meetings       TripMeeting[]
  documents      TripDocument[]
  requirements   TripRequirement[]
  contributions  TripContribution[]
  budgetLines    TripBudgetLine[]
  flightSegments TripFlightSegment[]
  tripAccess     TripAccess[]

  // What the team learned on the way home: one plain-text answer per prompt of the Wrap up
  // trip wizard, all optional. wrappedUpAt is set when the wizard completes the trip (null for
  // a trip finished any other way).
  debriefWhatWeDid    String?   @db.Text
  debriefWentWell     String?   @db.Text
  debriefWasHard      String?   @db.Text
  debriefPartnerNeeds String?   @db.Text
  wrappedUpAt         DateTime?

  createdAt        DateTime  @default(now())
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
  @@index([status])
}

// One row serves both purposes: a freeform backfilled/admin-added entry
// (applicationId: null, no support-raising fields populated) and a team
// member who came through an approved application.
model TripParticipant {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // Distinguishes meetings/requirements that existed when this participant joined (already
  // caught up via sendLateJoinerCatchUpEmails) from later ones, so catch-up is not re-sent.
  createdAt DateTime @default(now())

  firstName String?
  lastName  String?

  role  String? // e.g. "Medical", "Construction", "Translator"
  phone String?
  email String?

  // Null for a backfilled or directly-admin-added participant; set when
  // created via application approval.
  applicationId String?          @unique
  application   TripApplication? @relation(fields: [applicationId], references: [id])

  supportRaisingGoal Int? // null/unused for a historical-only row

  // Mailing address, copied from the TripApplication on approval. Collected only when
  // ChurchSettings.collectApplicantAddress is on; otherwise null.
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?

  // Copied from the TripApplication on approval. Collected only when
  // ChurchSettings.collectEmergencyContact is on.
  emergencyContactFirstName String?
  emergencyContactLastName  String?
  emergencyContactPhone     String?
  emergencyContactEmail     String?

  // Always required on the public application. A real date column so isMinorForTrip
  // (utils/tripParticipantSchema.js) can compare it with the trip's startDate. parentGuardian*
  // are required only when that returns true. Copied from the TripApplication on approval.
  dateOfBirth                DateTime? @db.Date
  parentGuardianFirstName    String?
  parentGuardianLastName     String?
  parentGuardianRelationship String?
  parentGuardianPhone        String?
  parentGuardianEmail        String?

  // Secret for this participant's public support-raising URL: the page's access control,
  // deliberately not the row id. Not generated at creation; see
  // ChurchSettings.allowPublicSupportRaisingLinks.
  shareToken String? @unique
  story      String? @db.Text // what shows on their public support-raising page

  // One current portrait, replaced wholesale on change. The bytes live in TripParticipantPhoto
  // so a plain TripParticipant query can never pull the image into an unrelated JSON response
  // (#274).
  photoContentType String?
  photoBytesRow    TripParticipantPhoto?

  // Bump to invalidate every previously issued self-service link at once.
  // protection, applied to a link instead of a TOTP code.
  accessTokenVersion Int @default(0) // tripFieldVisibility: intentionally admin-invisible -- internal revocation counter, bumped by the resend/regenerate actions

  documents           TripDocument[]
  contributions       TripContribution[]
  requirementStatuses TripRequirementStatus[]
  // Segments this participant is specifically called out on. Empty does not mean not flying:
  // segments with nobody selected apply to everyone.
  flightSegments      TripFlightSegment[]
  meetingRsvps        TripMeetingRsvp[]

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([tripId])
}

// Split off from TripParticipant so plain queries never load the image. Shares its primary key
// with the parent (one-to-one).
model TripParticipantPhoto {
  id          String          @id
  participant TripParticipant @relation(fields: [id], references: [id], onDelete: Cascade)
  photo       Bytes
}

// A submitted application to a trip accepting applications. Answers are TripApplicationAnswer
// rows that keep the question's wording as asked.
model TripApplication {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String
  phone     String?

  status  String                  @default("pending") // "pending" | "approved" | "declined" | "withdrawn" -- tripFieldVisibility: intentionally admin-invisible (every application reachable from a participant is "approved")
  answers TripApplicationAnswer[]

  // Same as TripParticipant's address fields; null unless
  // ChurchSettings.collectApplicantAddress is on.
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?

  // Same as TripParticipant; null unless ChurchSettings.collectEmergencyContact is on.
  emergencyContactFirstName String?
  emergencyContactLastName  String?
  emergencyContactPhone     String?
  emergencyContactEmail     String?

  // See TripParticipant.dateOfBirth.
  dateOfBirth                DateTime? @db.Date
  parentGuardianFirstName    String?
  parentGuardianLastName     String?
  parentGuardianRelationship String?
  parentGuardianPhone        String?
  parentGuardianEmail        String?

  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  // Admin-only, never shown to the applicant. Set only when declining; declined rows are kept
  // (see trips.js's review route).
  declinedReason String?   @db.Text // tripFieldVisibility: intentionally admin-invisible -- only set on a decline, already shown in the review list

  participant TripParticipant?

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([tripId])
}

// A scheduled prep meeting. location and meetingLink are independent (a hybrid meeting sets
// both); invites and reminders show whichever are set.
model TripMeeting {
  id             String    @id @default(uuid())
  tripId         String
  trip           Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  startAt        DateTime
  // Short name used as the email subject and calendar title; blank falls back to the default
  // (sendMeetingEmail, buildMeetingIcs).
  title          String?
  location       String?
  meetingLink    String?
  agenda         String?   @db.Text
  // Stamped once the day-before reminder is sent, so it is not sent twice.
  reminderSentAt DateTime?
  // Soft cancel: a meeting already sent as a calendar invite needs a cancellation notice.
  // DELETE is only for a meeting that was never announced.
  cancelledAt    DateTime?

  rsvps TripMeetingRsvp[]

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([tripId])
}

// One row per (meeting, participant). Link-based RSVP (#267): the participant clicks a
// token-verified link in their email, no login. Upserted on (meetingId, participantId), so a
// later click overwrites the earlier response.
model TripMeetingRsvp {
  id            String          @id @default(uuid())
  meetingId     String
  meeting       TripMeeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participantId String
  participant   TripParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  // "yes" | "no" | "maybe"
  response      String
  respondedAt   DateTime

  @@unique([meetingId, participantId])
  @@index([participantId])
}

// An admin-defined, ordered checklist of what a trip needs from each participant: a document, an
// e-signature or a plain task. dueAt and reminderLeadDays are optional. A real child model (not
// JSON) because TripDocument.requirementId needs a foreign key for the fulfillment anti-join.
model TripRequirement {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  label     String

  // "document" (fulfilled by an upload) | "task" (an admin checks it off for a participant) |
  // "esignature" (the participant signs bodyText; generates a TripDocument carrying the
  // signature audit fields).
  kind String @default("document")

  // The text an "esignature" requirement asks a participant to sign; null for other kinds.
  bodyText String? @db.Text

  // Both optional and independent of `kind`. reminderLeadDays is how many days before dueAt
  // tripReminderScheduler.js reminds each unfulfilled participant (never after dueAt); null
  // means no reminder.
  dueAt            DateTime? @db.Date
  reminderLeadDays Int?

  // Limits this requirement to minor participants (isMinorForTrip in
  // utils/tripParticipantSchema.js), checked wherever it is shown or reminded, not by
  // withholding TripRequirementStatus rows, which are created lazily.
  minorsOnly Boolean @default(false)

  documents           TripDocument[]
  requirementStatuses TripRequirementStatus[]

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([tripId])
}

// Per-participant state for a TripRequirement, created lazily (only once a field needs a value).
// completedAt is written only for "task" kind: document/esignature fulfillment is a computed
// anti-join against TripDocument, never cached here, so it cannot go stale. reminderSentAt
// applies to every kind and prevents a double send.
model TripRequirementStatus {
  id            String          @id @default(uuid())
  requirementId String
  requirement   TripRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  participantId String
  participant   TripParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  completedAt    DateTime?
  reminderSentAt DateTime?

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@unique([requirementId, participantId])
  @@index([participantId])
}

// Same in-row bytes storage as PartnerFile. participantId null = a trip-wide shared document;
// set = that participant's own. requirementId, when set, points at a "document" or "esignature"
// requirement.
model TripDocument {
  id            String           @id @default(uuid())
  tripId        String
  trip          Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  participantId String?
  participant   TripParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   TripRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  title       String?
  // bytes and signatureImage live in TripDocumentBytes.
  fileName    String
  contentType String
  fileSize    Int? // bytes; null on older rows

  createdAt DateTime @default(now())

  // Signature audit fields: null for an ordinary upload, set only when this row is the
  // generated PDF of a signed "esignature" requirement.
  signerName           String? // always captured, whether they typed or drew
  // "self" | "parent/guardian". Recordkeeping only: signer identity is never verified.
  signerRelationship   String?
  attestedAt           DateTime?
  ip                   String?
  // Snapshot of the exact text agreed to plus a server-computed hash, so a later edit to the
  // requirement's bodyText is never attributed to an old signature.
  documentTextSnapshot String?            @db.Text
  documentTextHash     String?
  bytesRow             TripDocumentBytes?

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@unique([requirementId, participantId])
  @@index([tripId])
  @@index([participantId])
}

model TripDocumentBytes {
  id             String       @id
  document       TripDocument @relation(fields: [id], references: [id], onDelete: Cascade)
  bytes          Bytes
  signatureImage Bytes? // drawn-signature PNG; null if they only typed their name
}

// A manual ledger entry for an offline gift (check/cash) toward a trip or participant. Payment
// processing is out of scope. donorEmail/donorPhone are shown only when
// ChurchSettings.collectDonorContactInfo is on.
model TripContribution {
  id            String           @id @default(uuid())
  tripId        String
  trip          Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  participantId String?
  participant   TripParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  donorName    String
  donorEmail   String?
  donorPhone   String?
  amount       Int // whole dollars, matching SupportEntry.amount
  method       String // "check" | "cash" | "online" | "other"
  reference    String?
  receivedDate DateTime @db.Date

  createdAt DateTime @default(now())

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([tripId])
  @@index([participantId])
}

// A planned-expense line item, trip-wide, estimate only (no actualAmount: real expenses are
// reconciled in the church's accounting). Gated by ChurchSettings.enableTripBudgeting;
// Trip.supportRaisingGoal is independent of its total.
model TripBudgetLine {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  label           String
  estimatedAmount Int

  createdAt DateTime @default(now())
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([tripId])
}

// One flight segment. No participants means the segment applies to the whole team; otherwise
// just that subset. The self-service page filters on this; the admin view shows every segment.
model TripFlightSegment {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  airline          String?
  flightNumber     String?
  departureAirport String?
  departureAt      DateTime?
  arrivalAirport   String?
  arrivalAt        DateTime?

  participants TripParticipant[]

  createdAt DateTime @default(now())
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([tripId])
}

// A period a missionary is off the field in their home country. Missionary-only. endDate null
// means ongoing.
model Furlough {
  id        String    @id @default(uuid())
  partnerId String
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  notes     String?   @db.Text
  createdAt DateTime  @default(now())

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
}

// A visit a partner made to this church (the reverse of Trip). "Last visit" is the latest
// visitDate.
model ChurchVisit {
  id        String   @id @default(uuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  visitDate DateTime @db.Date
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
}

// One touchpoint with a partner (call, text, visit, card). Internal only: never on a public page
// or dispatch channel. Fixed-choice fields are validated Strings (SPEC §3); allowed values live
// in utils/contactLog.js.
model ContactLog {
  id              String    @id @default(uuid())
  partnerId       String
  partner         Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  // call | text | email | visit | card | video | prayed | other
  contactType     String
  // outbound (we reached out) | inbound (they reached out)
  direction       String
  // Optional topic chips (utils/contactLog.js), e.g. "prayer", "need".
  topics          String[]
  // Who made the contact. SetNull so a deleted login keeps the history.
  contactedById   String?
  contactedBy     User?     @relation("ContactLogContactedBy", fields: [contactedById], references: [id], onDelete: SetNull)
  // Who typed it in (differs from contactedBy when logging for a teammate).
  createdById     String?
  createdBy       User?     @relation("ContactLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // A calendar date, like ChurchVisit.visitDate -- not an instant.
  contactDate     DateTime  @db.Date
  notes           String?   @db.Text
  // Optional "reach out again by"; not a task system.
  followUpDate    DateTime? @db.Date
  // Plain ids with no FK on purpose: deleting the prayer request or need must not delete the
  // history.
  prayerRequestId String?
  supportNeedId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId, contactDate])
  @@index([contactedById])
  @@index([followUpDate])
}

// The admin activity trail: one row per sensitive event. Actor and target are ids plus an
// email/name snapshot, not foreign keys, so history survives account deletion. Retention-bounded
// (ChurchSettings.auditRetentionDays), gated by the auditTrail feature. Never stores a secret's
// value. `action` is a code from utils/auditLog.js's AUDIT_ACTIONS.
model AuditLog {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  action       String
  // Who did it (null for an unauthenticated event, e.g. a failed sign-in).
  actorUserId  String?
  actorEmail   String?
  actorName    String?
  targetUserId String?
  targetEmail  String?
  targetName   String?
  // The record it was about when not an account, with its label at the time.
  entityType   String?
  entityId     String?
  entityLabel  String?
  ip           String?
  // Old/new values and context; secrets are noted as changed, never stored. JSON on purpose:
  // the shape differs per event and it is only displayed; everything filtered on is a real
  // column.
  details      Json?

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

// A key-date reminder already emailed to one person, so the daily job never sends the same
// occurrence twice. Keyed by the occurrence's own date (a corrected date re-arms it). subjectId
// is "" for a partner-level date because NULLs are distinct in a Postgres unique key.
model KeyDateReminder {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerId      String
  partner        Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  // birthday | childBirthday | anniversary | supportingSince
  kind           String
  subjectId      String   @default("")
  occurrenceDate DateTime @db.Date
  sentAt         DateTime @default(now())

  @@unique([userId, partnerId, kind, subjectId, occurrenceDate])
  @@index([partnerId])
}

// A link about this partner (website, support page, newsletter signup, social profile). `type`
// is a validated string (routes/partnerLinks.js), not an enum, so a fork can add one without a
// migration. @@unique allows one link per type.
model PartnerLink {
  id        String   @id @default(uuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type      String
  url       String
  createdAt DateTime @default(now())

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@unique([partnerId, type])
}

// A language this partner speaks, with optional proficiency on the ILR scale ("0".."5" with "+"
// half-steps), a plain string like PartnerLink.type.
model PartnerLanguage {
  id          String   @id @default(uuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  language    String
  proficiency String?
  createdAt   DateTime @default(now())

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
}

// A trip type this partner can host. No @@unique: duplicates are harmless.
model TripType {
  id        String   @id @default(uuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type      String // e.g. "Construction", "Medical/Dental" -- preset or custom
  createdAt DateTime @default(now())

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
}

// Who sent this missionary: their sending church and/or organization, at most one of each per
// partner (`type`). Missionary-only.
model SendingParty {
  id                  String  @id @default(uuid())
  partnerId           String
  partner             Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type                String // "church" | "org"
  name                String?
  contactFirstName    String?
  contactLastName     String?
  contactEmail        String?
  websiteLink         String?
  phone               String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?

  createdAt DateTime @default(now())
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@unique([partnerId, type])
}

// A monthly-support dollar amount effective from a date. "Current" support is the latest
// effectiveDate. It is a ledger: there is no update endpoint, so a mistake is corrected by
// deleting the row and adding a new one. Admin-only, never in the public serializer.
model SupportEntry {
  id            String   @id @default(uuid())
  partnerId     String
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount        Int // whole dollars per month
  effectiveDate DateTime @db.Date
  notes         String?
  createdAt     DateTime @default(now())

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
}

// A named, saved set of filters for one report. `shared` views are visible
// to every admin/editor/viewer; private ones only to the owner. `params`
// is the report's own query params exactly as the report page sends them.
model SavedReport {
  id        String           @id @default(uuid())
  reportId  String // a report id from backend/src/reporting/registry.js
  name      String
  // JSON on purpose: each report validates its own params and nothing queries inside them.
  params    Json
  shared    Boolean          @default(false)
  ownerId   String
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  schedules ReportSchedule[]

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([ownerId])
  @@index([reportId])
}

// Emails a saved view on a cadence. Always rendered for the "shared"
// audience (restricted partners masked), because the recipient may not be
// signed in. `skipIfEmpty` avoids "nothing to report" emails. Recipients
// are existing user ids -- never free-form addresses -- so an email can't
// be pointed outside the church's own accounts.
model ReportSchedule {
  id            String      @id @default(uuid())
  savedReportId String
  savedReport   SavedReport @relation(fields: [savedReportId], references: [id], onDelete: Cascade)
  cadence       String // "weekly" | "monthly" | "quarterly"
  recipientIds  String[] // User ids
  skipIfEmpty   Boolean     @default(true)
  active        Boolean     @default(true)
  lastSentAt    DateTime?
  createdAt     DateTime    @default(now())

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([savedReportId])
}

// A one-time financial need a partner requested, and our response; distinct from SupportEntry
// (recurring). approvedAmount/approvedDate stay null until decided and may be less than
// requestedAmount. There is no status enum: pending/declined/partial/funded are read off
// approvedAmount.
model SupportNeed {
  id              String    @id @default(uuid())
  partnerId       String
  partner         Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  description     String    @db.Text
  requestedAmount Int
  requestDate     DateTime  @db.Date
  approvedAmount  Int?
  approvedDate    DateTime? @db.Date
  // Why approvedAmount came out as it did; set with the decision, separate from the general
  // notes. Surfaced in the supportNeedDecided dispatch (dispatchBlurbs.js).
  decisionNote    String?   @db.Text
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())

  // Same as PrayerRequest.isUrgent.
  isUrgent Boolean @default(false)

  // See PrayerRequest.sourceFileId.
  sourceFileId String?
  sourceFile   PartnerFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
}

// A prayer request from a partner, kept as a long-term record, not a pass/fail checklist.
// `status` has no "unanswered": "ongoing" (default) means still praying, "untracked" opts out of
// tracking an answer (e.g. "safe travels this week"), "answered" pairs with dateAnswered and
// answeredNote.
//
// `category` ("strategic" | "situational") controls public eligibility: only "strategic"
// requests can be shown publicly, and only when `isPublic` is also set.
model PrayerRequest {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // "strategic" (tied to the ministry's long-term calling: church planting, discipleship,
  // language study, funding) vs "situational" (health, travel, family, paperwork).
  category         String // "strategic" | "situational"
  requestText      String   @db.Text
  dateReceived     DateTime @db.Date
  isPublic         Boolean  @default(false) // only takes effect when category is "strategic"
  // Booklet space is tight (AdminBooklet.jsx's per-page cap); only takes effect when isPublic
  // is also true.
  includeInBooklet Boolean  @default(false)

  status       String    @default("ongoing") // "ongoing" | "answered" | "untracked"
  dateAnswered DateTime? @db.Date
  answeredNote String?   @db.Text

  // Set at creation by admin/editor (sendUrgentDispatch): bypasses every recipient's cadence
  // and dispatches immediately, but not the restricted-partner review gate or the channel
  // eligibility rules (dispatchEligibility.js isEligibleForChannel).
  isUrgent Boolean @default(false)

  notes     String?  @db.Text
  createdAt DateTime @default(now())

  // Set when added from the "Scan for requests" flow, linking back to the original file.
  // SetNull, so deleting the file keeps the request. Never shown publicly or in the booklet.
  sourceFileId String?
  sourceFile   PartnerFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
  @@index([category])
  @@index([status])
}

// A file received from a partner: a newsletter or a general document, distinguished by `kind`.
//
// The bytes live in PartnerFileBytes, in Postgres rather than an object store, so plain queries
// never load them; they are served only by GET /api/partner-files/:id/download (admin-only).
// Fine at one church's scale; see CONTRIBUTING.md if that stops being true for a fork.
model PartnerFile {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // A validated string (routes/partnerFiles.js), not an enum, so a fork can add kinds. Inbound
  // email defaults to "newsletter"; an admin fixes a mis-filed one with the normal PUT.
  kind       String // "newsletter" | "survey_response" | "signed_policy" | "email" | "office_document" | "other"
  // Free-typed label, only used when kind is "other".
  customKind String?

  title        String?
  receivedDate DateTime @db.Date
  // The bytes live in PartnerFileBytes.
  fileName     String // original uploaded filename, for display/download
  contentType  String
  fileSize     Int? // bytes
  notes        String?  @db.Text

  createdAt DateTime @default(now())

  // Back-relations for sourceFileId (Prisma needs both sides).
  sourcedPrayerRequests PrayerRequest[]
  sourcedSupportNeeds   SupportNeed[]
  bytesRow              PartnerFileBytes?

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
  @@index([kind])
}

model PartnerFileBytes {
  id    String      @id
  file  PartnerFile @relation(fields: [id], references: [id], onDelete: Cascade)
  bytes Bytes
}

// Inbound email (#72) not auto-matched to a partner, held for an admin to assign or discard. A
// row's existence means pending; both outcomes delete it (an assigned one becomes a PartnerFile,
// see routes/inboundEmail.js). No partnerId: it is by definition unmatched.
model InboundEmail {
  id          String             @id @default(uuid())
  receivedAt  DateTime           @default(now())
  fromAddress String
  subject     String?
  // The raw .eml source lives in InboundEmailBytes.
  fileName    String
  createdAt   DateTime           @default(now())
  bytesRow    InboundEmailBytes?
  // Set when the message matched exactly one partner by address but Postmark's SPF/DKIM did
  // not confirm the sender (routes/inboundEmail.js isSenderVerified()); null when zero or
  // several partners matched. From is trivially forgeable; this is what stops a forged letter
  // being auto-filed and broadcast under a real partner's name.
  queueReason String?
}

model InboundEmailBytes {
  id    String       @id
  email InboundEmail @relation(fields: [id], references: [id], onDelete: Cascade)
  bytes Bytes
}

// A webhook call that never became an InboundEmail (bad credentials, missing fields, an
// exception), kept as a failure log. rawPayloadSnippet is a truncated excerpt, not the full
// payload.
model InboundEmailFailure {
  id                String   @id @default(uuid())
  receivedAt        DateTime @default(now())
  reason            String
  rawPayloadSnippet String?  @db.Text
}

// A recorded event that can independently produce up to four dispatches (GroupMe, WhatsApp,
// admin email, public email), each tracked by its own stamp column; all four use
// dispatchEligibility.js's isEligibleForChannel. Named DispatchRecord, not after an "event", to
// leave that word for a future in-app notification feature.
//
// A row's existence means "recorded, not yet fully delivered". dispatchOrchestrator.js's
// clearDispatchRecords() deletes it once every channel is permanently resolved (ineligible, or
// toggled off at that pass) or sent (its stamp is set). A failed channel leaves its stamp null,
// so the next pass retries only that channel.
model DispatchRecord {
  id        String   @id @default(uuid())
  // "prayerRequestCreated" | "prayerRequestAnswered" | "supportNeedCreated" | "supportNeedDecided" | "newsletterCreated"
  type      String
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  // JSON on purpose: the content depends on `type`, is read whole at send time and never
  // filtered on.
  payload   Json
  createdAt DateTime @default(now())

  // Set when groupmeChannel.js posts this row (or by sendUrgentDispatch).
  groupmeDispatchedAt DateTime?

  // WhatsApp's own stamp. Separate from GroupMe's so one channel being down never marks the
  // other delivered.
  whatsappDispatchedAt DateTime?

  // Admin-edited body text (routes/dispatches.js PUT /pending/:id). dispatchReviewedAt null
  // means never edited; dispatchReviewedText, once set, overrides the computed body
  // (dispatchBlurbs.js). dispatchReviewedById is audit-only, no FK.
  //
  // For a RESTRICTED partner's prayer requests and one-time needs (REVIEW_GATED_TYPES),
  // dispatchReviewedAt null also means held, not eligible to send (dispatchEligibility.js). A
  // restricted partner's newsletter is exempt: buildBlurb() already suppresses its content.
  // Structural masking (name/photo/source link) applies regardless of edit state.
  dispatchReviewedAt   DateTime?
  dispatchReviewedById String?
  dispatchReviewedText String?   @db.Text

  // Held until staff approve it, restricted partner or not. Set on records made from a care
  // team member's (non-staff) request or need, so nothing they enter is sent anywhere,
  // including the urgent path, until an admin/editor reviews it in Pending Dispatches (which
  // sets dispatchReviewedAt).
  reviewRequired Boolean @default(false)

  // One stamp per email cadence tier, not per audience: a tier's pass covers every User and
  // PublicSubscriber on it. A single shared stamp would let the first tier to fire suppress
  // the slower ones permanently. Written by emailDispatchDelivery.js, checked per row and tier
  // by clearDispatchRecords().
  biweeklyEmailDispatchSentAt  DateTime?
  monthlyEmailDispatchSentAt   DateTime?
  quarterlyEmailDispatchSentAt DateTime?

  // One error string per channel, set in that channel's send catch block, so "failed" is
  // distinguishable from "not attempted" or "ineligible" (the *DispatchedAt stamp is null for
  // all three). Cleared on the next successful send.
  groupmeError  String?
  whatsappError String?
  emailError    String?

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([type])
  @@index([partnerId])
}

// Every photo ever uploaded for a partner, not just the current one. Unlike PartnerFile, photos
// are public (GET /api/photos/:id/raw, unauthenticated): the public serializer is what keeps a
// restricted record's real photo out of responses, not this route. Responses synthesize a `url`
// instead of returning bytes. The "current" photo is the row with the latest receivedDate, not
// the latest upload, so backfilling an older photo does not demote a newer one.
model Photo {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // The image lives in PhotoBytes.
  receivedDate DateTime @db.Date // when this photo was actually taken/received, not upload time
  contentType  String?
  fileSize     Int? // bytes

  createdAt DateTime    @default(now())
  bytesRow  PhotoBytes?

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
}

model PhotoBytes {
  id    String @id
  photo Photo  @relation(fields: [id], references: [id], onDelete: Cascade)
  bytes Bytes
}

// Single-row table describing the church running this instance: white-labels the app and
// auto-fills a missionary's Sending Church section. Fixed id so there is never more than one
// row; GET returns null before it is configured, PUT upserts.
model ChurchSettings {
  id String @id @default("singleton")

  churchName          String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?
  phone               String?
  contactFirstName    String?
  contactLastName     String?
  contactEmail        String?
  websiteLink         String?

  // What this church calls its partners, e.g. "Go Team Partner(s)". Null falls back to
  // "Missionary"/"Missionaries".
  partnerTermSingular   String?
  partnerTermPlural     String?
  // Off: admin nav/list headings keep saying "Missionary Partners" (the data type being
  // edited).
  usePartnerTermInAdmin Boolean @default(false)

  publicTagline   String? // short subtitle under the public map/directory header
  aboutText       String?             @db.Text // optional blurb shown on the public directory
  // Three brand colors: primaryColor is the ACCENT (buttons, links, headings, letterhead),
  // headerColor the header and admin sidebar background, highlightColor
  // hover/focus/active/selected feedback.
  primaryColor    String? // hex, overrides --brand-color; ACCENT role
  headerColor     String? // hex, overrides --brand-header-color; header + admin sidebar background
  highlightColor  String? // hex, overrides --brand-highlight-color; hover/focus/active/selected feedback
  brandFont       String? // literal CSS font-family stack (not an abstract key), overrides --brand-font; curated choices offered in AdminSettingsBranding.jsx
  // The site logo's bytes live in ChurchSettingsLogo. Public, served unauthenticated at GET
  // /api/public/settings/logo/raw; API responses synthesize `logo: { url } | null` instead of
  // returning bytes.
  logoContentType String?
  logoRow         ChurchSettingsLogo?

  // GroupMe integration (utils/groupmeChannel.js). The user's own personal access token, not a
  // bot: Topics are subgroups addressed by their own id through the ordinary messages
  // endpoint, which the Bots API cannot reach. Encrypted at rest (utils/crypto.js
  // encryptField). Every route outside routes/settings.js's /groupme sub-routes must omit it,
  // so it never rides along in the general settings payload any logged-in role can read.
  groupmeAccessToken          String?
  // The parent group and its topics, picked from live GroupMe API calls (never hand-typed);
  // the *Name fields are cached display labels.
  groupmeGroupId              String?
  groupmeGroupName            String?
  // One topic per dispatch content type.
  groupmePrayerTopicId        String?
  groupmePrayerTopicName      String?
  groupmeOneTimeNeedTopicId   String?
  groupmeOneTimeNeedTopicName String?
  groupmeNewsletterTopicId    String?
  groupmeNewsletterTopicName  String?

  // WhatsApp integration (utils/whatsappChannel.js, whatsappClient.js). No token here: the
  // credential is a Baileys session stored encrypted per row in WhatsAppAuthEntry. Nothing in
  // this block is secret: display labels and ids picked from live lists.
  //
  // One WhatsApp community with several groups, mapped onto the same three content types as
  // GroupMe Topics. The community's built-in Announcements group (isCommunityAnnounce) is
  // resolved and stored when a community is picked (routes/settings.js PUT /whatsapp,
  // whatsappClient.js findAnnouncementGroup). A type with no group of its own posts there;
  // with neither set it is not sent (whatsappChannel.js hasWhatsAppTarget/postToWhatsApp).
  whatsappPhoneNumber           String? // digits only, the dedicated number the app is paired as
  whatsappPairedAt              DateTime?
  // Connection health for the "WhatsApp connection drop" notification (the worker's in-memory
  // status does not survive a restart). Written when the connection genuinely fails, not on
  // transient blips; cleared on the next successful connect. whatsappDisconnectedAt null means
  // never paired or currently connected; the query tells them apart via whatsappPairedAt.
  whatsappLastError             String?
  whatsappDisconnectedAt        DateTime?
  whatsappCommunityId           String?
  whatsappCommunityName         String?
  whatsappAnnouncementGroupId   String?
  whatsappAnnouncementGroupName String?
  whatsappPrayerGroupId         String?
  whatsappPrayerGroupName       String?
  whatsappOneTimeNeedGroupId    String?
  whatsappOneTimeNeedGroupName  String?
  whatsappNewsletterGroupId     String?
  whatsappNewsletterGroupName   String?

  // Joshua Project API key (utils/joshuaProject.js). Encrypted at rest like
  // groupmeAccessToken; every route outside routes/settings.js's /joshua-project sub-routes
  // must omit it.
  joshuaProjectApiKey String?

  // Anthropic API key (utils/extraction.js) for AI request scanning. Encrypted like
  // groupmeAccessToken; every route outside routes/settings.js's /ai-extraction sub-routes
  // must omit it. Usage is billed per scan to the key owner, so a leak into a response is a
  // real cost: see test/routes/aiExtraction.test.js.
  anthropicApiKey String?

  // Anthropic model id for AI request scanning (utils/extraction.js); null uses the built-in
  // default. Free text, not an enum, so a church can use any model id (#324). Not a secret, so
  // unencrypted and saved through the same /ai-extraction sub-route.
  extractionModel String?

  // Postmark server API token for outbound email (utils/email.js), a transactional provider
  // rather than SMTP against the church's own mailbox (#71). Encrypted like
  // groupmeAccessToken; every route outside routes/settings.js's /email sub-routes must omit
  // it. emailFromAddress is the visible "From:", not a secret.
  postmarkServerToken String?
  emailFromAddress    String?

  // Inbound email (#72, routes/inboundEmail.js). Postmark's inbound webhook has no HMAC
  // signature, so the URL carries HTTP Basic Auth, checked with a constant-time compare. The
  // password is encrypted like postmarkServerToken; every route outside routes/settings.js's
  // /inbound-email sub-routes (and the webhook's own check) must omit it. The username is not
  // a secret on its own.
  inboundEmailWebhookUsername String?
  inboundEmailWebhookPassword String?

  // Per-church feature switches. Keys are validated against utils/features.js's registry, so a
  // new feature is a registry entry, not a migration. A missing key means enabled (see
  // isFeatureEnabled for the exception). JSON on purpose.
  enabledFeatures Json @default("{}")

  // Permanent, server-side opt-out of BackupReminder.jsx's nudge (distinct from its
  // per-browser 30-day dismiss), for a church that has confirmed its host's backups work.
  backupReminderDisabled Boolean @default(false)

  // How long AuditLog keeps events, in days (30, 60 or 90), pruned daily by the worker. Only
  // the event history expires; the "last edited by" columns do not.
  auditRetentionDays Int @default(90)

  // Require two-factor (TOTP) for every account. Enforced at sign-in (an unenrolled account is
  // sent to enrolment and gets no session) and on every request (an earlier session stops
  // working until they enrol); nobody can turn it off for themselves while it is on. Turning
  // it on is refused unless the person doing so has enrolled.
  requireTwoFactor Boolean @default(false)

  // Passwordless sign-in, church-wide: a person with a passkey signs in with it alone (it is
  // both factors); one without gets a one-time emailed link and is taken through adding a
  // passkey. Implies requireTwoFactor, needs working outbound email, and can only be turned on
  // by an admin who has a passkey. Passwords are kept, so turning it off restores the previous
  // state.
  requirePasswordless Boolean @default(false)

  // Schedule for the three email dispatch tiers (emailDispatchDelivery.js,
  // emailDispatchScheduler.js). Biweekly uses emailDispatchDayOfWeek; monthly and quarterly
  // use emailDispatchDayOfMonth (capped at 1-28 to avoid short months) and are told apart by
  // each tier's minimum-gap check against its own last*SentAt cursor, which also dedupes
  // within the matching hour.
  emailDispatchDayOfWeek           Int? // 0 (Sun) - 6 (Sat) -- biweekly
  emailDispatchDayOfMonth          Int? // 1 - 28 -- monthly/quarterly
  emailDispatchHour                Int? // 0 - 23, in this church's configured timezone (see `timezone` below)
  lastBiweeklyEmailDispatchSentAt  DateTime?
  lastMonthlyEmailDispatchSentAt   DateTime?
  lastQuarterlyEmailDispatchSentAt DateTime?

  // GroupMe/WhatsApp are real-time chat posts, never batched: one daily batch hour, with
  // lastGroupmeChatDispatchSentAt as its dedupe guard (groupmeChannel.js shouldFlushGroupMe).
  chatDispatchHour               Int? // 0 - 23, in this church's configured timezone
  lastGroupmeChatDispatchSentAt  DateTime?
  // WhatsApp shares chatDispatchHour and the chatDispatch* mutes but keeps its own cursor: a
  // shared one would let whichever channel ran first block the other all day.
  lastWhatsappChatDispatchSentAt DateTime?

  // This church's IANA timezone, applied to process.env.TZ at startup (server.js). Every
  // hour-based schedule check, birthdays and furlough depend on it. Defaults to
  // America/Chicago, not UTC, so an unconfigured US deployment is close. Takes effect on the
  // next restart, since changing TZ mid-process is unreliable.
  timezone String @default("America/Chicago")

  // Content-type mutes for the chat channels only (GroupMe, WhatsApp); email dispatches
  // include every content type they are allowed to. Default true.
  chatDispatchPrayerRequests     Boolean @default(true)
  chatDispatchOneTimeNeeds       Boolean @default(true)
  chatDispatchNewsletters        Boolean @default(true)
  // Applies to every channel. Off means a restricted partner's event is never recorded, for
  // any type, so a church that does not watch the review queue
  // (DispatchRecord.dispatchReviewedAt) does not accumulate an unreviewed backlog. Default off
  // because it is a safety gate.
  allowRestrictedPartnerDispatch Boolean @default(false)

  // A restricted partner's masked display name is the initials of their real name (e.g.
  // "J.R.") on the public site, chat dispatches and email digests. In a small country,
  // initials plus country plus household shape can re-identify them. Off falls back to
  // fieldDisplayName, else a generic label (utils/maskData.js maskedDisplayName()).
  restrictedPartnerInitialsEnabled Boolean @default(true)

  // Who key-date reminders go to for a partner with no care team. SetNull so deleting the
  // login clears it. Set via /api/care-team/default-lead, not the generic settings route.
  defaultCareLeadUserId String?
  defaultCareLead       User?   @relation("ChurchDefaultCareLead", fields: [defaultCareLeadUserId], references: [id], onDelete: SetNull)

  // Days ahead a key date is raised (bell and daily email agree), and days without a logged
  // contact before a partner is "quiet".
  keyDateLeadDays  Int @default(7)
  contactStaleDays Int @default(90)

  // Email dispatch customization; null subject/signature means the built-in default
  // (DEFAULT_SUBJECT_TEMPLATE in emailDispatchShell.js). Shared by the admin and public
  // dispatches. The subject template supports
  // {church}/{month}/{year}/{date}/{cadence}/{name}/{term}, substituted in
  // emailDispatchShell.js; no other syntax.
  emailDispatchSubjectTemplate String?
  // Closing line shown above the unsubscribe link; email-only, separate from publicTagline.
  emailDispatchSignature       String? @db.Text
  // "classic" (text-only partner cards) or "snapshot" (adds photo, field, "Supporting since"
  // and short overview; see emailDispatchShell.js partnerTileDetails()). Null means "classic".
  emailDispatchLayout          String? // "classic" | "snapshot"

  // Which of the three cadence tiers are offered to admins (Account Settings) and public
  // subscribers, independent of whether the tier's schedule is set (#209). At least one must
  // stay enabled: settingsDispatches.js's PUT rejects all three off.
  cadenceBiweeklyEnabled  Boolean @default(false)
  cadenceMonthlyEnabled   Boolean @default(true)
  cadenceQuarterlyEnabled Boolean @default(true)

  onlineGivingUrl          String? // link to the church's own external online giving platform, if it has one
  onlineGivingInstructions String? @db.Text // which fund/category to pick, how to include the participant's name

  // Opt-in: donorEmail/donorPhone are extra third-party PII. A UI switch only; the columns
  // stay.
  collectDonorContactInfo Boolean @default(false)

  // Whether the public application form asks for a mailing address. On by default: routine for
  // a trip application.
  collectApplicantAddress Boolean @default(true)

  // Whether the application form asks for an emergency contact. On by default: routine and
  // safety-relevant.
  collectEmergencyContact Boolean @default(true)

  // Gate on "Generate private application link": off means no Trip.applicationShareToken can
  // be created.
  allowPrivateApplicationLinks   Boolean @default(false)
  // Gate on generating TripParticipant.shareToken.
  allowPublicSupportRaisingLinks Boolean @default(false)

  // Whether the Budget section (TripBudgetLine) shows in AdminTripBudget.jsx. Opt-in.
  enableTripBudgeting Boolean @default(false)

  // The address partners were told (outside this app) to send newsletters to, under the
  // inbound domain set in Postmark. Display only.
  inboundEmailAddress String?

  // The church-wide application questions, requirement checklist and the two pick-from
  // libraries are real rows (ApplicationQuestion, RequirementTemplateItem; scope "template" or
  // "library"); see utils/tripTemplates.js.

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?
}

model ChurchSettingsLogo {
  id        String         @id
  settings  ChurchSettings @relation(fields: [id], references: [id], onDelete: Cascade)
  logoBytes Bytes
}

// Users who can log into the admin backend. authProvider is always "local" (email + password,
// optionally TOTP). The column stays so routes/auth.js can refuse to password-authenticate any
// row that isn't, as insurance against a passwordless row created some other way. SSO was
// dropped because auto-provisioning handed an account (which can read every partner's full
// record) to anyone at the identity provider.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  firstName    String?
  lastName     String?
  passwordHash String? // null for a pending account until its setup link is redeemed
  authProvider String    @default("local")
  role         String    @default("editor") // "admin" | "editor" | "viewer" | "guest"
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  // Embedded in the session JWT (utils/jwt.js) and compared on every request
  // (middleware/requireAuth.js); a mismatch means the token predates a change that should have
  // ended it. Incremented on password change or reset, MFA enable/disable and role change, but
  // not on logout, which stays scoped to one browser.
  sessionVersion Int @default(0)

  // Guest tier (role "guest"): reach comes only from grant rows (TripAccess, CareTeamMember),
  // never from the role, so a guest with no active grant can do nothing and requireAuth
  // refuses the session.
  tripAccess TripAccess[]

  // TOTP MFA, opt-in and self-service. mfaSecret is cleared whenever MFA is turned off.
  // Encrypted at rest (utils/crypto.js) because verification needs the raw secret, so it
  // cannot be a one-way hash.
  mfaEnabled       Boolean @default(false)
  mfaSecret        String?
  // Last TOTP time step accepted, so a code cannot be replayed within its 30-second window
  // (otplib's afterTimeStep). Null until the first successful code.
  mfaLastTimeStep  Int?
  // Admin-set: forces enrollment at next login while mfaEnabled is false. The user still does
  // the QR scan.
  mfaSetupRequired Boolean @default(false)

  // A care team member who opts out of the daily key-date email; the bell is unaffected.
  keyDateEmailOptOut Boolean @default(false)

  passkeys         UserPasskey[]
  signInLinkTokens SignInLinkToken[]

  // Opt-in admin digest email, self-service. null = not subscribed; otherwise the cadence tier
  // picked. Set to null by the signed unsubscribe link in every digest footer, no login
  // required.
  cadence           String? // "biweekly" | "monthly" | "quarterly" | null
  // false: only followedPartners; true: every partner this user's role can see.
  allPartners       Boolean               @default(true)
  followedPartners  UserFollowedPartner[]
  careTeamSeats     CareTeamMember[]
  contactsMade      ContactLog[]          @relation("ContactLogContactedBy")
  contactsEntered   ContactLog[]          @relation("ContactLogCreatedBy")
  keyDateReminders  KeyDateReminder[]
  defaultLeadFor    ChurchSettings[]      @relation("ChurchDefaultCareLead")
  notificationsSeen NotificationSeen[]
  savedReports      SavedReport[]

  passwordSetupTokens PasswordSetupToken[]

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?
}

// Single-use link that lets a new user choose their own password. Only a
// SHA-256 hash of the random token is stored, never the token itself, so a
// database leak can't be replayed. Issuing a new link deletes the user's
// older unused ones (utils/passwordSetup.js), so at most one is live.
model PasswordSetupToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// A guest login's access to one trip: this row is the permission (beyond the guest role's empty
// baseline). Grants never allow deletes, profile edits or settings; that limit is in the routes'
// requireRole lists.
//
// Expiry is derived at check time (utils/guestAccess.js): expiresAt null lapses 30 days after
// Trip.endDate (a trip with no end date never lapses). expiresAt is only an admin override
// ("extend" or "end now") and wins either way.
model TripAccess {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, tripId])
  @@index([tripId])
}

// Per-user, per-category "last looked at" marker for the notification bell. Personal so clearing
// one person's "new" highlight never clears a teammate's (see notifications/categories.js);
// counts are live queries.
model NotificationSeen {
  userId   String
  category String
  seenAt   DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
}

// A user's specific-partner digest scope; only used when User.allPartners is false. Same shape
// as PublicSubscriberPartner.
model UserFollowedPartner {
  userId    String
  partnerId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([userId, partnerId])
  @@index([partnerId])
}

// A login's seat on one partner's care team. Any number of members, at most one lead per partner
// (routes/careTeams.js in a transaction, plus a partial unique index added to the migration by
// hand, which Prisma can't express). A seat adds a marker and an "Assigned to me" view, never
// extra visibility for a full role. For a guest a seat is a grant that reaches that partner and
// never expires. Every member has a login. Gated by the `careTeam` feature: off = hidden and
// ignored for access, data kept.
model CareTeamMember {
  id        String   @id @default(uuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@unique([partnerId, userId])
  @@index([userId])
}

// Support preferences: a menu of ways to support a partner, owned by the church (data, editable
// in Settings), and each partner's choices from it. Gated by the `supportPreferences` feature.
//
// `kind` is how the partner answers: "offer" (a thing we offer: tick it if wanted),
// "single" or "multiple" (pick from `choices`, optionally with an "other" box), or "text".
// `group` is plain text so a church can rename it. An option is retired (`active: false`)
// rather than deleted, so answers already given stay readable; deleting one is a hard
// delete that takes its answers with it.
model SupportOption {
  id         String   @id @default(uuid())
  group      String
  label      String
  kind       String   @default("offer") // "offer" | "single" | "multiple" | "text"
  choices    String[] // the choices for "single" / "multiple"; empty for the other kinds
  allowOther Boolean  @default(false)
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferences PartnerSupportPreference[]

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([group, sortOrder])
}

// One partner's response to one option: `selected` for an offer, and for the other kinds
// `choice` (pick one), `choices` (pick any), `other` and `text`, plus an optional `note`.
// `selected` is also true when a question has an answer, so "who has chosen anything for this
// option" is one column for every kind. One set per partner (a couple or family shares it).
model PartnerSupportPreference {
  id        String        @id @default(uuid())
  partnerId String
  partner   Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  optionId  String
  option    SupportOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  selected  Boolean       @default(false)
  choice    String? // "single": the choice picked
  choices   String[] // "multiple": the choices picked
  other     String? // the "other" answer, when the option allows one
  text      String?       @db.Text // "text": what they wrote
  note      String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@unique([partnerId, optionId])
  @@index([optionId])
}

// One question on a trip application, in an admin-chosen order. `scope` says where it lives:
// "trip" (that trip's own questions, tripId set), "template" (the church-wide questions every
// trip's form asks first) or "library" (a pick-from list, never shown on a form until copied).
// `type` is app-validated (text, textarea, select, checkboxes, date); `options` only matters for
// select and checkboxes.
model ApplicationQuestion {
  id       String   @id @default(uuid())
  scope    String
  tripId   String?
  trip     Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  position Int
  label    String
  required Boolean  @default(false)
  type     String   @default("text")
  options  String[]

  answers TripApplicationAnswer[]

  createdAt DateTime @default(now())
  @@index([tripId])
  @@index([scope, position])
}

// One answer on a submitted application. `label` is the question as it was worded when the
// person answered; `questionId` is cleared if the question is later deleted, so the answer stays
// readable. A text answer is `value`; a checkboxes answer is `values`.
model TripApplicationAnswer {
  id            String               @id @default(uuid())
  applicationId String
  application   TripApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String?
  question      ApplicationQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  position      Int
  label         String
  value         String?              @db.Text
  values        String[]

  @@index([applicationId])
  @@index([questionId])
}

// One entry of the church-wide requirement checklist. `scope` "template" is copied onto every
// new, still-active trip as real TripRequirement rows; "library" is a pick-from list for a single
// trip. Same fields as TripRequirement, minus the dates and statuses that only exist on a real one.
model RequirementTemplateItem {
  id               String  @id @default(uuid())
  scope            String
  position         Int
  label            String
  kind             String  @default("document")
  bodyText         String? @db.Text
  reminderLeadDays Int?
  minorsOnly       Boolean @default(false)

  @@index([scope, position])
}

// A one-time sign-in link, emailed to someone who has no passkey yet while the church
// signs in without passwords. Like PasswordSetupToken, only a SHA-256 hash of the random token is
// stored, a link is dead once used or expired, and issuing a new one deletes the older unused ones.
model SignInLinkToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// A passkey challenge that has been used. A challenge travels to the browser and back inside a
// short-lived signed token, and is accepted once: its id is recorded here until it would have
// expired anyway, so "once" holds across restarts and across more than one instance. Rows are
// deleted as they expire; nothing here is worth backing up.
model SpentPasskeyChallenge {
  id        String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

// A passkey (WebAuthn credential) a person has added as a second sign-in factor, next to or
// instead of an authenticator app. Only public material is stored: the credential id and the public
// key (both base64url text), the signature counter, and the transports the browser reported. A
// person with one or more has User.mfaEnabled true, so everything that asks "is a second factor
// enrolled" (sign-in, the church-wide requirement) needs no change. Several per person is the
// backup: a lost phone is one of them, not the only way in.
model UserPasskey {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  transports   String[]
  label        String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

// A public, no-login email subscription to prayer-request updates, using the same DispatchRecord
// rows and isEligibleForChannel as admin subscribers: prayer requests only, never a one-time
// need or newsletter. Double opt-in: a row is created unconfirmed on POST /api/public/subscribe
// and only starts receiving digests once the emailed link is clicked (confirmedAt null means
// never sent to).
model PublicSubscriber {
  id          String    @id @default(uuid())
  email       String    @unique
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  // Same cadence options as User.cadence.
  cadence String @default("biweekly") // "biweekly" | "monthly" | "quarterly"

  // Same all-vs-specific shape as User.allPartners above.
  allPartners    Boolean                   @default(true)
  scopedPartners PublicSubscriberPartner[]

  @@index([confirmedAt])
}

// A public subscriber's specific-partner scope; only used when PublicSubscriber.allPartners is
// false.
model PublicSubscriberPartner {
  subscriberId String
  partnerId    String
  subscriber   PublicSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  partner      Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([subscriberId, partnerId])
  @@index([partnerId])
}

// The WhatsApp (Baileys) session, one row per auth-state key ("creds" plus a row per Signal
// key). In the database because Render's filesystem is ephemeral. `value` is always an
// encryptField() ciphertext, so losing FIELD_ENCRYPTION_KEY means re-pairing. Never selected
// into any API response (whatsappAuthState.js).
model WhatsAppAuthEntry {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
