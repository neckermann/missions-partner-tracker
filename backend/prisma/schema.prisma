// Prisma schema for the Missions Team Missionary Tracker
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

// The connection URL used to live here (url = env("DATABASE_URL")) --
// Prisma 7 removed that; it's now in prisma.config.js instead (which
// also stays the single source of truth for prisma migrate/studio/etc.
// commands, not this file).
datasource db {
  provider = "postgresql"
}

// A partner this church supports -- either an individual/family missionary
// or a local/national partner organization, distinguished by `kind`.
//
// These were two separate models (Missionary and Organization) through
// v1.7.0. They shared 36 fields, and two of the apparent differences were
// just naming accidents for identical concepts (displayName vs name;
// missionTrips vs orgTrips, which pointed at the same Trip model). Every
// collection below already treated them interchangeably via twin nullable
// foreign keys, which meant an "exactly one parent" rule enforced only in
// application code, in eight different places -- and roughly 160 call
// sites across the app branching on which of the two it was holding.
// Merging them made `partnerId` a single non-nullable foreign key, so that
// invariant is now a database guarantee, and deleted the branching
// outright.
//
// The genuine differences are narrow, and handled as nullable columns and
// optional relations rather than separate tables: a missionary has a
// family, furloughs, and a sending party; an organization has an orgType
// and its own contact person. Nothing enforces at the DB level that an
// organization has no children -- application code simply never creates
// them, the same way it already handles every other "kind"-specific rule.
model Partner {
  id   String @id @default(uuid())
  kind String // "missionary" | "organization"

  // --- Visibility controls ---
  isPublic     Boolean @default(false) // show on public site at all
  isRestricted Boolean @default(false) // if public + restricted -> masked/generic view only

  // --- Status ---
  // Archiving is the "soft delete" — hides the record from admin lists by
  // default, forces isPublic off, and zeros out monthly support (via a new
  // SupportEntry, not by editing old ones) — while keeping every bit of
  // history intact. DELETE is only permitted once a record is archived, so
  // archiving is the deliberate first step toward ever actually removing
  // someone.
  archived   Boolean   @default(false)
  archivedAt DateTime?

  // --- Core identity / field info ---
  displayName      String
  fieldDisplayName String? // e.g. "Northern Uganda" - safe to show even if restricted
  fipsCountryCode  String?

  // overview is the long-form narrative; overviewShort is a one/two-line
  // summary for quick-read contexts (directory cards, list views).
  overview        String?   @db.Text
  overviewShort   String?
  focusArea       String?   @db.Text
  supportingSince DateTime? @db.Date // year-only values are stored as Jan 1 of that year

  // The last time the *whole congregation* prayed for this partner
  // together -- e.g. during a service or a dedicated prayer gathering.
  // Deliberately separate from PrayerRequest.status (ongoing/answered),
  // which tracks individual requests, and from any notification/digest
  // timestamp, which tracks whether people were told, not whether the
  // church actually prayed as a body (see issue #228). A manual record
  // kept at the Partner level since it's about the partner as a whole,
  // not any one request. @db.Date, same as dateAnswered/supportingSince
  // above -- this is a calendar date an admin picks or confirms "today,"
  // not an instant, so it gets the same local-date handling (see
  // frontend/src/utils/format.js's header comment on why that matters).
  lastPrayedWithCongregationAt DateTime? @db.Date

  // --- Contact ---
  preferredContactMethod String? // e.g. "Email", "Phone Call", "Text/SMS", "WhatsApp", "Mail"
  // Missionary-only: whether it's ok to contact them directly.
  contactSafe            Boolean @default(true)
  // #288: shown instead of the tap-to-call/text/email actions when
  // contactSafe is off ("special communication instructions"). Free text,
  // staff-facing.
  contactInstructions    String? @db.Text
  // Missionary-only: true when this church (see ChurchSettings) is this
  // missionary's sending church — distinct from the SendingParty relation
  // below, which records details about whichever church actually sends
  // them (may or may not be this one). Displayed as "Sent by
  // {ChurchSettings.churchName}" in the UI.
  sentByOurChurch        Boolean @default(false)
  // Organization-only: the person to reach at the organization. A
  // missionary is their own contact, so these stay null for that kind.
  // #257/#271 Finding 4: split first/last, same treatment as every
  // other individual-person name field in this schema.
  contactFirstName       String?
  contactLastName        String?
  contactPhone           String?
  contactEmail           String?

  // --- Kind-specific profile fields ---
  orgType               String? // organization-only: "Local" | "National"
  anniversary           DateTime? @db.Date // missionary-only
  // #271 Finding 3: flat columns, not a Json blob -- missionary-only,
  // same fixed name/phone/email shape as SendingParty/TripParticipant's
  // own emergency-contact columns, which is the convention this schema
  // actually follows for a fixed, non-variable shape.
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactEmail String?

  // --- Mission trip capacity: what kind of team this partner can host ---
  tripTeamSizeMin    Int?
  tripTeamSizeMax    Int?
  tripSeasonNotes    String? @db.Text // best time of year, typical duration, etc.
  tripLogisticsNotes String? @db.Text // lodging, requirements, other logistics

  // --- Collections ---
  // Each is its own resource with per-row create/update/delete (see the
  // route files). Deliberately never written as a nested array on a
  // Partner update: doing that meant deleting and recreating every child
  // row on each save, which churned their ids and silently destroyed rows
  // added through the collection's own endpoint in the meantime.
  // adults/children/furloughs are missionary-only (always empty for an
  // organization) but follow the exact same rule.
  trips                    Trip[]
  churchVisits             ChurchVisit[]
  supportEntries           SupportEntry[]
  // Named needRequests, not supportNeeds, to avoid colliding with the
  // ministry-need narrative text this app used to carry under that name.
  needRequests             SupportNeed[]
  prayerRequests           PrayerRequest[]
  files                    PartnerFile[]
  // Full upload history, not just the current one — see the Photo model.
  // The "current" photo (what the admin UI and public site show) is
  // whichever has the latest receivedDate, not just the latest upload.
  photos                   Photo[]
  dispatchRecords          DispatchRecord[]
  // Scoped-digest follows (#202) -- who's opted into updates for just
  // this partner, rather than every partner. Two sources, same shape.
  followedByUsers          UserFollowedPartner[]
  careTeam                 CareTeamMember[]
  contactLogs              ContactLog[]
  keyDateReminders         KeyDateReminder[]
  publicSubscriberPartners PublicSubscriberPartner[]
  adults                   Adult[]
  children                 Child[]
  furloughs                Furlough[]
  // Replaces the old fixed websiteLink/supportLink/newsletterSignup/
  // facebook/twitter/instagram/linkedin columns -- `type` is a plain string
  // (not a hardcoded enum) so a fork can request a new platform without a
  // migration, same convention as PartnerFile.kind.
  links                    PartnerLink[]
  // Replaces the old languagesSpoken String[] column -- gives each language
  // its own row so a proficiency level can be attached and updated per
  // language without resending every other one.
  languages                PartnerLanguage[]
  // Replaces the old tripTypesSupported String[] column -- same reasoning
  // as links/languages above, not a trip-capacity-specific exception.
  tripTypes                TripType[]

  // addresses/sendingParties are the one exception to "per-row CRUD": each
  // type has at most one row per partner (@@unique([partnerId, type])), so
  // there's no "add a new one without touching the other" case the way
  // there is for a growing list -- editing one is inherently replacing the
  // whole row for that type. Still wholesale-replaced on Partner's own PUT.
  addresses      Address[]
  sendingParties SendingParty[]

  // Audit is kept on Partner only, deliberately. The collections below
  // carried createdById inconsistently (and routes/photos.js never
  // populated the column it had), nothing in the app ever read any of it,
  // and half-populated provenance is worse than none because you can't
  // trust it. Here it's populated on every create/update, so it means
  // something.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([kind])
  @@index([isPublic, isRestricted])
  @@index([archived])
}

model Adult {
  id               String    @id @default(uuid())
  partnerId        String
  partner          Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  // #257/#271 Finding 4: split first/last, same as Child below. firstName
  // is nullable at the DB level (unlike the single `name` column it
  // replaces) purely to let this migration add it to a non-empty table
  // with no default -- app-level validation (routes/partners.js's zod
  // schema) still requires it on every write.
  firstName        String?
  lastName         String?
  phone1           String?
  phone2           String?
  email            String?
  birthday         DateTime? @db.Date
  // #288: the adult to reach first. At most one per partner -- enforced by a
  // partial unique index in the migration (Prisma can't express a WHERE on a
  // unique), and by the route, which clears the old one when a new one is set.
  isPrimaryContact Boolean   @default(false)
  createdAt        DateTime  @default(now())

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
}

model Child {
  id        String    @id @default(uuid())
  partnerId String
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  firstName String?
  lastName  String?
  birthday  DateTime? @db.Date
  createdAt DateTime  @default(now())

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
}

// A partner can have up to one address per type. "physical" is their actual
// serving location (may be a full street address or just city/state/country,
// depending on what's known/safe to record) and is also the source of the
// public map pin (gpsLat/gpsLng). "mailing" is the US-side contact/support-
// mail address and has no coordinates.
model Address {
  id                  String   @id @default(uuid())
  partnerId           String
  partner             Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type                String // "physical" | "mailing"
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?
  gpsLat              Float?
  gpsLng              Float?
  receiveMail         Boolean?
  receivePackages     Boolean?

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@unique([partnerId, type])
}

// A trip to visit a partner -- covers the whole lifecycle (recruiting,
// active, historical) via `status`, not a separate concept per stage. A
// purely historical backfill is just a trip created already `completed`,
// skipping the recruiting/application stages; an actively-recruited trip
// starts `planning` and moves through `accepting_applications`/`closed`.
// Not a capacity/preference profile -- that lives on Partner.tripTypes
// etc, which this trip's own fields are pre-filled from at creation but
// can then diverge from per-instance.
model Trip {
  id        String   @id @default(uuid())
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // e.g. "Summer 2026 Guatemala Build Team" -- optional, a quick
  // historical backfill may just use type/description like before this
  // field existed, with no formal name.
  name String?

  // "planning" | "accepting_applications" | "closed" | "completed".
  // Defaults to "completed" deliberately -- the dominant real-world case
  // is a quick backfill of a trip that already happened; a new
  // actively-recruited trip's own creation form explicitly picks
  // "planning", overriding this default for that specific flow.
  status String @default("completed")

  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  // Renamed from tripType -- Trip.tripType stutters against its own
  // model name; bare `type` is unambiguous within Trip, same precedent
  // SendingParty.type already sets. Partner.tripTypes.type keeps its
  // own model's "trip" qualifier (TripType, not just Type) since "Type"
  // alone would be ambiguous as a model name.
  type        String? // e.g. "Construction", "Medical/Dental" — preset or custom
  description String?   @db.Text // what the team did/will do -- doubles as the public trip overview when isPublic is on
  notes       String?   @db.Text // admin-only

  teamSizeMin        Int? // pre-filled from Partner.tripTeamSizeMin at creation, then editable per-instance
  teamSizeMax        Int?
  supportRaisingGoal Int? // whole-dollar team total, matching SupportEntry.amount's existing Int convention

  // Gates this trip's discovery-page listing and whether its plain,
  // id-addressed public application route will accept a submission at
  // all (see publicTrips.js/tripEligibility.js). Does NOT gate a
  // participant's own support-raising/self-service page -- those stay
  // reachable via shareToken/access token regardless. Off by default.
  isPublic Boolean @default(false)

  // Null until staff explicitly generate a private application link for
  // this trip -- a dedicated secret, same shape as
  // TripParticipant.shareToken below, deliberately not this row's own
  // id (already visible throughout the admin UI to every logged-in
  // user, so never a real secret). Regenerating overwrites the old
  // value, immediately invalidating any link built from it. The
  // "Generate" action itself only exists when
  // ChurchSettings.allowPrivateApplicationLinks is on.
  applicationShareToken String? @unique

  // An admin-defined, ordered list of plain free-text-answer questions
  // specific to this trip -- [{ id, label, required }]. Never a fixed
  // hardcoded starter set (CONTRIBUTING.md's "keep forks upgradable").
  applicationQuestions Json?

  // External album link only -- never in-app file storage (see #130).
  // albumProvider is app-validated in trips.js, not a DB enum, matching
  // every other String-typed preset field in this schema (type etc).
  albumProvider String? // "google_photos" | "icloud" | "other"
  albumUrl      String?

  participants   TripParticipant[]
  applications   TripApplication[]
  meetings       TripMeeting[]
  documents      TripDocument[]
  requirements   TripRequirement[]
  contributions  TripContribution[]
  budgetLines    TripBudgetLine[]
  flightSegments TripFlightSegment[]
  // Guest logins granted access to this trip (#356) -- any number, since a
  // trip often has more than one leader and a guest may lead more than one
  // trip.
  tripAccess     TripAccess[]

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([partnerId])
  @@index([status])
}

// One row serves both purposes: a freeform backfilled/admin-added entry
// (applicationId: null, no support-raising fields populated) and a team
// member who came through an approved application.
model TripParticipant {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // #310: lets a later re-check (e.g. PUT /api/trips/:id setting dates
  // for the first time) tell "a meeting/requirement that existed when
  // this participant joined, so sendLateJoinerCatchUpEmails already
  // caught them up on it" apart from "one added since -- they're still
  // owed a catch-up for this." Without it, re-running catch-up for every
  // current participant would re-send for things they already got.
  createdAt DateTime @default(now())

  // New participant/applicant records use split name fields (issue
  // #257's broader uplift is separate, later work) -- this model's own
  // first/last columns don't wait on that.
  firstName String?
  lastName  String?

  role  String? // e.g. "Medical", "Construction", "Translator"
  phone String?
  email String?

  // Null for a backfilled or directly-admin-added participant; set when
  // created via application approval.
  applicationId String?          @unique
  application   TripApplication? @relation(fields: [applicationId], references: [id])

  supportRaisingGoal Int? // null/unused for a historical-only row

  // Structured mailing address, same shape as SendingParty's own flat
  // columns -- real, queryable fields rather than a free-text blob,
  // matching this app's established address convention. Copied from the
  // originating TripApplication on approval, same as firstName/lastName/
  // email/phone already are. Gated on the public form by
  // ChurchSettings.collectApplicantAddress, not a per-field validation
  // concern -- a church that doesn't collect this leaves every one of
  // these columns null, same as a backfilled participant with no
  // application at all.
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?

  // Flat columns, not a Json blob -- Partner.emergencyContact (also flat
  // now, #271 Finding 3) is no longer the inconsistent outlier in this
  // schema: SendingParty/Address both use flat columns for a similarly
  // fixed, non-variable shape, which is the better fit for something
  // that's always exactly name/phone/email. Copied from the
  // originating TripApplication on approval, same as the address fields
  // above. Gated on the public form by ChurchSettings.collectEmergencyContact.
  // #257/#271 Finding 4: split first/last, same treatment as every other
  // individual-person name field in this schema.
  emergencyContactFirstName String?
  emergencyContactLastName  String?
  emergencyContactPhone     String?
  emergencyContactEmail     String?

  // dateOfBirth is always collected and required on every trip's public
  // application now -- no per-trip or church-wide toggle gates it. A real
  // date column, not a template question's free-text answer, since the
  // "minor" determination needs something a server check can actually
  // compare against a trip's startDate (see isMinorForTrip in
  // utils/tripParticipantSchema.js), which a Json blob answer keyed by an
  // admin-editable question id can't reliably provide. The parentGuardian*
  // fields are collected (and required) only when isMinorForTrip is true
  // for the submitted dateOfBirth -- the public application wizard inserts
  // an extra step for them in that case, never shown to an adult applicant.
  // Copied from the originating TripApplication on approval, same as
  // address/emergency contact above.
  dateOfBirth                DateTime? @db.Date
  parentGuardianFirstName    String?
  parentGuardianLastName     String?
  parentGuardianRelationship String?
  parentGuardianPhone        String?
  parentGuardianEmail        String?

  // Short random secret for this participant's public support-raising URL --
  // a private share-secret functioning as the page's access control, not
  // a human-readable slug, and not this row's own id either (so the URL
  // never exposes a sequential/guessable link between participants).
  // Not auto-generated at creation -- see ChurchSettings.allowPublicSupportRaisingLinks.
  shareToken String? @unique
  story      String? @db.Text // what shows on their public support-raising page

  // A single current portrait, same mutable-single-value pattern as
  // story/shareToken above -- not a relation like Partner's own Photo
  // model, which exists because a partner accumulates a real gallery
  // over years. A participant's support-raising photo is just one
  // picture, replaced wholesale when changed, no versioning. The bytes
  // themselves live in their own one-to-one table (TripParticipantPhoto,
  // below) -- still Postgres, no separate file storage per CONTRIBUTING.md,
  // just split off so a plain TripParticipant query can never accidentally
  // pull the image in (the #274 production-hang bug class: a relation
  // include with no select/omit base64-inlining a multi-MB file into an
  // unrelated JSON response -- this makes that structurally impossible
  // here instead of relying on every future query remembering to omit).
  photoContentType String?
  photoBytesRow    TripParticipantPhoto?

  // Bumped to invalidate every previously-issued self-service link at
  // once -- same revocation reasoning as User.mfaLastTimeStep's replay
  // protection, applied to a link instead of a TOTP code.
  accessTokenVersion Int @default(0) // tripFieldVisibility: intentionally admin-invisible -- an internal revocation counter, bumped by the resend/regenerate actions themselves, never a value an admin reads or edits directly

  documents           TripDocument[]
  contributions       TripContribution[]
  requirementStatuses TripRequirementStatus[]
  // Reverse side of TripFlightSegment.participants -- which segments (if
  // any) this participant is specifically called out on. Empty doesn't
  // mean "not flying" -- every segment with nobody selected still
  // applies to them regardless (see TripFlightSegment's own comment).
  flightSegments      TripFlightSegment[]
  meetingRsvps        TripMeetingRsvp[]

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([tripId])
}

// Split off from TripParticipant.photo -- see that field's own comment for
// why. Shared primary key with its parent (id is both this table's own PK
// and its FK into TripParticipant), the same one-to-one pattern every new
// Bytes table in this schema uses.
model TripParticipantPhoto {
  id          String          @id
  participant TripParticipant @relation(fields: [id], references: [id], onDelete: Cascade)
  photo       Bytes
}

// A submitted application to a Trip whose status is accepting_applications.
// responses is keyed by each question's id from that trip's own
// applicationQuestions -- { "<id>": "<answer text>" } -- since the
// question set itself is per-trip and admin-defined, not a fixed schema
// this app could widen a column for.
model TripApplication {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String
  phone     String?

  status    String @default("pending") // "pending" | "approved" | "declined" | "withdrawn" -- tripFieldVisibility: intentionally admin-invisible on the participant page specifically, since every application reachable from an approved participant is, by construction, always "approved"; the pending-review list is where this status actually matters and does show it
  responses Json?

  // Structured mailing address, same shape as SendingParty's own flat
  // columns -- see TripParticipant's matching fields for the full
  // rationale. Only ever collected when ChurchSettings.collectApplicantAddress
  // is on; null otherwise.
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateProvinceRegion String?
  postalCode          String?
  country             String?

  // Flat columns -- see TripParticipant's matching fields for the full
  // rationale. Only ever collected when ChurchSettings.collectEmergencyContact
  // is on; null otherwise.
  emergencyContactFirstName String?
  emergencyContactLastName  String?
  emergencyContactPhone     String?
  emergencyContactEmail     String?

  // See TripParticipant's matching fields for the full rationale --
  // dateOfBirth always required; parentGuardian* required only when
  // isMinorForTrip is true for it.
  dateOfBirth                DateTime? @db.Date
  parentGuardianFirstName    String?
  parentGuardianLastName     String?
  parentGuardianRelationship String?
  parentGuardianPhone        String?
  parentGuardianEmail        String?

  submittedAt    DateTime  @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  // Admin-only, never shown to the applicant -- set only when declining;
  // left null for an approval. A declined row isn't deleted (see
  // trips.js's own review route), so this is the one piece of context an
  // admin would otherwise have no record of after the fact.
  declinedReason String?   @db.Text // tripFieldVisibility: intentionally admin-invisible on the participant page -- always null for an approved application (only ever set on a decline, already shown in the applications review list); nothing to show here

  participant TripParticipant?

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([tripId])
}

// A scheduled prep/planning meeting for a trip's team. location and
// meetingLink are independent, not an in-person/virtual choice between
// them -- a hybrid meeting (e.g. "Church fellowship hall" with a Zoom
// link for anyone who can't attend in person) is a realistic case for
// this app's audience, and setting both at once already does the right
// thing with no separate isVirtual boolean: the invite/reminder shows
// whichever of the two are actually set.
model TripMeeting {
  id             String    @id @default(uuid())
  tripId         String
  trip           Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  // #310: see TripParticipant.createdAt's own comment -- same reason.
  createdAt      DateTime  @default(now())
  startAt        DateTime
  // Short, identifying name -- what shows as the email subject and
  // calendar-entry title. A real, distinct need from the "two unused
  // fields" case `agenda` below's own comment already rejected: a trip
  // with more than one meeting (the normal case) sent every meeting's
  // email with the exact same subject line ("Meeting: <trip name>"),
  // indistinguishable in an inbox until opened. Optional, with a
  // same-as-today fallback wherever it's blank -- see sendMeetingEmail
  // and buildMeetingIcs.
  title          String?
  location       String?
  meetingLink    String?
  // Renamed from the former `notes` -- already used at every seed call
  // site for genuine agenda content ("Pre-field training -- cultural
  // orientation and safety briefing"), just never surfaced in any UI,
  // invite, or reminder. One field, not two: adding a second
  // agenda-shaped column alongside an unused one would just be the same
  // concept under two names. `title` above is a different concept
  // (short, identifying) from this (long-form descriptive content), not
  // a repeat of that same mistake.
  agenda         String?   @db.Text
  // Guards the day-before reminder against double-sending -- same
  // "stamp once sent" precedent DispatchRecord's own per-channel columns
  // already use.
  reminderSentAt DateTime?
  // Soft-cancel, not a delete -- this app's own precedent is to record
  // what happened rather than silently remove it (DispatchRecord,
  // TripRequirementStatus), and a meeting that already went out as a
  // calendar invite needs an actual cancellation notice sent, which a
  // hard delete can't carry. The DELETE route stays for correcting a
  // meeting that was never actually announced (created by mistake, no
  // invite sent yet); cancelling is the right action for anything a
  // participant may already have on their calendar.
  cancelledAt    DateTime?

  rsvps TripMeetingRsvp[]

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([tripId])
}

// One row per (meeting, participant) -- a many-to-many, not a column on
// either side, since each participant independently answers each of a
// trip's own meetings. Link-based only (issue #267's RSVP design
// decision): a participant clicks one of three token-verified links in
// their own invite/resend/reschedule/reminder email, no login, no
// inbound email involved at all. Upserted on (meetingId, participantId)
// -- clicking a different link later just overwrites the earlier
// response, same "re-cancelling is harmless" idempotency precedent
// TripMeeting.cancelledAt's own route already follows.
model TripMeetingRsvp {
  id            String          @id @default(uuid())
  meetingId     String
  meeting       TripMeeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participantId String
  participant   TripParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  // "yes" | "no" | "maybe" -- a plain String with app-level validation,
  // not a Postgres enum, matching this schema's own existing convention
  // for a small fixed set of values (TripRequirement.kind, TripDocument.
  // signerRelationship) over a real enum type.
  response      String
  respondedAt   DateTime

  @@unique([meetingId, participantId])
  @@index([participantId])
}

// An admin-defined, ordered, free-text checklist of what a trip needs
// from each participant -- a document (e.g. "Signed Waiver," "Passport
// Photo") or a plain task with no file at all (e.g. "Attended
// orientation call") -- illustrative examples only, never a
// fixed/hardcoded list. Generalized from the original document-only
// TripDocumentRequirement (#252 follow-on round): `kind` distinguishes
// the two, and `dueAt`/`reminderLeadDays` are optional -- most
// requirements have neither, same "empty means nothing shows/fires"
// convention as every other optional field in this feature area. A
// real child model, not JSON -- TripDocument.requirementId needs an
// actual foreign key for the fulfillment anti-join to work.
model TripRequirement {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  // #310: see TripParticipant.createdAt's own comment -- same reason.
  createdAt DateTime @default(now())
  label     String

  // "document" (fulfilled by an upload, the original behavior) |
  // "task" (fulfilled by an admin directly checking it off for a
  // specific participant -- no document involved at all) | "esignature"
  // (fulfilled by a participant signing bodyText below -- generates an
  // ordinary TripDocument carrying the signature audit fields, see that
  // model's own comment). App-validated, not a DB enum, matching every
  // other preset-String field in this schema (Trip.albumProvider etc).
  kind String @default("document")

  // The real document text an "esignature"-kind requirement asks a
  // participant to sign (e.g. a full liability-release/code-of-conduct
  // agreement) -- null for "document"/"task" kinds, which have no text
  // of their own to show. Free text, matching Trip.notes/flightDetails'
  // existing convention, not split into clauses -- a waiver's exact
  // wording varies too much church to church for rigid fields to help.
  bodyText String? @db.Text

  // Both optional and independent of `kind` -- a document requirement
  // can have a due date too (e.g. "passport copy by 11/25"), not just a
  // task. Date-only (no time component), matching Trip.startDate's own
  // convention. reminderLeadDays is null (no reminder scheduled) unless
  // an admin sets it; when set, tripReminderScheduler.js fires one
  // reminder per not-yet-fulfilled participant that many days before
  // dueAt, never after it.
  dueAt            DateTime? @db.Date
  reminderLeadDays Int?

  // #278: scopes this requirement to only the trip's minor participants
  // (e.g. a minor travel release form) instead of the whole team.
  // Checked via utils/tripParticipantSchema.js's isMinorForTrip
  // (dateOfBirth vs. this trip's own startDate) at every point this
  // requirement is surfaced to or reminds a participant -- never by
  // creating or withholding a TripRequirementStatus row, since those
  // are already lazily created on first completion/upload, not
  // eagerly for every participant.
  minorsOnly Boolean @default(false)

  documents           TripDocument[]
  requirementStatuses TripRequirementStatus[]

  // #341: who last changed this record, as a current-state fact (overwritten in
  // place, never pruned -- unlike the AuditLog event history). Stamped
  // centrally by the Prisma client extension in prismaClient.js from the
  // signed-in user of the request; left alone by background jobs, the seed and
  // public submissions, which have no signed-in person. The name is a snapshot
  // so it still reads after that account is deleted.
  lastEditedById   String?
  lastEditedByName String?
  lastEditedAt     DateTime?

  @@index([tripId])
}

// Per-participant state for a TripRequirement. completedAt is written
// only for a "task"-kind row -- permanently null for "document"/
// "esignature", whose fulfillment is instead a computed anti-join
// against TripDocument (never duplicated here on purpose: a cached
// field would need every document-creating path, and the document-
// deletion route, to all separately remember to keep it in sync, where
// the anti-join just reflects reality on read). reminderSentAt applies
// to every kind alike, stamped once the due-date reminder has fired for
// this specific participant so it can't double-send. Created lazily,
// only once either field actually needs a value -- most participant/
// requirement pairs with no due date and no completed task never get a
// row here at all.
model TripRequirementStatus {
  id            String          @id @default(uuid())
  requirementId String
  requirement   TripRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
