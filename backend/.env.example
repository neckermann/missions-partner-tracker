# --- Database ---
# Any Postgres works here — Render, Neon, Supabase, RDS, a self-hosted instance,
# whatever you've got. The Deploy to Render button uses a Render Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/missionary_tracker?sslmode=require"

# --- App ---
PORT=4000
NODE_ENV=development
# This app's own public URL, no trailing slash. Every link the app puts in a
# message or builds for you depends on it: setup, password-reset and sign-in
# links, passkeys, survey and trip links, public subscription confirmations
# and the unsubscribe link in the email digest, and links back into the app
# from GroupMe posts. On Render it is picked up automatically from
# RENDER_EXTERNAL_URL (set by Render itself), which is the onrender.com
# address: set this explicitly if you use your own domain (passkeys are tied
# to it) or host elsewhere. The route tests also need it (use
# http://localhost:3001 there). Without it those links are left out.
#APP_BASE_URL="https://your-church.onrender.com"
# Signs the session cookie (see backend/src/utils/jwt.js and
# backend/src/middleware/requireAuth.js). REQUIRED — the app refuses to start
# without it, because anyone who knows this value can forge an admin session.
# Generate one with `npm run generate-secrets` (or `openssl rand -base64 48`).
# Left empty on purpose: a placeholder that looks filled in is how a fork ends
# up deployed with a signing key that's published in this repo.
SESSION_SECRET=
# Encrypts secrets stored in the database at rest -- every integration
# credential (Postmark server token, GroupMe access token, Joshua Project
# API key, the WhatsApp session) plus TOTP MFA secrets (User.mfaSecret),
# all of which must be reversible (not just hashed) to be usable. Must
# decode to exactly 32 bytes; generate one with
# `npm run generate-secrets` (or `openssl rand -base64 32`). Losing it makes
# every already-encrypted value unrecoverable, so store it somewhere durable
# alongside SESSION_SECRET, and never reuse it across environments.
# Needed before the first sign-in: two-factor sign-in is required from the
# start, so without it the first admin cannot finish signing in. The app still
# boots without it (and warns).
FIELD_ENCRYPTION_KEY=

# Photos, newsletters, and documents are stored directly in the database
# (see the Newsletter model comment in prisma/schema.prisma) — nothing to
# configure here at all. Nothing else in this app writes to any external
# storage service.


# --- Geocoding (OpenStreetMap Nominatim, free, no API key) ---
# Nominatim's usage policy requires identifying requests with a real contact.
# Set this to your own email before deploying — otherwise misbehaving
# requests get attributed to (and may get rate-limited/blocked as) whoever
# this project's example value belongs to.
NOMINATIM_CONTACT="you@yourchurch.org"

# --- MFA ---
# Shown in a user's authenticator app (Google Authenticator, Authy, etc.)
# next to their account when they enroll. Optional — defaults to
# "Missions Partner Tracker Admin" if unset.
MFA_ISSUER="Your Church Admin"

# --- Reverse proxy (optional) ---
# How many proxies sit between a visitor and this process: 1 (the default) for Render or a single nginx / load
# balancer; 0 if the app is reached directly (otherwise a visitor can fake their address and dodge the sign-in
# limits); 2 for two (e.g. Cloudflare in front of Render; otherwise all visitors share one limit). Never "true".
#TRUST_PROXY="1"

# --- Start-up database check (optional) ---
# The server refuses to start on a database that was not built from this release's migrations (before 1.0 the
# baseline migration is rewritten in place, so an older database looks up to date but is not). Setting this to
# "true" skips that check: only for someone who knows the database matches. See RUNBOOK.md.
#SKIP_SCHEMA_CHECK="true"

# --- Scheduled jobs (optional) ---
# The email digests, GroupMe/WhatsApp posts, reminders, scheduled reports and the audit clean-up run inside
# this same process (there is no separate worker). They start by themselves when NODE_ENV=production, and
# not otherwise, so a laptop pointed at a database with real email settings never sends anything on its own.
# Set "on" to run them in development, or "off" to turn them off in production. Only one copy of the app
# ever runs them (a database lock), so running several copies is safe.
#BACKGROUND_JOBS="on"

# --- Demo mode (optional) ---
# Only relevant if you're standing up a public demo instance (see
# ADMIN_GUIDE.md § Demo mode) — leave all three unset otherwise. Setting
# DEMO_RESET_TOKEN is what makes POST /api/demo/reset exist at all; it's
# not mounted otherwise. That route wipes the database and reseeds it with
# fresh fake data plus a login using the email/password below — never set
# these on a real deployment with real data.
#DEMO_RESET_TOKEN="generate-with-openssl-rand-base64-32"
#DEMO_ADMIN_EMAIL="demo@yourchurch.org"
#DEMO_ADMIN_PASSWORD="some-published-demo-password"
# Optional, for the owner's own private test demo only (the dev demo). A public demo (DEMO_RESET_TOKEN
# set) is "guarded": it sends no real email, GroupMe or WhatsApp message, never uses the AI key, refuses
# password and integration changes, and a reset does not restore the Anthropic, GroupMe or Postmark keys.
# Setting this to "true" turns all of that off so the owner can test real sends and take screenshots; it
# also stops the demo banner publishing the logins (give that deployment its own DEMO_ADMIN_EMAIL and
# DEMO_ADMIN_PASSWORD) and lets an admin switch passwordless sign-in on. The only value that counts is
# "true". Set it on the worker too (it recognises a demo only by the flag the reset writes). Never set it
# on a demo the public can reach.
#DEMO_TESTING_SITE="true"
# Older, narrower form of the passwordless part of the above: lets an admin switch passwordless sign-in on
# there (a public demo always refuses it, since it would lock every visitor out of the shared logins
# until the next reset). The only value that counts is "true". Never set it on a demo the public can reach.
#DEMO_ALLOW_PASSWORDLESS="true"
# Optional — the password of the two published guest logins a demo reset
# seeds (a care team member and a trip leader; see demo/README.md), also shown
# in the demo banner. Leave it unset and they share DEMO_ADMIN_PASSWORD, so
# every published login has the same password. Published on purpose, so never
# reuse it anywhere real.
#DEMO_GUEST_PASSWORD="only-if-you-want-it-different-from-the-admin-one"
# Optional — how much fake data prisma/seed.js generates on each reset.
# Defaults to 35 missionaries / 12 organizations if unset (same as local
# `npm run seed`); a public demo might want more to look fuller.
#SEED_MISSIONARY_COUNT=50
#SEED_ORGANIZATION_COUNT=20

# --- Demo mode: restoring integrations after a reset (all optional) ---
# ChurchSettings is admin-managed, not env-driven — but POST /api/demo/reset
# (backend/scripts/reset-demo-data.js) wipes and recreates it from scratch
# every time, so a public demo that wants to keep showing a working
# integration after each reset needs its real credentials here instead,
# restored automatically as part of the reset. Each one's *feature* toggle
# only turns on when its own credentials actually resolved — leaving a
# toggle on with nothing behind it is worse than leaving it off.
#JOSHUA_PROJECT_API_KEY="your-joshua-project-api-key"
#ANTHROPIC_API_KEY="your-anthropic-api-key"
# GroupMe: the access token plus the *names* of the group and each Topic
# (not ids — reset-demo-data.js resolves each by a live GroupMe API call
# and match-by-name, the same way the admin's own GroupMe settings page
# does, since a Topic's id isn't something a human would ever type in).
# Any of the three topic names can be left unset if that type of
# notification isn't wired up for this demo.
#GROUPME_ACCESS_TOKEN="your-groupme-access-token"
#GROUPME_GROUP_NAME="Your GroupMe Group Name"
#GROUPME_PRAYER_NAME="Prayer Requests"
#GROUPME_ONETIME_NEEDS_NAME="One-Time Needs"
#GROUPME_NEWSLETTER_NAME="Newsletters"
# Postmark: the server token covers both directions, but sending needs a
# From address and receiving needs its own inbound-webhook basic-auth
# credentials (checked in routes/inboundEmail.js) on top of that. Postmark's
# own inbound webhook still has to be pointed at this demo's
# /api/inbound-email/postmark URL by hand, in Postmark's own dashboard --
# that's not something stored in ChurchSettings at all.
#POSTMARK_API_KEY="your-postmark-server-token"
#FROM_EMAIL_ADDRESS="no-reply@yourchurch.org"
#WEBHOOK_USERNAME="pick-a-username"
#WEBHOOK_PASSWORD="generate-with-openssl-rand-base64-32"

# --- Pexels API (optional — real stock photos for seed data) ---
# Applies to any seeding (local `npm run seed` or a demo reset), not just
# demo mode above. Get a free key at https://www.pexels.com/api/ (200
# requests/hour). Without this set, prisma/seed.js falls back to generated
# SVG silhouette avatars instead of real photos — seeding never fails
# over this being unset or a request to Pexels failing. When set, each
# seeded missionary gets a photo matched to their household (single adult,
# couple, family with kids, or a larger family — see
# missionaryPhotoCategory() in prisma/seed.js), and each organization gets
# a logo-style photo.
#PEXELS_API_KEY="your-pexels-api-key"

# Welcome emails (new users and Trip Leaders) need APP_BASE_URL above (the
# "Choose your password" button links to it) and Email configured under
# Site Administration -> Email. Guide/support links and the setup-link
# expiry are fixed in code (utils/welcomeEmails.js, utils/passwordSetup.js)
# -- this project's own documentation, not something a church needs to
# configure, so no env var for any of it (see issue #303).
