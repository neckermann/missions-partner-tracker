# --- Database ---
# Any Postgres works here — Neon, Supabase, RDS, a self-hosted instance,
# whatever you've got. This project's own deployment uses Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/missionary_tracker?sslmode=require"

# --- App ---
PORT=4000
NODE_ENV=development
# Signs the session cookie (see backend/src/utils/jwt.js and
# backend/src/middleware/requireAuth.js). REQUIRED — the app refuses to start
# without it, because anyone who knows this value can forge an admin session.
# Generate one with `npm run generate-secrets` (or `openssl rand -base64 48`).
# Left empty on purpose: a placeholder that looks filled in is how a fork ends
# up deployed with a signing key that's published in this repo.
SESSION_SECRET=
# Encrypts secrets stored in the database at rest — currently TOTP MFA
# secrets (User.mfaSecret), which must be reversible (not just hashed) to be
# usable. Must decode to exactly 32 bytes; generate one with
# `npm run generate-secrets` (or `openssl rand -base64 32`). Losing it makes
# every already-encrypted value unrecoverable, so store it somewhere durable
# alongside SESSION_SECRET, and never reuse it across environments.
# Not required to boot — without it the app still runs and warns, and only
# two-factor enrollment fails.
FIELD_ENCRYPTION_KEY=

# Photos, newsletters, and documents are stored directly in the database
# (see the Newsletter model comment in prisma/schema.prisma) — nothing to
# configure here at all. Nothing else in this app writes to any external
# storage service.

# --- Joshua Project API (country-level unreached-people-group stats) ---
# Get a key at https://joshuaproject.net/api/request
JOSHUA_PROJECT_API_KEY="your-joshua-project-api-key"

# --- Geocoding (OpenStreetMap Nominatim, free, no API key) ---
# Nominatim's usage policy requires identifying requests with a real contact.
# Set this to your own email before deploying — otherwise misbehaving
# requests get attributed to (and may get rate-limited/blocked as) whoever
# this project's example value belongs to.
NOMINATIM_CONTACT="you@yourchurch.org"

# --- AI request scanning (optional) ---
# Powers the "Scan for requests" button on newsletters/documents (off by
# default even when this is set -- turn it on at Admin -> Church Settings
# -> Features). Get a key at https://console.anthropic.com/settings/keys.
# See ADMIN_GUIDE.md § Feature toggles.
#ANTHROPIC_API_KEY="sk-ant-..."

# --- MFA ---
# Shown in a user's authenticator app (Google Authenticator, Authy, etc.)
# next to their account when they enroll. Optional — defaults to
# "Missions Partner Tracker Admin" if unset.
MFA_ISSUER="Your Church Admin"

# --- Demo mode (optional) ---
# Only relevant if you're standing up a public demo instance (see
# ADMIN_GUIDE.md § Demo mode) — leave all three unset otherwise. Setting
# DEMO_RESET_TOKEN is what makes POST /api/demo/reset exist at all; it's
# not mounted otherwise. That route wipes the database and reseeds it with
# fresh fake data plus a login using the email/password below — never set
# these on a real deployment with real data.
#DEMO_RESET_TOKEN="generate-with-openssl-rand-base64-32"
#DEMO_ADMIN_EMAIL="demo@yourchurch.org"
#DEMO_ADMIN_PASSWORD="some-published-demo-password"
# Optional — how much fake data prisma/seed.js generates on each reset.
# Defaults to 35 missionaries / 12 organizations if unset (same as local
# `npm run seed`); a public demo might want more to look fuller.
#SEED_MISSIONARY_COUNT=50
#SEED_ORGANIZATION_COUNT=20

# --- Pexels API (optional — real stock photos for seed data) ---
# Applies to any seeding (local `npm run seed` or a demo reset), not just
# demo mode above. Get a free key at https://www.pexels.com/api/ (200
# requests/hour). Without this set, prisma/seed.js falls back to generated
# SVG silhouette avatars instead of real photos — seeding never fails
# over this being unset or a request to Pexels failing. When set, each
# seeded missionary gets a photo matched to their household (single adult,
# couple, family with kids, or a larger family — see
# missionaryPhotoCategory() in prisma/seed.js), and each organization gets
# a logo-style photo.
#PEXELS_API_KEY="your-pexels-api-key"
