# --- Database ---
# Any Postgres works here — Neon, Supabase, RDS, a self-hosted instance,
# whatever you've got. This project's own deployment uses Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/missionary_tracker?sslmode=require"

# --- App ---
PORT=4000
NODE_ENV=development
# Signs the session cookie (see backend/src/utils/jwt.js and
# backend/src/middleware/requireAuth.js). Generate a long random string,
# e.g. `openssl rand -base64 48`, and never reuse the same value across
# environments.
SESSION_SECRET="change-me-to-a-long-random-string"
# This app's own publicly-reachable base URL (no trailing slash) — this
# backend serves the built frontend directly (see server.js), so frontend
# and backend are always the same origin. Used to build the SSO
# redirect_uri (`${APP_BASE_URL}/api/auth/sso/callback`) and to validate
# the SSO callback request; only load-bearing if you configure an SSO
# provider (see the SSO section below) — register the callback URL it
# produces as the Reply URL / Authorized redirect URI in your IdP.
APP_BASE_URL="http://localhost:4000"
# Encrypts secrets stored in the database at rest — TOTP MFA secrets
# (User.mfaSecret) and SSO client secrets (SsoProvider.clientSecret), both
# of which must be reversible (not just hashed) to actually be usable.
# Generate one with `openssl rand -base64 32`; losing it makes every
# already-encrypted value unrecoverable, so store it somewhere durable
# alongside SESSION_SECRET, and never reuse it across environments.
FIELD_ENCRYPTION_KEY="change-me-to-a-real-generated-key"

# --- File uploads (S3) ---
# Missionary/org images and the church logo (public, under missionaries/,
# organizations/, and settings/ prefixes) and newsletters/documents
# (private, under newsletters/ and documents/) share one bucket — see the
# Newsletter model comment in prisma/schema.prisma for how that split is
# enforced via the bucket policy rather than per-object ACLs, and
# ADMIN_GUIDE.md § File storage (S3) for the actual policy JSON.
# In production (Elastic Beanstalk) credentials come from the EC2 instance
# role automatically. For local testing, run `aws configure` with a user/role
# that has access to this bucket instead of setting keys here.
AWS_REGION="us-east-2"
S3_BUCKET_NAME="your-bucket-name"

# Optional — only needed to use an S3-compatible service other than real AWS
# S3, e.g. Cloudflare R2, Backblaze B2, or self-hosted MinIO. Leave both
# unset to use AWS S3 as normal.
#   S3_ENDPOINT           the service's S3 API endpoint URL
#   S3_FORCE_PATH_STYLE   "true" for R2/MinIO (they don't support AWS's
#                         bucket-as-subdomain URL style)
#   S3_PUBLIC_URL_BASE    the base URL a browser uses to reach public
#                         objects directly (no trailing slash) — e.g. your
#                         R2 bucket's public/custom domain. Defaults to
#                         AWS's own https://{bucket}.s3.{region}.amazonaws.com
#S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
#S3_FORCE_PATH_STYLE="true"
#S3_PUBLIC_URL_BASE="https://assets.yourchurch.org"

# --- Joshua Project API (country-level unreached-people-group stats) ---
# Get a key at https://joshuaproject.net/api/request
JOSHUA_PROJECT_API_KEY="your-joshua-project-api-key"

# --- Geocoding (OpenStreetMap Nominatim, free, no API key) ---
# Nominatim's usage policy requires identifying requests with a real contact.
# Set this to your own email before deploying — otherwise misbehaving
# requests get attributed to (and may get rate-limited/blocked as) whoever
# this project's example value belongs to.
NOMINATIM_CONTACT="you@yourchurch.org"

# --- MFA ---
# Shown in a user's authenticator app (Google Authenticator, Authy, etc.)
# next to their account when they enroll. Optional — defaults to
# "Missions Partner Tracker Admin" if unset.
MFA_ISSUER="Your Church Admin"

# --- SSO ---
# Local username/password login is always available — nothing to configure
# for it. SSO (Entra ID, Google Workspace, Okta, or any other
# standards-compliant OIDC provider) is entirely optional and entirely
# database-driven: add, edit, enable, or disable providers from
# Admin → Church Settings → Single Sign-On, no env vars or redeploy needed.
# See ADMIN_GUIDE.md § Single sign-on (SSO) for the setup walkthrough. The
# only env vars SSO needs are FIELD_ENCRYPTION_KEY and APP_BASE_URL above.

# --- Demo mode (optional) ---
# Only relevant if you're standing up a public demo instance (see
# ADMIN_GUIDE.md § Demo mode) — leave all three unset otherwise. Setting
# DEMO_RESET_TOKEN is what makes POST /api/demo/reset exist at all; it's
# not mounted otherwise. That route wipes the database and reseeds it with
# fresh fake data plus a login using the email/password below — never set
# these on a real deployment with real data.
#DEMO_RESET_TOKEN="generate-with-openssl-rand-base64-32"
#DEMO_ADMIN_EMAIL="demo@yourchurch.org"
#DEMO_ADMIN_PASSWORD="some-published-demo-password"
# Optional — how much fake data prisma/seed.js generates on each reset.
# Defaults to 35 missionaries / 12 organizations if unset (same as local
# `npm run seed`); a public demo might want more to look fuller.
#SEED_MISSIONARY_COUNT=50
#SEED_ORGANIZATION_COUNT=20

# --- Pexels API (optional — real stock photos for seed data) ---
# Applies to any seeding (local `npm run seed` or a demo reset), not just
# demo mode above. Get a free key at https://www.pexels.com/api/ (200
# requests/hour). Without this set, prisma/seed.js falls back to generated
# SVG silhouette avatars instead of real photos — seeding never fails
# over this being unset or a request to Pexels failing. When set, each
# seeded missionary gets a photo matched to their household (single adult,
# couple, family with kids, or a larger family — see
# missionaryPhotoCategory() in prisma/seed.js), and each organization gets
# a logo-style photo.
#PEXELS_API_KEY="your-pexels-api-key"
