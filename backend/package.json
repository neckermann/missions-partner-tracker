{
  "name": "missions-partner-tracker-backend",
  "version": "1.3.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "demo:reset": "node scripts/reset-demo-data.js",
    "backup:restore": "node scripts/restore-backup.js",
    "check:extraction": "node scripts/check-extraction.js",
    "preview:digest": "node scripts/preview-digest.js",
    "test": "node --test test/*.test.js",
    "test:routes": "node --test --test-concurrency=1 test/routes/*.test.js",
    "generate-secrets": "node scripts/generate-secrets.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "heic-convert": "^2.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.23",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "otplib": "^13.5.0",
    "postmark": "^5.1.0",
    "qrcode": "^1.5.4",
    "zod": "^4.5.4",
    "baileys": "7.0.0-rc14",
    "baileys-antiban": "4.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^7.10.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "overrides": {
    "baileys-antiban": {
      "baileys": "$baileys"
    }
  }
}
