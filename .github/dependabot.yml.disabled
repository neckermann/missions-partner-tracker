# DISABLED -- renamed from dependabot.yml so GitHub stops reading it
# (only that exact filename activates version updates). This ran once,
# found a large first-time backlog (no automated dependency scanning
# existed before), and opened a batch of PRs -- see this repo's own open
# PR list on GitHub for exactly what's still pending. Most low-risk ones
# (grouped minor/patch, a few individual minor bumps, the github-actions
# bumps) are safe to review and merge once CI passes on each. A handful
# are genuine major-version migrations, not drop-in bumps -- notably
# prisma / @prisma/client (schema.prisma's `datasource { url = ... }` was
# removed in Prisma 7, needing a new prisma.config.ts + PrismaClient
# adapter config) and react / react-dom / react-leaflet (18.x/4.x -> 19.x/
# 5.x) -- those need real migration work, not just a merge click.
#
# To resume: rename this file back to dependabot.yml (or work through the
# open PRs manually first, then re-enable for ongoing weekly updates).
version: 2
updates:
  # Backend npm dependencies
  - package-ecosystem: "npm"
    directory: "/backend"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 10
    groups:
      backend-minor-patch:
        update-types: ["minor", "patch"]

  # Frontend npm dependencies
  - package-ecosystem: "npm"
    directory: "/frontend"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 10
    groups:
      frontend-minor-patch:
        update-types: ["minor", "patch"]

  # The GitHub Actions workflows themselves (actions/checkout, setup-node,
  # aws-actions/configure-aws-credentials, etc.)
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
