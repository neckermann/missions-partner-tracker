{
  "name": "missions-partner-tracker",
  "private": true,
  "description": "Repo-root tooling only. The app itself lives in backend/ and frontend/, each with its own package.json and its own dependencies. This exists so linting and formatting are configured once for both rather than twice.",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "node scripts/check-doc-links.js",
    "name-instance": "node scripts/name-instance.js",
    "test:db": "node scripts/test-db.js",
    "trigger-remote-reset": "node scripts/trigger-remote-reset.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
